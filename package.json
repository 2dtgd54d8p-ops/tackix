{
  "name": "indie-site-platform",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fetch:content": "node scripts/fetch-content.mjs",
    "migrate:local": "node scripts/migrate-to-d1.mjs --local",
    "migrate:remote": "node scripts/migrate-to-d1.mjs --remote",
    "predev": "node scripts/fetch-content.mjs",
    "dev": "node scripts/dev-with-watch.mjs",
    "prebuild": "node scripts/fetch-content.mjs && node scripts/gen-knowledge-index.mjs && node scripts/quality-score.mjs && node scripts/build-checks.mjs",
    "quality": "node scripts/quality-score.mjs",
    "check": "node scripts/build-checks.mjs",
    "changelog": "node scripts/gen-changelog.mjs",
    "build": "astro build",
    "postbuild": "pagefind --site dist && node scripts/gen-changelog.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "cf:dev": "wrangler pages dev ./dist"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.4.2",
    "astro": "^5.18.2",
    "marked": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.6.0",
    "wrangler": "^3.0.0"
  },
  "overrides": {
    "http-cache-semantics": "^4.2.1"
  }
}
