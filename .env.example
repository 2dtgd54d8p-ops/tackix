# ============================================================
# 本地开发（Keystatic local 模式）——以下变量本地可全部留空
# 直接 `npm run dev` 访问 http://127.0.0.1:4321/keystatic 即可
# ============================================================

# ============================================================
# 生产环境（Cloudflare Pages + Keystatic github 模式）必填
# 全部在 Cloudflare Pages 控制台 -> Settings -> Environment variables 填写
#   - PUBLIC_* 会在构建时打包进前端 -> 标记为 "build" 可用
#   - KEYSTATIC_* 仅在 Pages Functions 运行时读取 -> 标记为 "secret"
# ============================================================

# 仓库信息（构建时内联进前端，后台 UI 需要）
PUBLIC_GITHUB_OWNER=2dtgd54d8p-ops
PUBLIC_GITHUB_REPO=tackix
# ↓↓↓ GitHub App 的 slug：创建 App 后才会生成，届时替换为真实值 ↓↓↓
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-github-app-slug

# 站点域名（构建时内联，用于 canonical/绝对链接）。填你的 Pages 或自定义域名
PUBLIC_SITE_URL=https://tackix.pages.dev

# GitHub App OAuth（用于后台登录，机密）
KEYSTATIC_GITHUB_CLIENT_ID=xxxxxxxxxxxx
KEYSTATIC_GITHUB_CLIENT_SECRET=xxxxxxxxxxxx
# 用于会话加密的随机长字符串，必须 >= 32 字符
KEYSTATIC_SECRET=please-change-me-to-a-random-string-of-at-least-32-chars

# 构建期读取 GitHub 内容所需（Cloudflare 构建环境变量，机密）
# 一个对仓库有 Contents:read 权限的 GitHub Fine-grained PAT
KEYSTATIC_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
