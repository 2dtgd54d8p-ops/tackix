# ============================================================
# 本地开发（Keystatic local 模式）——以下变量本地可全部留空
# 直接 `npm run dev` 访问 http://127.0.0.1:4321/keystatic 即可
# ============================================================

# ============================================================
# 生产环境（Cloudflare Pages + Keystatic github 模式）必填
# 全部在 Cloudflare Pages 控制台 -> Settings -> Environment variables 填写
#   - PUBLIC_* 会在构建时打包进前端 -> 标记为 "build" 可用
#   - KEYSTATIC_* 仅在 Pages Functions 运行时读取 -> 标记为 "secret"
# ============================================================

# 仓库信息（构建时内联进前端，后台 UI 需要）
PUBLIC_GITHUB_OWNER=2dtgd54d8p-ops
PUBLIC_GITHUB_REPO=tackix
# ↓↓↓ GitHub App 的 slug（非机密，但【不同于】Client ID）：
#     App 设置页 URL 中 github.com/settings/apps/<slug> 的 <slug> 段，
#     或 "Public link" 里的 github.com/apps/<slug>。创建 App 后填入真实值。
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=tackix-cms-app

# 站点域名（构建时内联，用于 canonical/绝对链接）。填你的 Pages 或自定义域名
PUBLIC_SITE_URL=https://tackix.pages.dev

# GitHub App OAuth（用于后台登录）
# Client ID 非机密（manifest 新建 App 的真实值）；Secret 仍是机密，去 Cloudflare 填
KEYSTATIC_GITHUB_CLIENT_ID=Iv23litB8zAFrfDlYNDT
KEYSTATIC_GITHUB_CLIENT_SECRET=xxxxxxxxxxxx
# 用于会话加密的随机长字符串，必须 >= 32 字符（机密，去 Cloudflare 填）
KEYSTATIC_SECRET=please-change-me-to-a-random-string-of-at-least-32-chars

# 构建期/运行时读取 GitHub 内容所需（Cloudflare 环境变量，机密）
# 一个对仓库有 Contents:read 权限的 GitHub Fine-grained PAT
KEYSTATIC_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# 免代理后台登录（A-根治方案，见 docs/admin-login.md）
# 公司代理封锁 github.com 导致 OAuth 登录不可用；改用「口令 → 服务端 PAT cookie」
# 体系，浏览器全程不接触 github.com。以下两项为必填 secret。
# ============================================================

# 后台登录口令（Cloudflare secret_text）。在 Cloudflare Pages 控制台填写，
# 长度建议 >= 16 位、含大小写+数字。与前端 /api/admin-login 做长度安全比较。
KEYSTATIC_ADMIN_PASSWORD=change-me-admin-password

# 服务端持有的 GitHub PAT（Cloudflare secret_text）。需对仓库有 Contents:read 与
# 写回权限（编辑后台要回写内容）。登录成功后由 /api/admin-login 原样写入
# `keystatic-gh-access-token` cookie（非 httpOnly，Keystatic 要求 JS 可读）。
# 与 KEYSTATIC_GITHUB_TOKEN 可相同，但建议用独立 PAT 便于单独轮换。
KEYSTATIC_PAT=github_pat_xxxxxxxxxxxxxxxxxxxx
