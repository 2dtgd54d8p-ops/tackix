# ============================================================
# Tackix —— 自建后台（Cloudflare D1 + R2，无 GitHub / 无 Keystatic）
# 全部在 Cloudflare Pages 控制台 -> Settings -> Environment variables 填写
#   - PUBLIC_* 会在构建时打包进前端 -> 标记为 "build" 可用
#   - 其余变量仅在 Pages Functions 运行时读取 -> 标记为 "secret"
# ============================================================

# 站点域名（构建时内联，用于 canonical/绝对链接与 sitemap）。填你的 Pages 或自定义域名
PUBLIC_SITE_URL=https://tackix.pages.dev

# ── 内容后台登录（/admin）── 必填 secret ──────────────────────
# 后台登录口令。在 Cloudflare Pages 控制台填写，长度建议 >= 16 位、含大小写+数字。
# 对应前端 /admin 登录页 POST /api/admin/login。
ADMIN_PASSWORD=change-me-admin-password

# 用于 HMAC 签名会话 cookie（tackix_session，HttpOnly）的随机长字符串，必须 >= 32 字符。
# 与口令不同：口令是人输的，这个只用于服务端签名，泄露风险更低。
SESSION_SECRET=please-change-me-to-a-random-string-of-at-least-32-chars

# ── 运营工具鉴权（留言管理 / 运营报表）── 必填 secret ───────
# 留言后台（/admin/messages）与运营报表（/admin/report）用各自的 ADMIN_TOKEN 网关，
# 不依赖上面的会话 cookie。自己随机生成一个长字符串填这里即可。
ADMIN_TOKEN=change-me-operations-token

# ── 发布后自动重建（可选）── secret ───────────────────────────
# 在后台「保存并发布」后触发 Cloudflare Pages 重建钩子，使静态页刷新。
# 留空则发布仅写入 D1，需手动重新部署。
PAGES_DEPLOY_HOOK=

# 站点基础 URL（运行时可选，默认回退 PUBLIC_SITE_URL）
SITE_URL=https://tackix.pages.dev

# ── 构建期内容拉取（fetch-content.mjs，可选）──────────────────
# 构建时从 D1 读取可编辑内容写入 src/generated/content.json。
# 未配置 token 时自动回退到已提交的快照（content.json），构建永不中断。
# 本地用 wrangler 时设 USE_LOCAL_D1=1 走本地 D1。
CLOUDFLARE_ACCOUNT_ID=b4f68b37b18c0891a0df46f3bf4d07f1
D1_DB_NAME=tackix-content
D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# USE_LOCAL_D1=1

# ── 绑定（在 wrangler.toml / Cloudflare 控制台绑定，非环境变量）──
#   D1    : 绑定名 DB      -> 数据库 tackix-content
#   R2    : 绑定名 MEDIA   -> 存储桶 tackix-media
