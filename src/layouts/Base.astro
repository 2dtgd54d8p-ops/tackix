---
import { loadSiteData } from '../lib/site-data';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
// 站名/描述/页脚统一读后台「站点信息」singleton，读不到自动回落默认值。
const { site } = await loadSiteData();
const siteTitle = site.title;
const footerText = site.footer ? `Powered by ${site.footer}` : `Powered by ${siteTitle}`;

// 导航当前页高亮
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/search', label: '搜索' },
  { href: '/contact', label: '联系' },
  { href: '/keystatic', label: '管理后台' },
];
function isActive(href: string) {
  if (href === '/') return path === '/';
  if (href === '/keystatic') return path.startsWith('/keystatic') || path.startsWith('/admin');
  return path === href || path.startsWith(href + '/');
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
          var a = localStorage.getItem('accent');
          if (a) document.documentElement.setAttribute('data-accent', a);
        } catch (e) {}
      })();
    </script>
    <meta name="description" content={description ?? site.description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12101c" media="(prefers-color-scheme: dark)" />
    <title>{title ? `${title} · ${siteTitle}` : siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ? `${title} · ${siteTitle}` : siteTitle} />
    <meta property="og:description" content={description ?? site.description} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteTitle,
        description: site.description,
        url: (Astro.site ?? Astro.url).href,
      })}
    />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label={`${siteTitle} 首页`}>
        <img src="/favicon.svg" alt="" width="26" height="26" />
        <span>{siteTitle}</span>
      </a>
      <div class="header-right">
        <nav aria-label="主导航">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class={isActive(item.href) ? 'is-active' : ''}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="切换深色 / 浅色模式"
          aria-pressed="false"
        >
          <svg class="icon icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
          <svg class="icon icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.5M12 19.5V22M4.22 4.22l1.77 1.77M18.01 18.01l1.77 1.77M2 12h2.5M19.5 12H22M4.22 19.78l1.77-1.77M18.01 5.99l1.77-1.77" /></svg>
        </button>
        <div class="accent-swatches" role="group" aria-label="主题色切换">
          <button class="swatch is-active" type="button" data-accent="violet" style="--sw:#7c4df0" aria-label="紫色主题" aria-pressed="true"></button>
          <button class="swatch" type="button" data-accent="blue" style="--sw:#3a7bff" aria-label="蓝色主题" aria-pressed="false"></button>
          <button class="swatch" type="button" data-accent="green" style="--sw:#18a06a" aria-label="绿色主题" aria-pressed="false"></button>
          <button class="swatch" type="button" data-accent="amber" style="--sw:#f0883e" aria-label="橙色主题" aria-pressed="false"></button>
          <button class="swatch" type="button" data-accent="rose" style="--sw:#e0529c" aria-label="粉色主题" aria-pressed="false"></button>
        </div>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <span>{footerText}</span>
    </footer>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function effective() {
          var t = root.getAttribute('data-theme');
          return t ? t : (mq.matches ? 'dark' : 'light');
        }
        function paint() {
          var dark = effective() === 'dark';
          btn.classList.toggle('is-dark', dark);
          btn.setAttribute('aria-pressed', dark ? 'true' : 'false');
          btn.setAttribute('aria-label', dark ? '切换到浅色模式' : '切换到深色模式');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#12101c' : '#ffffff');
        }
        btn.addEventListener('click', function () {
          var next = effective() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          paint();
        });
        if (mq.addEventListener) mq.addEventListener('change', function () {
          if (!root.getAttribute('data-theme')) paint();
        });

        // 强调色切换
        var swatches = document.querySelectorAll('.swatch');
        function paintAccent() {
          var a = root.getAttribute('data-accent') || 'violet';
          swatches.forEach(function (b) {
            var on = b.getAttribute('data-accent') === a;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        }
        swatches.forEach(function (b) {
          b.addEventListener('click', function () {
            var a = b.getAttribute('data-accent');
            root.setAttribute('data-accent', a);
            try { localStorage.setItem('accent', a); } catch (e) {}
            paintAccent();
          });
        });
        paintAccent();

        paint();
      })();
    </script>
    <style is:global>
      :root {
        /* 表面层次 */
        --bg: #ffffff;
        --surface: #ffffff;
        --surface-2: #f5f6f9;
        --surface-3: #fafbfd;
        --band: #f5f6f9; /* 交替色带 */

        /* 文字层次 */
        --fg: #17171c;
        --fg-soft: #3a3a42;
        --muted: #73737e;
        --faint: #9a9aa6;

        /* 主题色：紫罗兰（对齐参考站 module5，默认强调色） */
        --accent: #7c4df0;
        --accent-strong: #5f2ed8;
        --accent-soft: #f1ebfe;
        --on-accent: #ffffff;
        /* 暗色模式下的强调色（随 data-accent 变化） */
        --accent-d: #a880ff;
        --accent-strong-d: #c0a4ff;
        --accent-soft-d: #241a3d;
        --on-accent-d: #12101c;

        /* 参考站签名四色（顶栏渐变条 / 彩色卡） */
        --g1: #17c3c3; /* 青 */
        --g2: #f5942f; /* 橙 */
        --g3: #8b4df0; /* 紫 */
        --g4: #4a90f0; /* 蓝 */
        --strip: linear-gradient(90deg, var(--g1), var(--g2), var(--g3), var(--g4));
        --hero-grad: radial-gradient(120% 120% at 80% 0%, #7c4df0 0%, transparent 55%),
          radial-gradient(90% 90% at 0% 100%, #5f2ed8 0%, transparent 55%),
          linear-gradient(135deg, #2c1a66 0%, #4a2597 55%, #6a34d6 100%);

        /* 状态色 */
        --success: #12a150;
        --success-bg: #e8f7ef;
        --danger: #d64545;
        --danger-bg: #fdecec;

        /* 线条 */
        --border: #ebedf1;
        --border-strong: #dcdfe6;

        /* 阴影 */
        --shadow-sm: 0 1px 2px rgba(23, 23, 28, 0.04), 0 1px 3px rgba(23, 23, 28, 0.05);
        --shadow-md: 0 8px 22px rgba(23, 23, 28, 0.08), 0 2px 6px rgba(23, 23, 28, 0.04);
        --shadow-lg: 0 20px 48px rgba(23, 23, 28, 0.12);
        --shadow-accent: 0 10px 26px rgba(124, 77, 240, 0.28);

        /* 圆角 */
        --r-sm: 8px;
        --r-md: 12px;
        --r-lg: 18px;
        --r-pill: 999px;

        /* 布局 */
        --maxw: 1120px;
        --readw: 720px;

        /* 字体（标题为粗体无衬线，对齐参考站） */
        --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        --font-display: system-ui, -apple-system, "PingFang SC", "Hiragino Sans GB",
          "Microsoft YaHei", sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

        /* 动效 */
        --ease: cubic-bezier(0.4, 0, 0.2, 1);
        --dur: 0.18s;
      }

      /* ===== 强调色主题（data-accent）：切换整套主题色 ===== */
      :root[data-accent='blue'] {
        --accent: #3a7bff; --accent-strong: #255fe0; --accent-soft: #e8efff; --on-accent: #ffffff;
        --accent-d: #7aa6ff; --accent-strong-d: #a9c4ff; --accent-soft-d: #16243f; --on-accent-d: #0c1426;
        --g3: #4a90f0;
        --hero-grad: radial-gradient(120% 120% at 80% 0%, #3a7bff 0%, transparent 55%),
          radial-gradient(90% 90% at 0% 100%, #255fe0 0%, transparent 55%),
          linear-gradient(135deg, #142a5e 0%, #1f3f8a 55%, #2f5fc0 100%);
        --shadow-accent: 0 10px 26px rgba(58, 123, 255, 0.28);
      }
      :root[data-accent='green'] {
        --accent: #18a06a; --accent-strong: #128055; --accent-soft: #e3f7ee; --on-accent: #ffffff;
        --accent-d: #4fd39a; --accent-strong-d: #74e0b3; --accent-soft-d: #103024; --on-accent-d: #07140e;
        --g3: #18a06a;
        --hero-grad: radial-gradient(120% 120% at 80% 0%, #18a06a 0%, transparent 55%),
          radial-gradient(90% 90% at 0% 100%, #128055 0%, transparent 55%),
          linear-gradient(135deg, #0f3a2a 0%, #155c40 55%, #1f7d57 100%);
        --shadow-accent: 0 10px 26px rgba(24, 160, 106, 0.28);
      }
      :root[data-accent='amber'] {
        --accent: #f0883e; --accent-strong: #cf6a23; --accent-soft: #fdeee2; --on-accent: #2a1700;
        --accent-d: #ffb070; --accent-strong-d: #ffc393; --accent-soft-d: #3a2412; --on-accent-d: #1c1106;
        --g3: #f0883e;
        --hero-grad: radial-gradient(120% 120% at 80% 0%, #f0883e 0%, transparent 55%),
          radial-gradient(90% 90% at 0% 100%, #cf6a23 0%, transparent 55%),
          linear-gradient(135deg, #5e2f12 0%, #8a4a1f 55%, #b5662a 100%);
        --shadow-accent: 0 10px 26px rgba(240, 136, 62, 0.28);
      }
      :root[data-accent='rose'] {
        --accent: #e0529c; --accent-strong: #c23885; --accent-soft: #fde4f1; --on-accent: #ffffff;
        --accent-d: #ff8fc4; --accent-strong-d: #ffaed4; --accent-soft-d: #3a1630; --on-accent-d: #1f0b18;
        --g3: #e0529c;
        --hero-grad: radial-gradient(120% 120% at 80% 0%, #e0529c 0%, transparent 55%),
          radial-gradient(90% 90% at 0% 100%, #c23885 0%, transparent 55%),
          linear-gradient(135deg, #5e1240 0%, #8a1f5e 55%, #b62f80 100%);
        --shadow-accent: 0 10px 26px rgba(224, 82, 156, 0.28);
      }

      /* 系统偏好为暗、且用户未显式选浅色时生效（自动模式） */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #12101c;
          --surface: #191624;
          --surface-2: #201c2e;
          --surface-3: #16131f;
          --band: #16131f;

          --fg: #ece9f5;
          --fg-soft: #c7c2d6;
          --muted: #9c97ab;
          --faint: #6f6a80;

          --accent: var(--accent-d);
          --accent-strong: var(--accent-strong-d);
          --accent-soft: var(--accent-soft-d);
          --on-accent: var(--on-accent-d);

          --hero-grad: radial-gradient(120% 120% at 80% 0%, var(--accent) 0%, transparent 55%),
            radial-gradient(90% 90% at 0% 100%, var(--accent-strong) 0%, transparent 55%),
            linear-gradient(135deg, color-mix(in srgb, var(--accent-strong) 55%, #000) 0%, color-mix(in srgb, var(--accent) 45%, #1a0f3d) 55%, color-mix(in srgb, var(--accent) 70%, #000) 100%);

          --success: #4ec585;
          --success-bg: #14261b;
          --danger: #ef6f64;
          --danger-bg: #2a1715;

          --border: #2b2740;
          --border-strong: #3a3550;

          --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
          --shadow-md: 0 8px 22px rgba(0, 0, 0, 0.4);
          --shadow-lg: 0 20px 48px rgba(0, 0, 0, 0.55);
          --shadow-accent: 0 10px 26px rgba(124, 77, 240, 0.4);
        }
      }

      /* 用户手动强制暗色（覆盖系统偏好） */
      :root[data-theme='dark'] {
        --bg: #12101c;
        --surface: #191624;
        --surface-2: #201c2e;
        --surface-3: #16131f;
        --band: #16131f;

        --fg: #ece9f5;
        --fg-soft: #c7c2d6;
        --muted: #9c97ab;
        --faint: #6f6a80;

        --accent: var(--accent-d);
        --accent-strong: var(--accent-strong-d);
        --accent-soft: var(--accent-soft-d);
        --on-accent: var(--on-accent-d);

        --hero-grad: radial-gradient(120% 120% at 80% 0%, var(--accent) 0%, transparent 55%),
          radial-gradient(90% 90% at 0% 100%, var(--accent-strong) 0%, transparent 55%),
          linear-gradient(135deg, color-mix(in srgb, var(--accent-strong) 55%, #000) 0%, color-mix(in srgb, var(--accent) 45%, #1a0f3d) 55%, color-mix(in srgb, var(--accent) 70%, #000) 100%);

        --success: #4ec585;
        --success-bg: #14261b;
        --danger: #ef6f64;
        --danger-bg: #2a1715;

        --border: #2b2740;
        --border-strong: #3a3550;

        --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
        --shadow-md: 0 8px 22px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 20px 48px rgba(0, 0, 0, 0.55);
        --shadow-accent: 0 10px 26px rgba(124, 77, 240, 0.4);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--fg);
        line-height: 1.7;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        font-feature-settings: "kern", "liga";
      }
      ::selection { background: var(--accent-soft); color: var(--accent-strong); }
      a { color: var(--accent); text-decoration: none; transition: color var(--dur) var(--ease); }
      a:hover { color: var(--accent-strong); }

      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb {
        background: var(--border-strong);
        border-radius: var(--r-pill);
        border: 2px solid var(--bg);
      }
      ::-webkit-scrollbar-thumb:hover { background: var(--faint); }

      /* ---------- 顶栏（白底 + 四色渐变签名条） ---------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 24px;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
        background: color-mix(in srgb, var(--surface) 88%, transparent);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
      }
      .site-header::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 3px;
        background: var(--strip);
        opacity: 0.9;
      }
      .header-right { display: flex; align-items: center; gap: 10px; }

      /* 主题切换按钮 */
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        padding: 0;
        flex: none;
        border: 1px solid var(--border-strong);
        border-radius: var(--r-pill);
        background: var(--surface);
        color: var(--fg-soft);
        cursor: pointer;
        transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease),
          background var(--dur) var(--ease), transform var(--dur) var(--ease);
      }
      .theme-toggle:hover { color: var(--accent); border-color: var(--accent); background: var(--accent-soft); }
      .theme-toggle:active { transform: translateY(1px); }
      .theme-toggle .icon { width: 19px; height: 19px; }
      .theme-toggle .icon-sun { display: none; }
      .theme-toggle.is-dark .icon-moon { display: none; }
      .theme-toggle.is-dark .icon-sun { display: block; }

      /* 强调色切换（色板） */
      .accent-swatches {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding-left: 6px;
        margin-left: 2px;
        border-left: 1px solid var(--border);
      }
      .swatch {
        width: 18px;
        height: 18px;
        padding: 0;
        border-radius: 50%;
        border: 2px solid var(--surface);
        background: var(--sw);
        cursor: pointer;
        box-shadow: 0 0 0 1px var(--border-strong);
        transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
        flex: none;
      }
      .swatch:hover { transform: scale(1.14); }
      .swatch.is-active { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); }
      .swatch:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      /* 主题切换时的平滑过渡 */
      body { transition: background-color 0.2s var(--ease), color 0.2s var(--ease); }
      .site-header { transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease); }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-weight: 800;
        font-size: 19px;
        letter-spacing: -0.01em;
        color: var(--fg);
      }
      .brand img { width: 26px; height: 26px; border-radius: 8px; }
      .brand:hover { text-decoration: none; color: var(--fg); }
      nav { display: flex; align-items: center; gap: 4px; }
      nav a {
        position: relative;
        color: var(--fg-soft);
        font-size: 15px;
        font-weight: 500;
        padding: 8px 14px;
        border-radius: var(--r-pill);
        transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
      }
      nav a:hover { color: var(--accent); background: var(--accent-soft); text-decoration: none; }
      nav a.is-active { color: var(--accent); }

      /* ---------- 内容容器 ---------- */
      .container { max-width: var(--maxw); margin: 0 auto; padding: 44px 24px 80px; }
      .site-footer {
        text-align: center;
        color: var(--muted);
        font-size: 13px;
        padding: 40px 24px;
        border-top: 1px solid var(--border);
        background: var(--surface-3);
      }
      .site-footer span { opacity: 0.95; }

      /* ---------- 居中版块标题（参考站核心版式） ---------- */
      .section-head { text-align: center; max-width: 700px; margin: 0 auto 34px; }
      .section-head h2 {
        font-family: var(--font-display);
        font-size: 27px;
        font-weight: 800;
        color: var(--fg);
        margin: 0 0 10px;
        letter-spacing: -0.01em;
      }
      .section-head p { margin: 0 auto; color: var(--muted); font-size: 14.5px; line-height: 1.75; max-width: 560px; }
      .section-head.left { text-align: left; margin-left: 0; }
      .section-head.left p { margin-left: 0; }

      /* 页面顶部标题（内页） */
      .page-head { text-align: center; max-width: 720px; margin: 8px auto 34px; }
      .page-head h1 {
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 800;
        color: var(--fg);
        margin: 0 0 10px;
        letter-spacing: -0.015em;
      }
      .page-head p { margin: 0; color: var(--muted); font-size: 14.5px; }
      .section-title,
      .block-title {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 600;
        color: var(--faint);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .container > section > h1 {
        font-family: var(--font-display);
        font-size: 30px;
        font-weight: 800;
        line-height: 1.3;
        color: var(--fg);
        letter-spacing: -0.015em;
        margin: 0 0 8px;
      }

      /* ---------- 按钮 ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 24px;
        border: 1px solid var(--border-strong);
        border-radius: var(--r-pill);
        background: var(--surface);
        color: var(--fg-soft);
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.2;
        cursor: pointer;
        transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
          background var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
      }
      .btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
      .btn:active { transform: translateY(1px); }
      .btn-primary {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--on-accent);
        box-shadow: var(--shadow-accent);
      }
      .btn-primary:hover {
        background: var(--accent-strong);
        border-color: var(--accent-strong);
        color: var(--on-accent);
      }
      /* 深色 Hero 上的按钮 */
      .btn-light { background: #fff; border-color: #fff; color: #2c1a66; }
      .btn-light:hover { background: #f2eeff; border-color: #f2eeff; color: #2c1a66; }
      .btn-outline-light { background: transparent; border-color: rgba(255, 255, 255, 0.55); color: #fff; }
      .btn-outline-light:hover { background: rgba(255, 255, 255, 0.14); border-color: #fff; color: #fff; }

      /* ---------- 彩色渐变瓷砖（参考站特色） ---------- */
      .tile {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 24px 22px;
        border: 0;
        border-radius: var(--r-lg);
        color: #fff;
        background: var(--tile-grad, var(--g3));
        overflow: hidden;
        text-align: left;
        box-shadow: var(--shadow-md);
        cursor: pointer;
        font: inherit;
        transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
      }
      .tile::after {
        content: "";
        position: absolute;
        right: -36px;
        top: -36px;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.16);
        pointer-events: none;
      }
      .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
      .tile .tile-name { font-size: 17px; font-weight: 700; position: relative; }
      .tile .tile-sub { font-size: 13px; opacity: 0.9; position: relative; }
      .tile .tile-count {
        position: relative;
        margin-top: 4px;
        font-size: 12px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.22);
        border-radius: var(--r-pill);
        padding: 2px 10px;
        align-self: flex-start;
      }
      .tile.is-active { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 55%, transparent), var(--shadow-lg); }

      /* ---------- 卡片 ---------- */
      .card {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--surface);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
          border-color var(--dur) var(--ease);
      }
      .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--border-strong); }
      .card[hidden] { display: none; }
      .card-featured { border-color: var(--border-strong); }
      .card-media { aspect-ratio: 16 / 7; background: var(--surface-2); }
      .card-media-sm { aspect-ratio: 16 / 9; }
      .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .card-body { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; flex: 1; }
      .card-title { margin: 0; font-size: 16px; font-weight: 700; line-height: 1.45; }
      .card-featured .card-title { font-size: 19px; }
      .card-title a { color: var(--fg); transition: color var(--dur) var(--ease); }
      .card:hover .card-title a { color: var(--accent); }
      .card-excerpt {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: auto;
        padding-top: 8px;
        color: var(--faint);
        font-size: 12px;
      }
      .card-meta .read-time { color: var(--faint); }

      /* ---------- 标签 / 徽章 ---------- */
      .tag {
        display: inline-flex;
        align-items: center;
        padding: 2px 10px;
        border-radius: var(--r-pill);
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.6;
      }
      .tag-plain { background: var(--surface-2); color: var(--muted); }
      .badge {
        display: inline-block;
        font-size: 12px;
        padding: 4px 12px;
        border-radius: var(--r-pill);
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 600;
      }
      .pill { border-radius: var(--r-pill); }

      /* ---------- 表单字段 ---------- */
      .field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: var(--fg-soft); }
      .field input,
      .field textarea {
        font: inherit;
        font-size: 14px;
        padding: 12px 14px;
        border: 1px solid var(--border-strong);
        border-radius: var(--r-sm);
        background: var(--surface);
        color: var(--fg);
        transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
        width: 100%;
      }
      .field input:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      .field textarea { resize: vertical; min-height: 120px; }

      /* ---------- 提示 / 状态 / 空态 ---------- */
      .hint { color: var(--muted); font-size: 14.5px; line-height: 1.75; margin: 0 0 4px; }
      .status { font-size: 14px; min-height: 20px; margin: 0; color: var(--muted); }
      .status.ok { color: var(--success); }
      .status.err { color: var(--danger); }
      .empty { color: var(--muted); padding: 44px 0; text-align: center; }
      .empty[hidden] { display: none; }

      /* ---------- 正文排版（文章详情） ---------- */
      article.prose {
        max-width: var(--readw);
        margin: 0 auto;
        font-size: 16.5px;
        line-height: 1.9;
        color: var(--fg-soft);
      }
      article.prose h1 {
        font-family: var(--font-display);
        font-size: 32px;
        line-height: 1.32;
        font-weight: 800;
        color: var(--fg);
        margin: 0 0 14px;
        letter-spacing: -0.015em;
      }
      article.prose h2 { font-size: 22px; line-height: 1.4; margin: 34px 0 12px; color: var(--fg); font-weight: 700; }
      article.prose h3 { font-size: 18px; line-height: 1.4; margin: 26px 0 10px; color: var(--fg); font-weight: 700; }
      article.prose p { margin: 0 0 18px; }
      article.prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
      article.prose img { max-width: 100%; height: auto; border-radius: var(--r-md); margin: 20px 0; }
      article.prose blockquote {
        margin: 22px 0;
        padding: 8px 20px;
        border-left: 3px solid var(--accent);
        color: var(--muted);
        background: var(--surface-2);
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
      }
      article.prose code {
        background: var(--surface-2);
        padding: 2px 6px;
        border-radius: 6px;
        font-size: 0.9em;
        font-family: var(--font-mono);
      }
      article.prose pre {
        background: var(--surface-2);
        padding: 18px;
        border-radius: var(--r-md);
        overflow: auto;
        border: 1px solid var(--border);
        line-height: 1.6;
      }
      article.prose pre code { background: none; padding: 0; }
      article.prose ul,
      article.prose ol { padding-left: 1.4em; margin: 0 0 18px; }
      article.prose li { margin: 6px 0; }
      article.prose hr { border: 0; border-top: 1px solid var(--border); margin: 30px 0; }
      .cover { width: 100%; border-radius: var(--r-lg); margin: 12px 0 26px; display: block; box-shadow: var(--shadow-md); }

      /* ---------- 移动端 ---------- */
      @media (max-width: 700px) {
        .site-header { flex-direction: column; align-items: stretch; gap: 6px; padding: 12px 16px; }
        .header-right { flex-wrap: wrap; justify-content: center; width: 100%; gap: 8px; }
        nav { flex-wrap: wrap; gap: 2px; }
        nav a { padding: 7px 12px; }
        .container { padding: 28px 16px 60px; }
        .section-head h2, .page-head h1 { font-size: 23px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
        .card:hover, .tile:hover { transform: none; }
      }
    </style>
  </body>
</html>
