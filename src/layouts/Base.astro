      .swatch.is-active { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent); }
      .swatch:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      /* 语言切换器（复用 appearance-pop 弹层样式） */
      .lang-wrap { position: relative; flex: none; }
      .lang-pop { width: 172px; gap: 4px; }
      .lang-opt { display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; padding: 8px 10px; border: 0; border-radius: var(--r-sm); background: transparent; color: var(--fg-soft); font: inherit; font-size: 14px; cursor: pointer; text-align: left; transition: color var(--dur) var(--ease), background var(--dur) var(--ease); }
      .lang-opt .lang-name { display: inline-flex; align-items: center; gap: 8px; }
      .lang-opt .lang-flag { font-size: 17px; line-height: 1; }
      .lang-opt:hover { background: var(--surface-2); color: var(--accent); }
      .lang-opt.is-active { background: var(--accent-soft); color: var(--accent-strong); }
      .lang-opt .lang-code { font-size: 11px; color: var(--faint); }
      .lang-opt.is-active .lang-code { color: var(--accent-strong); }
      .lang-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      /* 主题切换时的平滑过渡 */
      body { transition: background-color 0.2s var(--ease), color 0.2s var(--ease); }
      .site-header { transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease); }

      /* ── 预上线提示条（prelaunch）────────────────────────────────
         未正式上线时显示，明确告知访客这是预览版本，避免被误当作
         已正式提供的商业服务；正式上线后（prelaunch.ts 开关）自动消失。 */
      .prelaunch-bar {
        display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px;
        padding: 10px 24px; text-align: center;
        background: color-mix(in srgb, var(--accent) 12%, var(--bg));
        border-bottom: 1px solid var(--border);
        font-size: 13.5px; line-height: 1.6;
        color: var(--fg-soft);
      }
      .prelaunch-bar strong { color: var(--accent); font-weight: 600; }

      /* 页脚联系方式（P0-3）：预上线期表单关闭，这是每页可达的转化入口 */
      .footer-contact {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 18px;
        margin-bottom: 10px; font-size: 13px;
      }
      .footer-contact a { color: var(--muted); }
      .footer-contact a:hover { color: var(--accent); }
      .fc-company { color: var(--fg-soft); font-weight: 600; margin-right: 4px; }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-weight: 800;
        font-size: 19px;
        letter-spacing: -0.01em;
        color: var(--fg);
      }
      .brand img { width: 26px; height: 26px; border-radius: 8px; }
      .brand:hover { text-decoration: none; color: var(--fg); }
      nav { display: flex; align-items: center; gap: 2px; }
      nav a {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--fg-soft);
        font-size: 15px;
        font-weight: 500;
        padding: 8px 12px;
        border-radius: var(--r-pill);
        transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
      }
      .nav-ico { display: inline-flex; flex: none; line-height: 0; }
      .nav-ico svg { display: block; }
      nav a:hover { color: var(--accent); background: var(--accent-soft); text-decoration: none; }
      nav a.is-active { color: var(--accent); }

      /* ---------- 导航悬停下拉（场景方案） ---------- */
      .nav-item.has-menu { position: relative; display: inline-flex; align-items: center; }
      .nav-item.has-menu > a { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
      /* 场景下拉展开按钮：桌面悬停也能展开，触屏点按切换 */
      .nav-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        margin-left: 2px;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        line-height: 1;
        cursor: pointer;
        border-radius: 6px;
      }
      .nav-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .nav-item.has-menu .caret {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        opacity: 0.7;
      }
      .nav-item.has-menu .caret svg {
        display: block;
        transition: transform var(--dur) var(--ease);
      }
      .nav-item.has-menu:hover .caret svg,
      .nav-item.has-menu:focus-within .caret svg,
      .nav-item.has-menu.is-open .caret svg { transform: rotate(90deg); }
      .nav-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        min-width: 208px;
        margin: 0;
        padding: 6px;
        list-style: none;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease), visibility var(--dur);
        z-index: 50;
      }
      .nav-item.has-menu:hover .nav-menu,
      .nav-item.has-menu:focus-within .nav-menu,
      .nav-item.has-menu.is-open .nav-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
      .nav-menu li { margin: 0; }
      .nav-menu a {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 8px;
        color: var(--fg);
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
        transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
      }
      .nav-ico-sm svg { width: 16px; height: 16px; }
      .nav-menu a:hover { background: var(--accent-soft); color: var(--accent); text-decoration: none; }

      /* ---------- 内容容器 ---------- */
      .container { max-width: var(--maxw); margin: 0 auto; padding: 44px 24px 80px; }
      .site-footer {
        text-align: center;
        color: var(--muted);
        font-size: 13px;
        padding: 40px 24px;
        border-top: 1px solid var(--border);
        background: var(--surface-3);
      }
      .site-footer span { opacity: 0.95; }
      .footer-ai-note { display: block; margin-top: 6px; font-size: 12px; color: var(--faint); opacity: 0.8; }
      .footer-admin {
        display: inline-block;
        margin-top: 8px;
        font-size: 12px;
        color: var(--faint);
        text-decoration: none;
        transition: color var(--dur) var(--ease);
      }
      .footer-admin:hover { color: var(--accent); }
      .footer-admin:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }

      /* ---------- 居中版块标题（参考站核心版式） ---------- */
      .section-head { text-align: center; max-width: 700px; margin: 0 auto 34px; }
      .section-head h2 {
        font-family: var(--font-display);
        font-size: 27px;
        font-weight: 800;
        color: var(--fg);
        margin: 0 0 10px;
        letter-spacing: -0.01em;
      }
      .section-head p { margin: 0 auto; color: var(--muted); font-size: 14.5px; line-height: 1.75; max-width: 560px; }
      .section-head.left { text-align: left; margin-left: 0; }
      .section-head.left p { margin-left: 0; }

      /* 页面顶部标题（内页） */
      .page-head { text-align: center; max-width: 720px; margin: 8px auto 34px; }
      .page-head h1 {
        font-family: var(--font-display);
        font-size: 32px;
        font-weight: 800;
        color: var(--fg);
        margin: 0 0 10px;
        letter-spacing: -0.015em;
      }
      .page-head p { margin: 0; color: var(--muted); font-size: 14.5px; }
      .section-title,
      .block-title {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 600;
        color: var(--faint);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .container > section > h1 {
        font-family: var(--font-display);
        font-size: 30px;
        font-weight: 800;
        line-height: 1.3;
        color: var(--fg);
        letter-spacing: -0.015em;
        margin: 0 0 8px;
      }

      /* ---------- 按钮 ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 24px;
        border: 1px solid var(--border-strong);
        border-radius: var(--r-pill);
        background: var(--surface);
        color: var(--fg-soft);
        font: inherit;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.2;
        cursor: pointer;
        transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
          background var(--dur) var(--ease), transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
      }
      .btn:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
      .btn:active { transform: translateY(1px); }
      .btn-primary {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--on-accent);
        box-shadow: var(--shadow-accent);
      }
      .btn-primary:hover {
        background: var(--accent-strong);
        border-color: var(--accent-strong);
        color: var(--on-accent);
      }
      /* 深色 Hero 上的按钮 */
      .btn-light { background: #fff; border-color: #fff; color: #2c1a66; }
      .btn-light:hover { background: #f2eeff; border-color: #f2eeff; color: #2c1a66; }
      .btn-outline-light { background: transparent; border-color: rgba(255, 255, 255, 0.55); color: #fff; }
      .btn-outline-light:hover { background: rgba(255, 255, 255, 0.14); border-color: #fff; color: #fff; }

      /* 正文(.prose)内的按钮链接：防止 article.prose a（accent 色 + 下划线，特异性 0,1,2）
         覆盖 .btn/.btn-primary（0,1,0）的配色 —— 否则强调色实心按钮会出现
         「文字颜色 == 背景色」导致按钮文案不可见，且被加上下划线。
         置于全局样式表，post/product 等任何以 .prose 包裹正文的页面均受保护。 */
      article.prose a.btn { color: var(--fg-soft); text-decoration: none; }
      article.prose a.btn:hover { color: var(--accent); }
      article.prose a.btn-primary,
      article.prose a.btn-primary:hover { color: var(--on-accent); text-decoration: none; }

      /* ---------- 彩色渐变瓷砖（参考站特色） ---------- */
      .tile {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 24px 22px;
        border: 0;
        border-radius: var(--r-lg);
        color: #fff;
        background: var(--tile-grad, var(--g3));
        overflow: hidden;
        text-align: left;
        box-shadow: var(--shadow-md);
        cursor: pointer;
        font: inherit;
        transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
      }
      .tile::after {
        content: "";
        position: absolute;
        right: -36px;
        top: -36px;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.16);
        pointer-events: none;
      }
      .tile:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
      .tile .tile-name { font-size: 17px; font-weight: 700; position: relative; }
      .tile .tile-sub { font-size: 13px; opacity: 0.9; position: relative; }
      .tile .tile-count {
        position: relative;
        margin-top: 4px;
        font-size: 12px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.22);
        border-radius: var(--r-pill);
        padding: 2px 10px;
        align-self: flex-start;
      }
      .tile.is-active { box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 55%, transparent), var(--shadow-lg); }

      /* ---------- 卡片 ---------- */
      .card {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        background: var(--surface);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
          border-color var(--dur) var(--ease);
      }
      .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--border-strong); }
      .card[hidden] { display: none; }
      .card-featured { border-color: var(--border-strong); }
      .card-media { aspect-ratio: 16 / 7; background: var(--surface-2); }
      .card-media-sm { aspect-ratio: 16 / 9; }
      .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .card-body { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; flex: 1; }
      .card-title { margin: 0; font-size: 16px; font-weight: 700; line-height: 1.45; }
      .card-featured .card-title { font-size: 19px; }
      .card-title a { color: var(--fg); transition: color var(--dur) var(--ease); }
      .card:hover .card-title a { color: var(--accent); }
      .card-excerpt {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: auto;
        padding-top: 8px;
        color: var(--faint);
        font-size: 12px;
      }
      .card-meta .read-time { color: var(--faint); }

      /* ---------- 标签 / 徽章 ---------- */
      .tag {
        display: inline-flex;
        align-items: center;
        padding: 2px 10px;
        border-radius: var(--r-pill);
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-size: 12px;
        font-weight: 600;
        line-height: 1.6;
      }
      .tag-plain { background: var(--surface-2); color: var(--muted); }
      .badge {
        display: inline-block;
        font-size: 12px;
        padding: 4px 12px;
        border-radius: var(--r-pill);
        background: var(--accent-soft);
        color: var(--accent-strong);
        font-weight: 600;
      }
      .pill { border-radius: var(--r-pill); }

      /* ---------- 表单字段 ---------- */
      .field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: var(--fg-soft); }
      .field input,
      .field textarea {
        font: inherit;
        font-size: 14px;
        padding: 12px 14px;
        border: 1px solid var(--border-strong);
        border-radius: var(--r-sm);
        background: var(--surface);
        color: var(--fg);
        transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
        width: 100%;
      }
      .field input:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      .field textarea { resize: vertical; min-height: 120px; }

      /* ---------- 提示 / 状态 / 空态 ---------- */
      .hint { color: var(--muted); font-size: 14.5px; line-height: 1.75; margin: 0 0 4px; }
      .status { font-size: 14px; min-height: 20px; margin: 0; color: var(--muted); }
      .status.ok { color: var(--success); }
      .status.err { color: var(--danger); }
      .empty { color: var(--muted); padding: 44px 0; text-align: center; }
      .empty[hidden] { display: none; }

      /* ---------- 正文排版（文章详情） ---------- */
      article.prose {
        max-width: var(--readw);
        margin: 0 auto;
        font-size: 16.5px;
        line-height: 1.9;
        color: var(--fg-soft);
      }
      article.prose h1 {
        font-family: var(--font-display);
        font-size: 32px;
        line-height: 1.32;
        font-weight: 800;
        color: var(--fg);
        margin: 0 0 14px;
        letter-spacing: -0.015em;
      }
      article.prose h2 { font-size: 22px; line-height: 1.4; margin: 34px 0 12px; color: var(--fg); font-weight: 700; }
      article.prose h3 { font-size: 18px; line-height: 1.4; margin: 26px 0 10px; color: var(--fg); font-weight: 700; }
      article.prose p { margin: 0 0 18px; }
      article.prose a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
      article.prose img { max-width: 100%; height: auto; border-radius: var(--r-md); margin: 20px 0; }
      article.prose blockquote {
        margin: 22px 0;
        padding: 8px 20px;
        border-left: 3px solid var(--accent);
        color: var(--muted);
        background: var(--surface-2);
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
      }
      article.prose code {
        background: var(--surface-2);
        padding: 2px 6px;
        border-radius: 6px;
        font-size: 0.9em;
        font-family: var(--font-mono);
      }
      article.prose pre {
        background: var(--surface-2);
        padding: 18px;
        border-radius: var(--r-md);
        overflow: auto;
        border: 1px solid var(--border);
        line-height: 1.6;
      }
      article.prose pre code { background: none; padding: 0; }
      article.prose ul,
      article.prose ol { padding-left: 1.4em; margin: 0 0 18px; }
      article.prose li { margin: 6px 0; }
      article.prose hr { border: 0; border-top: 1px solid var(--border); margin: 30px 0; }
      .cover { width: 100%; border-radius: var(--r-lg); margin: 12px 0 26px; display: block; box-shadow: var(--shadow-md); }

      /* ---------- 右下角悬浮联系簇（滚过首屏后淡入；含 WhatsApp + 联系页） ---------- */
      .float-cluster {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 45;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(10px);
        transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease),
          visibility var(--dur) var(--ease);
      }
      .float-cluster.is-visible { opacity: 1; visibility: visible; transform: none; }
      .float-cluster:focus-within { opacity: 1; visibility: visible; transform: none; }

      .float-contact,
      .float-wa {
        display: inline-flex;
        align-items: center;
        height: 52px;
        padding: 0 15px;
        border-radius: var(--r-pill);
        color: #fff;
        box-shadow: var(--shadow-accent);
        overflow: hidden;
        transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease),
          transform var(--dur) var(--ease);
      }
      .float-contact { background: var(--accent); color: var(--on-accent); }
      .float-contact:hover { background: var(--accent-strong); color: var(--on-accent); }
      .float-wa { background: #25d366; }
      .float-wa:hover { background: #1ebe5b; }
      .float-contact:focus-visible,
      .float-wa:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .float-contact .fc-icon,
      .float-wa .wa-icon { width: 22px; height: 22px; flex: none; }
      .float-contact .fc-label,
      .float-wa .wa-label {
        max-width: 0;
        opacity: 0;
        overflow: hidden;
        white-space: nowrap;
        font-size: 14px;
        font-weight: 600;
        transition: max-width var(--dur) var(--ease), opacity var(--dur) var(--ease),
          margin var(--dur) var(--ease);
      }
      .float-contact:hover .fc-label,
      .float-contact:focus-visible .fc-label,
      .float-wa:hover .wa-label,
      .float-wa:focus-visible .wa-label { max-width: 120px; opacity: 1; margin-left: 8px; }

      /* ---------- 移动端 ---------- */
      @media (max-width: 700px) {
        .site-header { flex-direction: column; align-items: stretch; gap: 6px; padding: 12px 16px; }
        .brand { justify-content: center; } /* 自适应/窄屏下 logo 居中 */
        /* 窄屏：常驻展开标签（触屏无 hover），避开刘海安全区 */
        .float-cluster {
          right: 16px;
          bottom: calc(16px + env(safe-area-inset-bottom, 0px));
          opacity: 1;
          visibility: visible;
          transform: none;
        }
        .float-contact .fc-label,
        .float-wa .wa-label { max-width: 120px; opacity: 1; margin-left: 8px; }
        .header-right { flex-wrap: wrap; justify-content: center; width: 100%; gap: 8px; }
        /* 窄屏：导航行在上 → 图标按钮组（语言+外观）整行居中 → 搜索框独占一行 */
        .header-right > nav { order: 1; }
        .header-right > .header-actions { order: 2; justify-content: center; gap: 14px; }
        .header-search { order: 3; flex: 1 1 100%; width: 100%; max-width: none; }
        .header-search .hs-input { width: 100%; }
        nav { flex-wrap: wrap; gap: 2px; }
        nav a { padding: 7px 12px; }
        /* 窄屏：场景下拉默认收起，点箭头展开（触屏无 hover） */
        .nav-item.has-menu {
          flex: 1 1 100%;
          display: flex;
          flex-wrap: wrap;
          align-items: center;
        }
        .nav-item.has-menu > a { flex: 1 1 auto; width: auto; }
        .nav-item.has-menu .nav-toggle { flex: none; display: inline-flex; padding: 6px 10px; }
        .nav-menu {
          flex: 1 1 100%;
          display: none;
          position: static;
          opacity: 1;
          visibility: visible;
          transform: none;
          box-shadow: none;
          border: none;
          border-left: 2px solid var(--accent-soft);
          margin: 2px 0 2px 8px;
          padding: 2px 0 2px 8px;
          background: transparent;
          min-width: 0;
        }
        .nav-item.has-menu.is-open .nav-menu { display: block; }
        .nav-menu a { padding: 6px 10px; font-size: 13px; }
        .container { padding: 28px 16px 60px; }
        .section-head h2, .page-head h1 { font-size: 23px; }
        .appearance-pop {
          right: 50%;
          transform: translateX(50%) translateY(-6px) scale(0.98);
          transform-origin: top center;
        }
        .appearance-pop.is-open { transform: translateX(50%) translateY(0) scale(1); }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
        .card:hover, .tile:hover { transform: none; }
      }
    </style>

    {/* 全站匿名访问埋点：跳过后台与 Keystatic，sendBeacon 优先，fetch keepalive 兜底 */}
    <script is:inline>
      (function () {
        try {
          var p = location.pathname;
          if (p.indexOf('/admin') === 0 || p.indexOf('/keystatic') === 0) return;
          var ref = document.referrer || '';
          var url = '/api/visit?path=' + encodeURIComponent(p) + '&ref=' + encodeURIComponent(ref);
          if (navigator.sendBeacon) {
            navigator.sendBeacon(url);
          } else {
            fetch(url, { method: 'POST', keepalive: true, credentials: 'same-origin' });
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
