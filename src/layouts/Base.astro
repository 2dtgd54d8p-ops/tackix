---
import { loadSiteData } from '../lib/site-data';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
// 站名/描述/页脚统一读后台「站点信息」singleton，读不到自动回落默认值。
// 此前在此处写死 'Tackix'，导致后台改了站点标题只有首页生效、内页仍是旧标题。
const { site } = await loadSiteData();
const siteTitle = site.title;
const footerText = site.footer ? `Powered by ${site.footer}` : `Powered by ${siteTitle}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? site.description} />
    <title>{title ? `${title} · ${siteTitle}` : siteTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand">{siteTitle}</a>
      <nav>
        <a href="/">首页</a>
        <a href="/posts">文章</a>
        <a href="/search">搜索</a>
        <a href="/contact">联系</a>
        <a href="/keystatic">管理后台</a>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <span>{footerText}</span>
    </footer>
    <style is:global>
      :root {
        --bg: #fbfbfa;
        --fg: #1f2328;
        --muted: #6b7280;
        --accent: #185fa5;
        --border: #e5e7eb;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.6;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .site-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 24px; border-bottom: 1px solid var(--border);
        background: #fff;
      }
      .brand { font-weight: 600; font-size: 18px; color: var(--fg); }
      nav a { margin-left: 18px; color: var(--muted); font-size: 14px; }
      .container { max-width: 760px; margin: 0 auto; padding: 32px 24px; }
      .site-footer {
        text-align: center; color: var(--muted); font-size: 13px;
        padding: 24px; border-top: 1px solid var(--border);
      }
      .empty { color: var(--muted); padding: 40px 0; text-align: center; }
      article.prose h1 { margin-top: 0; }
      article.prose img { max-width: 100%; height: auto; }

      /* 移动端：导航项换行，避免 5 个链接在窄屏挤成一团 */
      @media (max-width: 640px) {
        .site-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 10px;
          padding: 12px 16px;
        }
        nav { display: flex; flex-wrap: wrap; gap: 12px; }
        nav a { margin-left: 0; }
        .container { padding: 20px 16px; }
      }
    </style>
  </body>
</html>
