---
import { loadSiteData } from '../lib/site-data';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
// 站名/描述/页脚统一读后台「站点信息」singleton，读不到自动回落默认值。
// 此前在此处写死 'Tackix'，导致后台改了站点标题只有首页生效、内页仍是旧标题。
const { site } = await loadSiteData();
const siteTitle = site.title;
const footerText = site.footer ? `Powered by ${site.footer}` : `Powered by ${siteTitle}`;

// 导航当前页高亮
const path = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/posts', label: '文章' },
  { href: '/search', label: '搜索' },
  { href: '/contact', label: '联系' },
  { href: '/keystatic', label: '管理后台' },
];
function isActive(href: string) {
  if (href === '/') return path === '/';
  if (href === '/keystatic') return path.startsWith('/keystatic') || path.startsWith('/admin');
  return path === href || path.startsWith(href + '/');
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? site.description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1014" media="(prefers-color-scheme: dark)" />
    <title>{title ? `${title} · ${siteTitle}` : siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ? `${title} · ${siteTitle}` : siteTitle} />
    <meta property="og:description" content={description ?? site.description} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteTitle,
        description: site.description,
        url: (Astro.site ?? Astro.url).href,
      })}
    />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand" aria-label={`${siteTitle} 首页`}>
        <img src="/favicon.svg" alt="" width="26" height="26" />
        <span>{siteTitle}</span>
      </a>
      <nav aria-label="主导航">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={isActive(item.href) ? 'is-active' : ''}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <span>{footerText}</span>
    </footer>
    <style is:global>
      :root {
        /* 表面层次 */
        --bg: #f5f6f8;
        --surface: #ffffff;
        --surface-2: #eef1f5;
        --surface-3: #f8f9fb;

        /* 文字层次 */
        --fg: #15181d;
        --fg-soft: #383d45;
        --muted: #6b7280;
        --faint: #98a0ab;

        /* 主题色（优雅蓝，带层次） */
        --accent: #2f5cbf;
        --accent-strong: #234a9e;
        --accent-soft: #eaf0fb;
        --on-accent: #ffffff;

        /* 状态色 */
        --success: #1c8a4f;
        --success-bg: #e7f6ee;
        --danger: #c0392b;
        --danger-bg: #fbeceb;

        /* 线条 */
        --border: #e6e8ec;
        --border-strong: #d6dae1;

        /* 阴影（柔和分层） */
        --shadow-sm: 0 1px 2px rgba(16, 24, 40, 0.04), 0 1px 3px rgba(16, 24, 40, 0.06);
        --shadow-md: 0 6px 18px rgba(16, 24, 40, 0.08), 0 2px 4px rgba(16, 24, 40, 0.04);
        --shadow-lg: 0 18px 44px rgba(16, 24, 40, 0.12);

        /* 圆角 */
        --r-sm: 8px;
        --r-md: 12px;
        --r-lg: 16px;
        --r-pill: 999px;

        /* 布局 */
        --maxw: 1080px;
        --readw: 720px;

        /* 字体 */
        --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC",
          "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
        --font-display: "Noto Serif SC", "Songti SC", "Source Han Serif SC", Georgia,
          "Times New Roman", serif;
        --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

        /* 动效 */
        --ease: cubic-bezier(0.4, 0, 0.2, 1);
        --dur: 0.18s;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e1014;
          --surface: #16191f;
          --surface-2: #1d212a;
          --surface-3: #12151a;

          --fg: #e9ebef;
          --fg-soft: #c6ccd4;
          --muted: #98a0ab;
          --faint: #6b7280;

          --accent: #7aa0f4;
          --accent-strong: #9bb6f8;
          --accent-soft: #1b2740;
          --on-accent: #0e1014;

          --success: #4ec585;
          --success-bg: #15281d;
          --danger: #ef6f64;
          --danger-bg: #2a1715;

          --border: #262b34;
          --border-strong: #333a45;

          --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
          --shadow-md: 0 6px 18px rgba(0, 0, 0, 0.36);
          --shadow-lg: 0 18px 44px rgba(0, 0, 0, 0.5);
        }
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--bg);
        color: var(--fg);
        line-height: 1.65;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        font-feature-settings: "kern", "liga";
      }
      ::selection { background: var(--accent-soft); color: var(--fg); }
      a { color: var(--accent); text-decoration: none; transition: color var(--dur) var(--ease); }
      a:hover { color: var(--accent-strong); }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      /* 滚动条（WebKit） */
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-thumb {
        background: var(--border-strong);
        border-radius: var(--r-pill);
        border: 2px solid var(--bg);
      }
      ::-webkit-scrollbar-thumb:hover { background: var(--faint); }

      /* ---------- 顶栏 ---------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 24px;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
        background: color-mix(in srgb, var(--surface) 82%, transparent);
        backdrop-filter: saturate(180%) blur(12px);
        -webkit-backdrop-filter: saturate(180%) blur(12px);
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        font-weight: 600;
        font-size: 18px;
        letter-spacing: 0.01em;
        color: var(--fg);
      }
      .brand img {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        box-shadow: var(--shadow-sm);
      }
      .brand:hover { text-decoration: none; color: var(--fg); }
      nav { display: flex; align-items: center; gap: 2px; }
      nav a {
        position: relative;
        color: var(--muted);
        font-size: 14px;
        padding: 7px 11px;
        border-radius: var(--r-sm);
        transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
      }
      nav a:hover { color: var(--fg); text-decoration: none; }
      nav a::after {
        content: "";
        position: absolute;
        left: 11px;
        right: 11px;
        bottom: 3px;
        height: 2px;
        border-radius: 2px;
        background: var(--accent);
        transform: scaleX(0);
        opacity: 0;
        transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
      }
      nav a:hover::after,
      nav a:focus-visible::after { transform: scaleX(1); opacity: 1; }
      nav a.is-active { color: var(--fg); font-weight: 500; }
      nav a.is-active::after { transform: scaleX(1); opacity: 1; }

      /* ---------- 内容容器 ---------- */
      .container { max-width: var(--maxw); margin: 0 auto; padding: 40px 24px 72px; }
      .site-footer {
        text-align: center;
        color: var(--muted);
        font-size: 13px;
        padding: 32px 24px;
        border-top: 1px solid var(--border);
        margin-top: 24px;
      }
      .site-footer span { opacity: 0.92; }

      /* ---------- 通用版块标题 ---------- */
      .section-title,
      .block-title {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 500;
        color: var(--faint);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      /* ---------- 页面主标题（非正文场景） ---------- */
      .container > section > h1 {
        font-family: var(--font-display);
        font-size: 30px;
        font-weight: 700;
        line-height: 1.3;
        color: var(--fg);
        letter-spacing: -0.01em;
        margin: 0 0 6px;
      }

      /* ---------- 按钮 ---------- */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 18px;
        border: 1px solid var(--border-strong);
        border-radius: var(--r-pill);
        background: var(--surface);
        color: var(--fg-soft);
        font: inherit;
        font-size: 14px;
        line-height: 1.2;
        cursor: pointer;
        transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
          background var(--dur) var(--ease), transform var(--dur) var(--ease);
      }
      .btn:hover {
        border-color: var(--accent);
        color: var(--accent);
        text-decoration: none;
      }
      .btn:active { transform: translateY(1px); }
      .btn-primary {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--on-accent);
        font-weight: 500;
      }
      .btn-primary:hover {
        background: var(--accent-strong);
        border-color: var(--accent-strong);
        color: var(--on-accent);
      }

      /* ---------- 卡片（共享） ---------- */
      .card {
        display: flex;
        flex-direction: column;
        border: 1px solid var(--border);
        border-radius: var(--r-md);
        background: var(--surface);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
          border-color var(--dur) var(--ease);
      }
      .card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: var(--border-strong);
      }
      .card[hidden] { display: none; }
      .card-featured { border-color: var(--border-strong); }
      .card-media { aspect-ratio: 16 / 7; background: var(--surface-2); }
      .card-media-sm { aspect-ratio: 16 / 9; }
      .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .card-body { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px; flex: 1; }
      .card-title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.4; }
      .card-featured .card-title { font-size: 18px; }
      .card-title a { color: var(--fg); transition: color var(--dur) var(--ease); }
      .card:hover .card-title a { color: var(--accent); }
      .card-excerpt {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: auto;
        padding-top: 8px;
        color: var(--faint);
        font-size: 12px;
      }
      .card-meta .read-time { color: var(--faint); }

      /* ---------- 标签 / 徽章 / 胶囊 ---------- */
      .tag {
        display: inline-flex;
        align-items: center;
        padding: 2px 9px;
        border-radius: 6px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 12px;
        font-weight: 500;
        line-height: 1.6;
      }
      .tag-plain { background: var(--surface-2); color: var(--muted); }
      .badge {
        display: inline-block;
        font-size: 12px;
        padding: 3px 11px;
        border-radius: var(--r-pill);
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 500;
      }
      .pill { border-radius: var(--r-pill); }

      /* ---------- 表单字段 ---------- */
      .field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
        color: var(--fg-soft);
      }
      .field input,
      .field textarea {
        font: inherit;
        font-size: 14px;
        padding: 10px 12px;
        border: 1px solid var(--border-strong);
        border-radius: var(--r-sm);
        background: var(--surface);
        color: var(--fg);
        transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
        width: 100%;
      }
      .field input:focus,
      .field textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }
      .field textarea { resize: vertical; min-height: 120px; }

      /* ---------- 提示 / 状态 / 空态 ---------- */
      .hint { color: var(--muted); font-size: 14px; line-height: 1.7; margin: 0 0 4px; }
      .status { font-size: 14px; min-height: 20px; margin: 0; color: var(--muted); }
      .status.ok { color: var(--success); }
      .status.err { color: var(--danger); }
      .empty { color: var(--muted); padding: 40px 0; text-align: center; }
      .empty[hidden] { display: none; }

      /* ---------- 正文排版（文章详情） ---------- */
      article.prose {
        max-width: var(--readw);
        margin: 0 auto;
        font-size: 16px;
        line-height: 1.85;
        color: var(--fg-soft);
      }
      article.prose h1 {
        font-family: var(--font-display);
        font-size: 32px;
        line-height: 1.3;
        font-weight: 700;
        color: var(--fg);
        margin: 0 0 14px;
        letter-spacing: -0.01em;
      }
      article.prose h2 { font-size: 22px; line-height: 1.4; margin: 32px 0 12px; color: var(--fg); }
      article.prose h3 { font-size: 18px; line-height: 1.4; margin: 24px 0 10px; color: var(--fg); }
      article.prose p { margin: 0 0 18px; }
      article.prose a {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }
      article.prose img { max-width: 100%; height: auto; border-radius: var(--r-md); margin: 20px 0; }
      article.prose blockquote {
        margin: 22px 0;
        padding: 6px 18px;
        border-left: 3px solid var(--accent);
        color: var(--muted);
        background: var(--surface-2);
        border-radius: 0 var(--r-sm) var(--r-sm) 0;
      }
      article.prose code {
        background: var(--surface-2);
        padding: 2px 6px;
        border-radius: 6px;
        font-size: 0.9em;
        font-family: var(--font-mono);
      }
      article.prose pre {
        background: var(--surface-2);
        padding: 16px;
        border-radius: var(--r-md);
        overflow: auto;
        border: 1px solid var(--border);
        line-height: 1.6;
      }
      article.prose pre code { background: none; padding: 0; }
      article.prose ul,
      article.prose ol { padding-left: 1.4em; margin: 0 0 18px; }
      article.prose li { margin: 6px 0; }
      article.prose hr { border: 0; border-top: 1px solid var(--border); margin: 28px 0; }
      .cover {
        width: 100%;
        border-radius: var(--r-md);
        margin: 12px 0 24px;
        display: block;
        box-shadow: var(--shadow-sm);
      }

      /* ---------- 移动端 ---------- */
      @media (max-width: 640px) {
        .site-header {
          flex-direction: column;
          align-items: stretch;
          gap: 8px;
          padding: 12px 16px;
        }
        nav { flex-wrap: wrap; gap: 2px; }
        nav a { padding: 6px 10px; }
        .container { padding: 24px 16px 56px; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *,
        *::before,
        *::after {
          animation-duration: 0.001ms !important;
          transition-duration: 0.001ms !important;
        }
        .card:hover { transform: none; }
      }
    </style>
  </body>
</html>
