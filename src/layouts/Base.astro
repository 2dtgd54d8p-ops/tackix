---
import { loadSiteData, loadContent } from '../lib/site-data';
import { getLocale, ogLocale, type Locale } from '../lib/i18n';
import SEO from '../components/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  /** 可选：显式指定语种（/en 镜像页用），缺省时按 Astro i18n 路由取 */
  locale?: Locale;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  image?: string;
}
const { title, description, locale: localeProp, type, publishedTime, modifiedTime, keywords, image } =
  Astro.props;
// 当前语种：优先用显式传入的（镜像页），否则按 Astro i18n 路由取（/en/* → en）。
const locale = localeProp ?? getLocale(Astro);
// 预上线闸门：未正式上线时全站输出 noindex 并显示顶部提示条
import { prelaunchBanner } from '../lib/prelaunch';
const prelaunchNotice = prelaunchBanner();
const localePrefix = locale === 'en' ? '/en' : '';
// 站名/描述/页脚统一读后台「站点信息」singleton，读不到自动回落默认值（按语种取词）。
const { site } = await loadSiteData(locale);
const siteTitle = site.title;
// 页头左上角品牌名：后台「站点信息 · 页头品牌名」可编辑；留空则回退到站点标题。
// 与 SEO/JSON-LD 的完整站点标题（siteTitle）解耦，品牌名可更简短。
const brandText = site.brandName || siteTitle;
// WhatsApp 号码（来自后台「站点信息」）；为空则不显示 WhatsApp 悬浮按钮
const whatsappNumber = (site.whatsapp ?? '').trim();
// 联系方式（P0-3）：页脚每页可达，是预上线期最主要的转化入口。
// 任一为空即不渲染该项，避免出现空链接。
const contactEmail = (site.email ?? '').trim();
const contactPhone = (site.phone ?? '').trim();
const contactCompany = (site.company ?? '').trim();
// WhatsApp 预填话术：后台可配，避免所有入口共用一句硬编码文案
const waPrefill = (site.whatsappPrefill ?? '').trim() || 'Hello, I would like a quotation for industrial adhesives and sealants. Could you share technical specs and support?';

const path = Astro.url.pathname;
/** 把裸路径拼上当前语种前缀（首页特殊处理） */
function navHref(href: string): string {
  if (href === '/') return localePrefix ? localePrefix + '/' : '/';
  return localePrefix + href;
}
// 主导航与页脚署名来自后台「全局界面文案」singleton（可编辑、前后端贯通）。
// 英文路径(/en)下显示 en 标签；中文路径下显示 zh 标签（loadContent(locale) 已取词）。
// 后台未配置时回退 keystatic.config 的 UI_NAV_DEFAULT（与既有导航一致）。
const uiContent = await loadContent(locale);
const navItems = uiContent.ui.navItems.map((n) => ({
  href: n.href,
  label: n.label,
  // 该导航项是否悬停展开「场景方案」下拉
  scenariosMenu: !!(n as any).scenariosMenu,
}));
// 场景方案下拉内容（已发布场景，按当前语种取词）；空数组时下拉不渲染
const scenarioMenu = uiContent.ui.scenariosMenu || [];
// 导航图标：按 href 语义映射（后台改标签不影响图标）；新增导航项回退通用图标。
// SVG 用 currentColor，随文字颜色在 hover/active 时一起变色。
const svg = (inner: string) =>
  `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
// 场景区四宫格（下拉子项的兜底图标）
const SOLUTIONS_ICON = svg('<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>');
const NAV_ICONS: Record<string, string> = {
  '/': svg('<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/><path d="M9.5 21v-6h5v6"/>'),
  '/solutions': SOLUTIONS_ICON,
  '/knowledge': svg('<path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5"/><path d="M9 12h7M9 16h7"/>'),
  '/contact': svg('<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>'),
  // 选型工具 → 滑块/调参（语义：筛选/匹配工具）
  '/selector': svg('<path d="M4 6h10M18 6h2M4 12h2M10 12h10M4 18h7M15 18h5"/><circle cx="15" cy="6" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="12" cy="18" r="2"/>'),
  // 案例库 → 案例集（语义：案例合集）
  '/cases': svg('<path d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2z"/><path d="M20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"/>'),
  // 资料下载 → 下载（箭头落入托盘：语义：技术文档下载）
  '/downloads': svg('<path d="M12 3v12"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4 18v1.5A2.5 2.5 0 0 0 6.5 22h11a2.5 2.5 0 0 0 2.5-2.5V18"/>'),
  // 场景子项：按 slug 语义区分（新增场景自动回退到场景区四宫格图标）
  // 厨卫防霉防漏 → 水滴
  '/solutions/kitchen-bath-mould': svg('<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>'),
  // 门窗渗水密封 → 窗格
  '/solutions/window-door-leak': svg('<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M12 4v16M4 12h16"/>'),
  // 瓷砖填缝与美缝 → 砖块
  '/solutions/tile-grout': svg('<rect x="3" y="4" width="18" height="7" rx="1.5"/><rect x="3" y="13" width="18" height="7" rx="1.5"/><path d="M9 4v7M15 13v7"/>'),
  // 屋顶与露台防水 → 雨伞
  '/solutions/roof-waterproof': svg('<path d="M12 3a9 9 0 0 1 9 9H3a9 9 0 0 1 9-9z"/><path d="M12 12v6a2 2 0 0 0 4 0"/>'),
};
const DEFAULT_NAV_ICON = svg('<circle cx="12" cy="12" r="3"/>');
function navIcon(href: string): string {
  return NAV_ICONS[href] ?? DEFAULT_NAV_ICON;
}
// 下拉子项图标：命中场景专属图标，未命中回退场景区四宫格
function scenarioIcon(slug: string): string {
  return NAV_ICONS['/solutions/' + slug] ?? SOLUTIONS_ICON;
}
const footerText = uiContent.ui.footerText;
const footerAdminLabel = uiContent.ui.footerAdminLabel;
// 页脚报表链接标签 + 浮动按钮标签/无障碍标签（后台 ui 单例可编辑）
const footerReportLabel = uiContent.ui.footerReportLabel;
const whatsappLabel = uiContent.ui.whatsappLabel;
const whatsappAria = uiContent.ui.whatsappAria;
const contactAria = uiContent.ui.contactAria;
// 全局搜索框占位符（后台「列表页标题」singleton 可编辑）
const searchPlaceholder = uiContent.pages.searchPlaceholder;

// hreflang 备用语言链接：当前语种 + 另一语种（先去 /en 前缀再重组）。
const basePath = path.replace(/^\/en(?=\/|$)/, '') || '/';
const alternates = [
  { lang: 'zh-CN', href: basePath },
  { lang: 'en', href: '/en' + (basePath === '/' ? '' : basePath) },
];
/** 归一化路径（去尾斜杠）用于高亮比对，避免 /en/products 与 /en/products/ 不一致 */
function norm(p: string) { return p.replace(/\/+$/, '') || '/'; }
function isActive(href: string) {
  const h = norm(navHref(href));
  const cur = norm(path);
  if (href === '/keystatic') return path.startsWith('/keystatic') || path.startsWith('/admin');
  if (h === '/') return cur === '/';
  return cur === h || cur.startsWith(h + '/');
}
// 右下角悬浮「联系我」：联系页自身与后台区不显示，避免冗余
const showFloatContact =
  !path.startsWith('/contact') && !path.startsWith('/keystatic') && !path.startsWith('/admin');
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
          var a = localStorage.getItem('accent');
          if (a) document.documentElement.setAttribute('data-accent', a);
        } catch (e) {}
      })();
    </script>
    <SEO
      title={title}
      description={description}
      alternates={alternates}
      locale={ogLocale(locale)}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
      image={image}
    />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12101c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteTitle,
        description: site.description,
        url: (Astro.site ?? Astro.url).href,
      })}
    />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a
        href={localePrefix || '/'}
        class="brand"
        aria-label={locale === 'en' ? `${brandText} home` : `${brandText} 首页`}
      >
        <img src="/favicon.svg" alt="" width="26" height="26" />
        <span>{brandText}</span>
      </a>
      <div class="header-right">
        <form class="header-search" role="search" action={navHref('/search')} method="get">
          <button type="submit" class="hs-submit" aria-label="搜索">
            <svg class="hs-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" /><path d="M21 21l-4.35-4.35" /></svg>
          </button>
          <input class="hs-input" type="search" name="q" placeholder={searchPlaceholder} aria-label="Search" enterkeyhint="search" />
        </form>
        <nav aria-label="主导航">
          {
            navItems.map((item) => (
              item.scenariosMenu && scenarioMenu.length > 0 ? (
                <div class="nav-item has-menu">
                  <a
                    href={navHref(item.href)}
                    class={isActive(item.href) ? 'is-active' : ''}
                    aria-haspopup="true"
                  >
                    <span class="nav-ico" set:html={navIcon(item.href)} />
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="nav-toggle"
                    aria-expanded="false"
                    aria-controls="nav-menu-scenarios"
                    aria-label={locale === 'en' ? 'Toggle scenario menu' : '展开场景方案'}
                  >
                    <span class="caret" aria-hidden="true">
                      <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 2.5 8.5 6l-4 3.5" /></svg>
                    </span>
                  </button>
                  <ul class="nav-menu" id="nav-menu-scenarios" role="menu">
                    {
                      scenarioMenu.map((sc) => (
                        <li role="none">
                          <a role="menuitem" href={navHref('/solutions/' + sc.slug)}>
                            <span class="nav-ico nav-ico-sm" set:html={scenarioIcon(sc.slug)} />
                            {sc.name}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              ) : (
                <a
                  href={navHref(item.href)}
                  class={isActive(item.href) ? 'is-active' : ''}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  <span class="nav-ico" set:html={navIcon(item.href)} />
                  {item.label}
                </a>
              )
            ))
          }
        </nav>
        <!-- 图标按钮组（语言切换 + 外观）：桌面端跟在导航后，窄屏独占一行排在导航下方 -->
        <div class="header-actions">
          <!-- 语言切换（中文默认 / + 英文 /en）：点选即跳转对应语种版本并记忆偏好 -->
          <div class="lang-wrap">
            <button
              id="lang-btn"
              class="appearance-btn lang-btn"
              type="button"
              aria-label="Language"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z" /><path d="M3.5 9h17M3.5 15h17" /></svg>
            </button>
            <div id="lang-pop" class="lang-pop appearance-pop" role="menu" aria-label="Language">
              <button class="lang-opt" type="button" data-lang="zh-CN" aria-pressed={locale !== 'en'}>
                <span class="lang-name"><span class="lang-flag" aria-hidden="true">🇨🇳</span>中文</span>
                <span class="lang-code">ZH</span>
              </button>
              <button class="lang-opt" type="button" data-lang="en" aria-pressed={locale === 'en'}>
                <span class="lang-name"><span class="lang-flag" aria-hidden="true">🇬🇧</span>English</span>
                <span class="lang-code">EN</span>
              </button>
            </div>
          </div>
          <div class="appearance-wrap">
          <button
            id="appearance-btn"
            class="appearance-btn"
            type="button"
            aria-label="Appearance"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <svg class="icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c1.1 0 1.8-.9 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.4-.5-.8-.5-1.3 0-1 .8-1.7 1.7-1.7H16c3.3 0 6-2.7 6-6 0-4.4-4.5-8-10-8z" /><circle cx="7.5" cy="10.5" r="1.1" fill="currentColor" stroke="none" /><circle cx="12" cy="7.5" r="1.1" fill="currentColor" stroke="none" /><circle cx="16.5" cy="8.5" r="1.1" fill="currentColor" stroke="none" /><circle cx="8.5" cy="15" r="1.1" fill="currentColor" stroke="none" /></svg>
          </button>
          <div id="appearance-pop" class="appearance-pop" role="menu" aria-label="Appearance">
            <div class="ap-section">
              <div class="ap-title">Theme</div>
              <div class="mode-row" role="group" aria-label="明暗模式">
                <button class="mode-btn" type="button" data-mode="auto" aria-pressed="true">
                  <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
                  <span>Auto</span>
                </button>
                <button class="mode-btn" type="button" data-mode="light" aria-pressed="false">
                  <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.5M12 19.5V22M4.22 4.22l1.77 1.77M18.01 18.01l1.77 1.77M2 12h2.5M19.5 12H22M4.22 19.78l1.77-1.77M18.01 5.99l1.77-1.77" /></svg>
                  <span>Light</span>
                </button>
                <button class="mode-btn" type="button" data-mode="dark" aria-pressed="false">
                  <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                  <span>Dark</span>
                </button>
              </div>
            </div>
            <div class="ap-section">
              <div class="ap-title">Accent</div>
              <div class="swatch-row" role="group" aria-label="主题色切换">
                <button class="swatch is-active" type="button" data-accent="violet" style="--sw:#7c4df0" aria-label="紫色主题" aria-pressed="true"></button>
                <button class="swatch" type="button" data-accent="blue" style="--sw:#3a7bff" aria-label="蓝色主题" aria-pressed="false"></button>
                <button class="swatch" type="button" data-accent="green" style="--sw:#18a06a" aria-label="绿色主题" aria-pressed="false"></button>
                <button class="swatch" type="button" data-accent="amber" style="--sw:#f0883e" aria-label="橙色主题" aria-pressed="false"></button>
                <button class="swatch" type="button" data-accent="rose" style="--sw:#e0529c" aria-label="粉色主题" aria-pressed="false"></button>
              </div>
            </div>
          </div>
        </div><!-- /.header-actions -->
      </div>
    </header>
    {
      prelaunchNotice && (
        <aside class="prelaunch-bar" role="status">
          <strong>{prelaunchNotice.title}</strong>
          <span>{prelaunchNotice.body}</span>
        </aside>
      )
    }
    <main class="container">
      <slot />
    </main>
      <footer class="site-footer">
      {
        (contactEmail || contactPhone || contactCompany) && (
          <div class="footer-contact">
            {contactCompany && <span class="fc-company">{contactCompany}</span>}
            {contactEmail && (
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            )}
            {contactPhone && <a href={`tel:${contactPhone.replace(/[^\d+]/g, '')}`}>{contactPhone}</a>}
          </div>
        )
      }
      <span>{footerText}</span>
      <span class="footer-ai-note">{locale === 'en' ? 'Some imagery is AI-generated for illustration only.' : '部分配图由 AI 生成，仅作示意。'}</span>
      <a class="footer-admin" href="/keystatic">{footerAdminLabel}</a>
      <a class="footer-admin" href="/admin/report">{footerReportLabel}</a>
    </footer>
    {showFloatContact && (
      <div class="float-cluster" id="float-cluster">
        {
          whatsappNumber && site.showWhatsappFloat && (
            <a
              class="float-wa"
              href={`https://wa.me/${whatsappNumber}?text=` + encodeURIComponent(waPrefill)}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={whatsappAria}
            >
              <svg class="wa-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 0 1 8.413 3.488 11.82 11.82 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.978-1.04zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z" /></svg>
              <span class="wa-label">{whatsappLabel}</span>
            </a>
          )
        }
        <a class="float-contact" id="float-contact" href={navHref('/contact')} aria-label={contactAria}>
          <svg class="fc-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.7 9.7 0 0 1-2.8-.4L4 21l1.4-4.2A8.4 8.4 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z" /><path d="M8.5 10.4h7M8.5 13.4h4" /></svg>
          <span class="fc-label">Contact</span>
        </a>
      </div>
    )}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        function effectiveTheme() {
          var t = root.getAttribute('data-theme');
          return t ? t : (mq.matches ? 'dark' : 'light');
        }

        var appBtn = document.getElementById('appearance-btn');
        var appPop = document.getElementById('appearance-pop');
        if (!appBtn || !appPop) return;

        function openPop() {
          appPop.classList.add('is-open');
          appBtn.setAttribute('aria-expanded', 'true');
        }
        function closePop() {
          appPop.classList.remove('is-open');
          appBtn.setAttribute('aria-expanded', 'false');
        }
        appBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          if (appPop.classList.contains('is-open')) closePop();
          else openPop();
        });
        document.addEventListener('click', function (e) {
          if (appPop.classList.contains('is-open') && !appPop.contains(e.target) && e.target !== appBtn) closePop();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closePop();
        });

        // 明暗三态：auto / light / dark
        var modeBtns = appPop.querySelectorAll('.mode-btn');
        function paintMode() {
          var t = root.getAttribute('data-theme'); // null → 自动
          modeBtns.forEach(function (b) {
            var m = b.getAttribute('data-mode');
            var on = (m === 'auto' && !t) || m === t;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
          var dark = effectiveTheme() === 'dark';
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#12101c' : '#ffffff');
        }
        modeBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            var m = b.getAttribute('data-mode');
            if (m === 'auto') root.removeAttribute('data-theme');
            else root.setAttribute('data-theme', m);
            try { localStorage.setItem('theme', m); } catch (e) {}
            paintMode();
          });
        });
        if (mq.addEventListener) mq.addEventListener('change', paintMode);
        paintMode();

        // 强调色切换
        var swatches = appPop.querySelectorAll('.swatch');
        function paintAccent() {
          var a = root.getAttribute('data-accent') || 'violet';
          swatches.forEach(function (b) {
            var on = b.getAttribute('data-accent') === a;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
          });
        }
        swatches.forEach(function (b) {
          b.addEventListener('click', function () {
            var a = b.getAttribute('data-accent');
            root.setAttribute('data-accent', a);
            try { localStorage.setItem('accent', a); } catch (e) {}
            paintAccent();
          });
        });
        paintAccent();
      })();
    </script>
    <script is:inline>
      // 右下角悬浮「联系我」：滚过首屏后淡入，避免与 Hero 抢视线的干扰
      (function () {
        var el = document.getElementById('float-cluster');
        if (!el) return;
        function onScroll() {
          el.classList.toggle('is-visible', window.scrollY > 320);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
    <script is:inline>
      // 语言切换：在当前页面两种语种间跳转（/en 前缀互换），并记忆偏好。
      (function () {
        var btn = document.getElementById('lang-btn');
        var pop = document.getElementById('lang-pop');
        if (!btn || !pop) return;
        function open() { pop.classList.add('is-open'); btn.setAttribute('aria-expanded', 'true'); }
        function close() { pop.classList.remove('is-open'); btn.setAttribute('aria-expanded', 'false'); }
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          pop.classList.contains('is-open') ? close() : open();
        });
        document.addEventListener('click', function (e) {
          if (pop.classList.contains('is-open') && !pop.contains(e.target) && e.target !== btn) close();
        });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
        var opts = pop.querySelectorAll('.lang-opt');
        opts.forEach(function (o) {
          o.addEventListener('click', function () {
            var target = o.getAttribute('data-lang'); // 'zh-CN' | 'en'
            var cur = document.documentElement.getAttribute('lang'); // 'zh-CN' | 'en'
            if (target === cur) { close(); return; }
            var p = window.location.pathname;
            var base = p.replace(/^\/en(?=\/|$)/, '') || '/'; // 去 /en 前缀
            var dest = target === 'en' ? ('/en' + (base === '/' ? '' : base)) : base;
            try { localStorage.setItem('locale', target); } catch (e) {}
            window.location.href = dest;
          });
        });
      })();
    </script>
    <script is:inline>
      // 场景下拉：默认收起，点箭头展开/收起；Esc 或点击外部关闭。
      (function () {
        var items = document.querySelectorAll('.nav-item.has-menu');
        if (!items.length) return;
        function setState(item, open) {
          item.classList.toggle('is-open', open);
          var b = item.querySelector('.nav-toggle');
          if (b) b.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        function closeAll(except) {
          items.forEach(function (it) { if (it !== except) setState(it, false); });
        }
        items.forEach(function (item) {
          var btn = item.querySelector('.nav-toggle');
          if (!btn) return;
          btn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var willOpen = !item.classList.contains('is-open');
            closeAll(item);
            setState(item, willOpen);
          });
        });
        document.addEventListener('click', function (e) {
          items.forEach(function (item) {
            if (!item.contains(e.target)) setState(item, false);
          });
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeAll(null);
        });
      })();
    </script>
    <style is:global>
