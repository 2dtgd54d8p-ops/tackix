---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Base from '../layouts/Base.astro';
import { loadSiteData, buildFilterOptions } from '../lib/site-data';

const reader = createReader(process.cwd(), keystaticConfig);
let slugs = [];
try {
  slugs = await reader.collections.posts.list();
} catch (e) {
  console.warn('[build] 读取文章列表失败（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
}

const posts = (await Promise.all(
  slugs.map(async (slug) => {
    try {
      const post = await reader.collections.posts.read(slug);
      return post ? { slug, ...post } : null;
    } catch (e) {
      console.warn('[build] 读取文章失败：', slug, e);
      return null;
    }
  })
)).filter((p) => p && p.published !== false); // 仅展示已发布

// 按发布日期倒序
posts.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

// 置顶（后台勾选「首页置顶」）单独抽出来做大卡片；同一篇只出现一次
const featured = posts.find((p) => p.featured);
const rest = posts.filter((p) => p.slug !== featured?.slug);

// 分类/标签/站点信息统一从公共模块读取（后台可增删改），读不到自动回落默认值
const { site: siteInfo, categories: managedCategories, categoryLabel, tagLabel, tags } =
  await loadSiteData();

// 只列出实际有文章的分类/标签，避免出现点进去是空的筛选项
const categories = buildFilterOptions(posts, managedCategories);
const usedTags = tags.filter((t) => posts.some((p) => (p.tags ?? []).includes(t.value)));

// 计数基于网格实际展示的 rest，避免筛选后数量对不上
const catCounts = {};
rest.forEach((p) => {
  const k = p.category ?? 'uncategorized';
  catCounts[k] = (catCounts[k] ?? 0) + 1;
});
const tagCounts = {};
rest.forEach((p) => (p.tags ?? []).forEach((t) => { tagCounts[t] = (tagCounts[t] ?? 0) + 1; }));

// 分类卡：柔和底色随索引轮换，营造"彩色卡片"观感
const CAT_TINTS = ['#e8f1fb', '#e9f7ee', '#fbf2e6', '#f1ebfb', '#fbe9f0', '#e7f3fb'];
const categoryCards = categories.map((c, i) => ({
  ...c,
  count: c.value === 'all' ? rest.length : (catCounts[c.value] ?? 0),
  tint: CAT_TINTS[i % CAT_TINTS.length],
}));
const tagCards = usedTags.map((t) => ({ ...t, count: tagCounts[t.value] ?? 0 }));
---

<Base
  title="首页"
  description={siteInfo.description || `${siteInfo.title} —— 记录技术、实践与思考的独立空间。`}
>
  <section class="hero">
    <div class="hero-blob hero-blob-a" aria-hidden="true"></div>
    <div class="hero-blob hero-blob-b" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1 class="hero-title">{siteInfo.title}</h1>
      <p class="hero-sub">{siteInfo.tagline || '记录技术、实践与思考的独立空间。写代码，也写字。'}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#latest">开始阅读</a>
        <a class="btn" href="/posts">全部分类</a>
      </div>
    </div>
  </section>

  {
    posts.length === 0 ? (
      <p class="empty">还没有文章，去后台创建第一篇吧。</p>
    ) : (
      <>
        {/* 分类导航卡：替代原筛选按钮，点击即筛选下方网格并平滑滚动 */}
        <section class="block">
          <h2 class="block-title">浏览分类</h2>
          <div class="cat-cards">
            {categoryCards.map((c, i) => (
              <button
                type="button"
                class={`cat-card${i === 0 ? ' is-active' : ''}`}
                data-filter={c.value}
                aria-pressed={i === 0 ? 'true' : 'false'}
                style={`--tint:${c.tint}`}
              >
                <span class="cat-name">{c.label}</span>
                <span class="cat-count">{c.count}</span>
              </button>
            ))}
          </div>
        </section>

        {/* 关于本站 */}
        <section class="block about-block">
          <h2 class="block-title">关于本站</h2>
          <p class="about-text">{siteInfo.description || '记录技术、实践与思考的独立空间。'}</p>
          <div class="about-actions">
            <a class="btn btn-primary" href="/posts">浏览全部文章</a>
            <a class="btn" href="/contact">联系我</a>
          </div>
        </section>

        {/* 热门标签：点击按标签筛选 */}
        {tagCards.length > 0 && (
          <section class="block">
            <h2 class="block-title">热门标签</h2>
            <div class="tag-pills">
              {tagCards.map((t) => (
                <button type="button" class="tag-pill" data-tagfilter={t.value} aria-pressed="false">
                  #{tagLabel(t.value)} <span class="pill-count">{t.count}</span>
                </button>
              ))}
            </div>
          </section>
        )}

        {featured && (
          <section class="block">
            <h2 class="block-title">置顶</h2>
            <article class="card card-featured">
              {featured.cover && (
                <div class="card-media">
                  <img src={featured.cover} alt="" loading="eager" />
                </div>
              )}
              <div class="card-body">
                <h3 class="card-title">
                  <a href={`/posts/${featured.slug}`}>{featured.title}</a>
                </h3>
                {featured.excerpt && <p class="card-excerpt">{featured.excerpt}</p>}
                <div class="card-meta">
                  <span class="tag">{categoryLabel(featured.category)}</span>
                  {(featured.tags ?? []).map((t) => (
                    <span class="tag tag-plain">{tagLabel(t)}</span>
                  ))}
                  {featured.publishedAt && <span>{featured.publishedAt}</span>}
                </div>
              </div>
            </article>
          </section>
        )}

        <section class="block" id="latest">
          <h2 class="block-title">最新文章</h2>
          {rest.length === 0 ? (
            <p class="empty">暂无更多文章。</p>
          ) : (
            <div class="grid">
              {rest.map((post) => (
                <article
                  class="card"
                  data-category={post.category ?? 'uncategorized'}
                  data-tags={(post.tags ?? []).join(' ')}
                >
                  {post.cover && (
                    <div class="card-media card-media-sm">
                      <img src={post.cover} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={`/posts/${post.slug}`}>{post.title}</a>
                    </h3>
                    {post.excerpt && <p class="card-excerpt">{post.excerpt}</p>}
                    <div class="card-meta">
                      <span class="tag">{categoryLabel(post.category)}</span>
                      {(post.tags ?? []).slice(0, 2).map((t) => (
                        <span class="tag tag-plain">{tagLabel(t)}</span>
                      ))}
                      {post.publishedAt && <span>{post.publishedAt}</span>}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
          <p class="empty" data-empty hidden>该筛选下暂无文章。</p>
        </section>

        <script>
          // 分类卡 + 标签胶囊：纯前端统一筛选，切换无需重新部署
          const grid = document.querySelector('.grid');
          const emptyHint = document.querySelector('[data-empty]');
          const cards = grid ? Array.from(grid.querySelectorAll('.card')) : [];
          const catCards = Array.from(document.querySelectorAll('.cat-card'));
          const tagPills = Array.from(document.querySelectorAll('.tag-pill'));
          const gridSection = document.getElementById('latest');

          function applyFilter(kind, value) {
            let visible = 0;
            cards.forEach((c) => {
              let show = false;
              if (kind === 'all') show = true;
              else if (kind === 'cat') show = c.getAttribute('data-category') === value;
              else if (kind === 'tag')
                show = (c.getAttribute('data-tags') || '').split(' ').includes(value);
              c.hidden = !show;
              if (show) visible += 1;
            });
            if (emptyHint) emptyHint.hidden = visible > 0;
            if (gridSection && visible > 0)
              gridSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }

          catCards.forEach((btn) => {
            btn.addEventListener('click', () => {
              catCards.forEach((b) => {
                const on = b === btn;
                b.classList.toggle('is-active', on);
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
              });
              tagPills.forEach((p) => {
                p.classList.remove('is-active');
                p.setAttribute('aria-pressed', 'false');
              });
              const v = btn.getAttribute('data-filter');
              applyFilter(v === 'all' ? 'all' : 'cat', v);
            });
          });

          tagPills.forEach((btn) => {
            btn.addEventListener('click', () => {
              tagPills.forEach((p) => {
                const on = p === btn;
                p.classList.toggle('is-active', on);
                p.setAttribute('aria-pressed', on ? 'true' : 'false');
              });
              catCards.forEach((c) => {
                c.classList.remove('is-active');
                c.setAttribute('aria-pressed', 'false');
              });
              applyFilter('tag', btn.getAttribute('data-tagfilter'));
            });
          });
        </script>
      </>
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #e6f1fb;
    border-bottom: 1px solid var(--border);
    margin-top: -32px;                 /* 顶到 header 下沿，消除白条 */
    margin-left: calc(50% - 50vw);     /* 满屏出血：左右延伸到视口边缘 */
    margin-right: calc(50% - 50vw);
    padding: 56px 24px 48px;
  }
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    background: #fff;
    pointer-events: none;
  }
  .hero-blob-a { right: -40px; top: -40px; width: 220px; height: 220px; opacity: 0.5; }
  .hero-blob-b { right: 80px; bottom: -64px; width: 140px; height: 140px; opacity: 0.35; }
  .hero-inner { position: relative; max-width: calc(var(--content-width) - 48px); margin: 0 auto; }
  .hero-title { margin: 0 0 12px; font-size: 30px; font-weight: 600; letter-spacing: -0.01em; }
  .hero-sub { margin: 0 0 22px; max-width: 560px; color: var(--muted); line-height: 1.7; }
  .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn {
    display: inline-block;
    padding: 6px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
    color: var(--muted);
    font-size: 13px;
    text-decoration: none;
  }
  .btn:hover { text-decoration: none; border-color: #cfd4da; }
  .btn-primary { background: var(--fg); border-color: var(--fg); color: #fff; }
  .btn-primary:hover { background: #33383d; border-color: #33383d; }

  /* 分类导航卡 */
  .cat-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .cat-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--tint, #fff);
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .cat-card:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06); border-color: #cfd4da; }
  .cat-card.is-active { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(24, 95, 165, 0.15); }
  .cat-name { font-size: 15px; font-weight: 600; color: var(--fg); }
  .cat-count { font-size: 12px; color: var(--muted); background: rgba(255, 255, 255, 0.7); border-radius: 999px; padding: 1px 8px; }

  /* 关于本站 */
  .about-block {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 22px;
  }
  .about-text { margin: 0 0 16px; color: var(--muted); line-height: 1.8; font-size: 14px; }
  .about-actions { display: flex; gap: 10px; flex-wrap: wrap; }

  /* 热门标签 */
  .tag-pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
  }
  .tag-pill:hover { border-color: #cfd4da; color: var(--fg); }
  .tag-pill.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .pill-count { font-size: 11px; opacity: 0.7; }

  .block { margin: 28px 0; }
  .block-title { margin: 0 0 12px; font-size: 12px; font-weight: 400; color: #9aa1a9; letter-spacing: 0.04em; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .card[hidden] { display: none; }
  .card-featured { border-color: #d7dce1; }
  .card-media { aspect-ratio: 16 / 7; background: #f2f4f6; }
  .card-media-sm { aspect-ratio: 16 / 9; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-body { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; flex: 1; }
  .card-title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.4; }
  .card-featured .card-title { font-size: 18px; }
  .card-title a { color: var(--fg); }
  .card-excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 6px;
    color: #9aa1a9;
    font-size: 12px;
  }
  .tag { padding: 2px 8px; border-radius: 6px; background: #eef3f8; color: #185fa5; }
  .tag-plain { background: #f2f4f6; color: #6b7280; }
  .empty { color: var(--muted); padding: 32px 0; text-align: center; }
  .empty[hidden] { display: none; }

  @media (max-width: 640px) {
    .hero { margin-top: -20px; padding: 32px 16px; }
    .hero-inner { padding: 0; }
    .hero-title { font-size: 22px; }
    .hero-blob-a { width: 120px; height: 120px; right: -30px; top: -30px; }
    .hero-blob-b { display: none; }
    .grid { grid-template-columns: minmax(0, 1fr); }
    .cat-cards { grid-template-columns: repeat(2, 1fr); }
    .cat-name { font-size: 14px; }
  }
</style>
