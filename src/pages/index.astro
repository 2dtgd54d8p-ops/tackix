---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Base from '../layouts/Base.astro';
import { loadSiteData, loadContent } from '../lib/site-data';
import { organizationSchema } from '../lib/schema';
import { getLocale, pickB, type Locale } from '../lib/i18n';

const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocale(Astro);
const lp = locale === 'en' ? '/en' : '';
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);

const reader = createReader(process.cwd(), keystaticConfig);

// 场景方案 & 知识库文章（已发布）。
let scenarioSlugs: string[] = [];
let knowledgeSlugs: string[] = [];
try {
  scenarioSlugs = await reader.collections.scenarios.list();
} catch (e) {
  console.warn('[build] scenarios list failed（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
}
try {
  knowledgeSlugs = await reader.collections.knowledge.list();
} catch (e) {
  console.warn('[build] knowledge list failed（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
}

const scenarios = (
  await Promise.all(
    scenarioSlugs.map(async (slug) => {
      try {
        const s = await reader.collections.scenarios.read(slug);
        return s ? { slug, ...s } : null;
      } catch (e) {
        console.warn('[build] 读取场景失败：', slug, e);
        return null;
      }
    })
  )
).filter((s) => s && s.published !== false);

const knowledge = (
  await Promise.all(
    knowledgeSlugs.map(async (slug) => {
      try {
        const p = await reader.collections.knowledge.read(slug);
        return p ? { slug, ...p } : null;
      } catch (e) {
        console.warn('[build] 读取文章失败：', slug, e);
        return null;
      }
    })
  )
).filter((p) => p && p.published !== false);

// 估算阅读时长（英文约 200 词/分钟）
function readingMinutes(body: unknown): number {
  if (!body || typeof body !== 'string') return 1;
  const words = (body.match(/[a-zA-Z0-9]+/g) || []).length;
  return Math.max(1, Math.ceil(words / 200));
}

const withMeta = knowledge.map((p) => ({ ...p, readMin: readingMinutes(pickB(locale, p.body)) }));
// 按发布日期倒序
withMeta.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

// 首页场景卡：优先展示后台「首页显示」勾选的，不足 4 个则用前几条补齐
const featuredScenarios = scenarios.filter((s) => s.featured);
const homeScenarios = (featuredScenarios.length ? featuredScenarios : scenarios).slice(0, 4);
// 首页知识卡：最新 6 篇
const latestKnowledge = withMeta.slice(0, 6);

// 站点信息 & 全站文案
const { site: siteInfo, categories, categoryLabel, tagLabel, tags } = await loadSiteData(locale);
const L = await loadContent(locale);
const home = L.home;

// 参考站签名四色，依索引轮换（纯色，供 color-mix 使用）
const SOL_COLORS = ['#7c4df0', '#18a06a', '#f0883e', '#3a7bff', '#e0457b', '#12a0c9'];

// Keystatic 图片字段可能返回文件名或带前缀的路径，统一归一成可访问的 URL
function coverSrc(cover: unknown): string {
  if (!cover || typeof cover !== 'string') return '';
  return cover.startsWith('/') ? cover : `/uploads/${cover}`;
}

// 结构化数据：首页文章列表（ItemList），利于搜索引擎/Ai 理解
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: latestKnowledge.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`${lp}/knowledge/${p.slug}`, Astro.site ?? Astro.url).toString(),
    name: pickB(locale, p.name),
  })),
};
// 组织实体（含 ContactPoint），强化 E-E-A-T 与「公司实体」识别
const orgLd = {
  '@context': 'https://schema.org',
  ...organizationSchema(locale, siteInfo, Astro.site ?? Astro.url),
};
---

  <Base
    description={siteInfo.description || t('Tackix 是面向海外承包商、安装商与 DIY 用户的场景化工业胶粘剂与密封剂选型知识平台。', 'Scenario-based industrial adhesive & sealant selection guides for contractors, installers and DIY users.')}
  >
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="hero-eyebrow">{home.heroEyebrow}</span>
      <h1 class="hero-title">{siteInfo.title}</h1>
      <p class="hero-sub">
        {siteInfo.tagline || 'Pick the right adhesive for the job — with scenario-based guides and direct inquiry.'}
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href="#solutions">{home.heroCta1}</a>
        <a class="btn btn-outline-light" href={`${lp}/contact`}>{home.heroCta2}</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><strong>{scenarios.length}</strong><span>{t('场景方案', 'Scenario solutions')}</span></div>
        <div class="stat"><strong>{knowledge.length}</strong><span>{t('知识文章', 'Knowledge articles')}</span></div>
        <div class="stat"><strong>{categories.length}</strong><span>{t('分类', 'Categories')}</span></div>
        <div class="stat"><strong>{tags.length}</strong><span>{t('主题', 'Topics')}</span></div>
      </div>
    </div>
  </section>

  {/* 场景方案引导区 —— 串联 场景 → 知识库 → 询盘 内链闭环 */}
  <section class="block" id="solutions">
    <div class="section-head">
      <h2>{home.scenariosTitle}</h2>
      <p>{home.scenariosSub}</p>
    </div>
    {
      homeScenarios.length === 0 ? (
        <p class="empty">{t('暂无场景方案，请在后台创建第一篇。', 'No scenario solutions yet — create the first one in the CMS.')}</p>
      ) : (
        <div class="sol-cards">
          {homeScenarios.map((s, i) => (
            <a class="sol-card" href={`${lp}/solutions/${s.slug}`}>
              <span class="sol-icon" style={`--sol:${SOL_COLORS[i % SOL_COLORS.length]}`} aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1.6" fill="currentColor" /></svg>
              </span>
              <h3>{pickB(locale, s.name)}</h3>
              {s.excerpt && <p>{pickB(locale, s.excerpt)}</p>}
              <span class="sol-cta">{t('查看方案', 'Read the solution')} →</span>
            </a>
          ))}
        </div>
      )
    }
    <div class="section-more">
      <a class="btn btn-outline" href={`${lp}/solutions`}>{t('浏览全部场景方案', 'Browse all scenario solutions')} →</a>
    </div>
  </section>

  {/* 最新知识库文章 */}
  {
    knowledge.length === 0 ? (
      <p class="empty">{t('暂无文章，请在后台创建第一篇。', 'No articles yet — create the first one in the CMS.')}</p>
    ) : (
      <section class="block" id="latest">
        <div class="section-head">
          <h2>{home.knowledgeTitle}</h2>
          <p>{home.knowledgeSub}</p>
        </div>
        <div class="grid">
          {latestKnowledge.map((post) => (
            <article class="card" data-category={post.category ?? 'uncategorized'}>
              {coverSrc(post.cover) && (
                <div class="card-media card-media-sm">
                  <img src={coverSrc(post.cover)} alt="" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <h3 class="card-title">
                  <a href={`${lp}/knowledge/${post.slug}`}>{pickB(locale, post.name)}</a>
                </h3>
                {post.excerpt && <p class="card-excerpt">{pickB(locale, post.excerpt)}</p>}
                <div class="card-meta">
                  <span class="tag">{categoryLabel(post.category)}</span>
                  {(post.tags ?? []).slice(0, 2).map((t: string) => (
                    <span class="tag tag-plain">{tagLabel(t)}</span>
                  ))}
                  {post.publishedAt && <span>{post.publishedAt}</span>}
                  <span class="read-time">· {post.readMin}{t(' 分钟阅读', ' min read')}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="section-more">
          <a class="btn btn-outline" href={`${lp}/knowledge`}>{t('浏览全部文章', 'Browse all articles')} →</a>
        </div>
      </section>
    )
  }

  {/* 信任带：认证徽章 + 一句话（来自后台「站点信息」trust / certBadges） */}
  {
    (siteInfo.trustTitle || siteInfo.trustSub || (siteInfo.certBadges?.length ?? 0) > 0) && (
      <section class="trust">
        <div class="trust-inner">
          {siteInfo.trustTitle && <h2>{siteInfo.trustTitle}</h2>}
          {siteInfo.trustSub && <p>{siteInfo.trustSub}</p>}
          {(siteInfo.certBadges?.length ?? 0) > 0 && (
            <div class="badges">
              {siteInfo.certBadges.map((b) => (
                <div class="badge">
                  <span class="badge-label">{b.label}</span>
                  {b.note && <span class="badge-note">{b.note}</span>}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* 关于本站 + 询盘闭环：引导从内容走向联系页 */}
  <section class="band">
    <div class="band-inner">
      <div class="section-head">
        <h2>{home.bandTitle}</h2>
        <p>{home.bandSub}</p>
      </div>
      <div class="band-actions">
        <a class="btn btn-primary" href={`${lp}/contact`}>{home.bandCta1}</a>
        <a class="btn" href={`${lp}/knowledge`}>{home.bandCta2}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero：大尺度 + 点阵纹理 + 双光晕，营造大气感 ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-grad);
    color: #fff;
    text-align: center;
    margin-top: -44px;                 /* 顶到 header 下沿 */
    margin-left: calc(50% - 50vw);     /* 满屏出血 */
    margin-right: calc(50% - 50vw);
    padding: 128px 24px 132px;
  }
  /* 点阵纹理：增加背景层次与质感 */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 32%, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 32%, #000 38%, transparent 100%);
    pointer-events: none;
  }
  .hero-glow {
    position: absolute;
    left: 50%;
    top: -230px;
    width: 900px;
    height: 900px;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.2), transparent 62%);
    pointer-events: none;
  }
  /* 右下角辅助光晕，丰富纵深 */
  .hero::after {
    content: "";
    position: absolute;
    right: -180px;
    bottom: -260px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.14), transparent 62%);
    pointer-events: none;
  }
  .hero-inner { position: relative; max-width: 900px; margin: 0 auto; }
  .hero-eyebrow {
    display: inline-block;
    margin-bottom: 22px;
    padding: 7px 18px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r-pill);
    font-size: 13.5px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-title {
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.22);
  }
  .hero-sub {
    margin: 0 auto 36px;
    max-width: 640px;
    font-size: 18px;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.86);
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .hero .btn { padding: 14px 32px; font-size: 15.5px; font-weight: 600; }
  /* 数据条：以权威数字增强大气与信任感 */
  .hero-stats {
    display: flex;
    gap: 36px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 56px;
    padding-top: 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .hero-stats .stat { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hero-stats span { font-size: 13px; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.72); }

  /* ---------- 版块 ---------- */
  .block { margin: 92px 0; }
  .section-head { margin-bottom: 42px; }
  .section-head h2 { font-size: clamp(1.7rem, 3vw, 2.15rem); line-height: 1.25; }
  .section-more { text-align: center; margin-top: 34px; }

  /* 场景方案卡片 */
  .sol-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  .sol-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--fg-soft);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .sol-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
    text-decoration: none;
  }
  .sol-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--sol, var(--accent)) 16%, transparent);
    color: var(--sol, var(--accent));
    margin-bottom: 4px;
  }
  .sol-card h3 { margin: 0; font-size: 20px; font-weight: 700; color: var(--fg); }
  .sol-card p { margin: 0; font-size: 14.5px; color: var(--muted); line-height: 1.7; }
  .sol-cta {
    margin-top: auto;
    padding-top: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    transition: gap var(--dur) var(--ease);
  }
  .sol-card:hover .sol-cta { gap: 10px; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }

  /* 信任带 */
  .trust {
    background: var(--band);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 64px calc(50% - 50vw) 0;
    padding: 64px 24px;
  }
  .trust-inner { max-width: 880px; margin: 0 auto; text-align: center; }
  .trust-inner h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); margin: 0 0 12px; }
  .trust-inner p { font-size: 16px; color: var(--muted); line-height: 1.8; margin: 0 0 28px; }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }
  .badge {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 22px;
    min-width: 140px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .badge-label { font-size: 15px; font-weight: 700; color: var(--fg); }
  .badge-note { font-size: 12.5px; color: var(--faint); line-height: 1.5; }

  /* 关于本站：整幅色带 */
  .band {
    background: var(--band);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin: 64px calc(50% - 50vw) 0;
    padding: 64px 24px;
  }
  .band-inner { max-width: 720px; margin: 0 auto; }
  .band-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

  @media (max-width: 700px) {
    .hero { margin-top: -24px; padding: 84px 18px 88px; }
    .hero-title { font-size: 32px; }
    .hero-sub { font-size: 16px; }
    .hero-stats { gap: 22px; margin-top: 40px; padding-top: 26px; }
    .hero-stats strong { font-size: 26px; }
    .block { margin: 56px 0; }
    .trust { margin-top: 56px; padding: 56px 18px; }
    .band { margin-top: 56px; padding: 56px 18px; }
    .grid { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  }
</style>
