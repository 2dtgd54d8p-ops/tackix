---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Base from '../layouts/Base.astro';
import { loadSiteData, loadContent } from '../lib/site-data';
import { organizationSchema } from '../lib/schema';
import { getLocale, pickB, type Locale } from '../lib/i18n';

const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocale(Astro);
const lp = locale === 'en' ? '/en' : '';
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);

const reader = createReader(process.cwd(), keystaticConfig);

// 场景方案 & 知识库文章（已发布）。
let scenarioSlugs: string[] = [];
let knowledgeSlugs: string[] = [];
try {
  scenarioSlugs = await reader.collections.scenarios.list();
} catch (e) {
  console.warn('[build] scenarios list failed（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
}
try {
  knowledgeSlugs = await reader.collections.knowledge.list();
} catch (e) {
  console.warn('[build] knowledge list failed（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
}

const scenarios = (
  await Promise.all(
    scenarioSlugs.map(async (slug) => {
      try {
        const s = await reader.collections.scenarios.read(slug);
        return s ? { slug, ...s } : null;
      } catch (e) {
        console.warn('[build] 读取场景失败：', slug, e);
        return null;
      }
    })
  )
).filter((s) => s && s.published !== false);

const knowledge = (
  await Promise.all(
    knowledgeSlugs.map(async (slug) => {
      try {
        const p = await reader.collections.knowledge.read(slug);
        return p ? { slug, ...p } : null;
      } catch (e) {
        console.warn('[build] 读取文章失败：', slug, e);
        return null;
      }
    })
  )
).filter((p) => p && p.published !== false);

// 估算阅读时长（英文约 200 词/分钟）
function readingMinutes(body: unknown): number {
  if (!body || typeof body !== 'string') return 1;
  const words = (body.match(/[a-zA-Z0-9]+/g) || []).length;
  return Math.max(1, Math.ceil(words / 200));
}

const withMeta = knowledge.map((p) => ({ ...p, readMin: readingMinutes(pickB(locale, p.body)) }));
// 按发布日期倒序
withMeta.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

// 首页场景卡：展示「全部」场景（featured 仅置于最前，不做裁剪）——确保所有分类都呈现
const homeScenarios = scenarios
  .slice()
  .sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));
// 首页知识卡：最新 6 篇
const latestKnowledge = withMeta.slice(0, 6);

// 每个场景下的文章数（展示在卡片上）
const countByScenario = new Map<string, number>();
for (const p of knowledge) {
  const sc = (p.scenario as string) || 'none';
  if (sc !== 'none') countByScenario.set(sc, (countByScenario.get(sc) ?? 0) + 1);
}

// 站点信息 & 全站文案
const { site: siteInfo, categories, categoryLabel, tagLabel, tags } = await loadSiteData(locale);
const L = await loadContent(locale);
const home = L.home;

// 首页「猜你喜欢」推荐索引（L1）：构建期产出轻量 JSON，前端按浏览记录实时算推荐。
// 含本地化后的分类/标签文字，避免前端再查词典；tags/scenario 用于相似度打分。
const recIndex = withMeta.map((p) => ({
  slug: p.slug,
  url: `${lp}/knowledge/${p.slug}`,
  name: pickB(locale, p.name),
  excerpt: pickB(locale, p.excerpt),
  catLabel: categoryLabel(p.category),
  tagLabels: (p.tags ?? []).slice(0, 2).map((tg: string) => tagLabel(tg)),
  scenario: (p.scenario as string) || 'none',
  tags: (p.tags ?? []).map(String),
  cover: coverSrc(p.cover),
  readMin: p.readMin,
}));

// 场景主题色与语义图标（首页与案例库共用，单一来源见 src/lib/scenario-visual.ts）
import { sColor, sIcon } from '../lib/scenario-visual';

// Keystatic 图片字段可能返回文件名或带前缀的路径，统一归一成可访问的 URL
function coverSrc(cover: unknown): string {
  if (!cover || typeof cover !== 'string') return '';
  return cover.startsWith('/') ? cover : `/uploads/${cover}`;
}

// 结构化数据：首页文章列表（ItemList），利于搜索引擎/Ai 理解
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: latestKnowledge.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`${lp}/knowledge/${p.slug}`, Astro.site ?? Astro.url).toString(),
    name: pickB(locale, p.name),
  })),
};
// 组织实体（含 ContactPoint），强化 E-E-A-T 与「公司实体」识别
const orgLd = {
  '@context': 'https://schema.org',
  ...organizationSchema(locale, siteInfo, Astro.site ?? Astro.url),
};
---

  <Base
    description={siteInfo.description || t('Tackix 是面向海外承包商、安装商与 DIY 用户的场景化工业胶粘剂与密封剂选型知识平台。', 'Scenario-based industrial adhesive & sealant selection guides for contractors, installers and DIY users.')}
  >
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="hero-eyebrow">{home.heroEyebrow}</span>
      <h1 class="hero-title">{siteInfo.title}</h1>
      <p class="hero-sub">
        {siteInfo.tagline || 'Pick the right adhesive for the job — with scenario-based guides and direct inquiry.'}
      </p>
      <div class="hero-actions">
        <a class="btn btn-light" href="#solutions">{home.heroCta1}</a>
        <a class="btn btn-outline-light" href={`${lp}/contact`}>{home.heroCta2}</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><strong>{scenarios.length}</strong><span>{t('场景方案', 'Scenario solutions')}</span></div>
        <div class="stat"><strong>{knowledge.length}</strong><span>{t('知识文章', 'Knowledge articles')}</span></div>
        <div class="stat"><strong>{categories.length}</strong><span>{t('分类', 'Categories')}</span></div>
        <div class="stat"><strong>{tags.length}</strong><span>{t('主题', 'Topics')}</span></div>
      </div>
    </div>
  </section>

  {/* 场景方案引导区 —— 串联 场景 → 知识库 → 询盘 内链闭环 */}
  <section class="block" id="solutions">
    <div class="section-head">
      <h2>{home.scenariosTitle}</h2>
      <p>{home.scenariosSub}</p>
    </div>
    {
      homeScenarios.length === 0 ? (
        <p class="empty">{t('暂无场景方案，请在后台创建第一篇。', 'No scenario solutions yet — create the first one in the CMS.')}</p>
      ) : (
        <div class="sol-cards">
          {homeScenarios.map((s, i) => (
            <a class="sol-card" href={`${lp}/solutions/${s.slug}`} style={`--sol:${sColor(s.slug, i)}`}>
              <span class="sol-top" aria-hidden="true" />
              <span class="sol-glow" aria-hidden="true" />
              <div class="sol-content">
                <div class="sol-head">
                  <span class="sol-icon" aria-hidden="true" set:html={sIcon(s.slug)} />
                  {(countByScenario.get(s.slug) ?? 0) > 0 && (
                    <span class="sol-count">
                      {countByScenario.get(s.slug)}
                      {t(' 篇', ' articles')}
                    </span>
                  )}
                </div>
                <h3>{pickB(locale, s.name)}</h3>
                {s.excerpt && <p>{pickB(locale, s.excerpt)}</p>}
                <span class="sol-cta">
                  {t('查看方案', 'Read the solution')}
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )
    }
    <div class="section-more">
      <a class="btn btn-outline" href={`${lp}/solutions`}>{t('浏览全部场景方案', 'Browse all scenario solutions')} →</a>
    </div>
  </section>

  {/* 最新知识库文章 */}
  {
    knowledge.length === 0 ? (
      <p class="empty">{t('暂无文章，请在后台创建第一篇。', 'No articles yet — create the first one in the CMS.')}</p>
    ) : (
      <section class="block" id="latest">
        <div class="section-head">
          <h2>{home.knowledgeTitle}</h2>
          <p>{home.knowledgeSub}</p>
        </div>
        <div class="grid">
          {latestKnowledge.map((post) => (
            <article class="card" data-category={post.category ?? 'uncategorized'}>
              {coverSrc(post.cover) && (
                <div class="card-media card-media-sm">
                  <img src={coverSrc(post.cover)} alt="" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <h3 class="card-title">
                  <a href={`${lp}/knowledge/${post.slug}`}>{pickB(locale, post.name)}</a>
                </h3>
                {post.excerpt && <p class="card-excerpt">{pickB(locale, post.excerpt)}</p>}
                <div class="card-meta">
                  <span class="tag">{categoryLabel(post.category)}</span>
                  {(post.tags ?? []).slice(0, 2).map((t: string) => (
                    <span class="tag tag-plain">{tagLabel(t)}</span>
                  ))}
                  {post.publishedAt && <span>{post.publishedAt}</span>}
                  <span class="read-time">· {post.readMin}{t(' 分钟阅读', ' min read')}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="section-more">
          <a class="btn btn-outline" href={`${lp}/knowledge`}>{t('浏览全部文章', 'Browse all articles')} →</a>
        </div>
      </section>
    )
  }

  {/* L1 猜你喜欢：服务端先渲染「最新 4 篇」做无 JS/首屏兜底，前端按浏览记录升级为个性化推荐 */}
  {
    knowledge.length === 0 ? null : (
      <section class="block" id="foryou">
        <div class="section-head">
          <h2>{t('猜你喜欢', 'Recommended for you')}</h2>
          <p>{t('基于你读过的文章智能推荐 · 仅保存在本机', 'Personalized from your reading history · stored only on this device')}</p>
        </div>
        <div class="grid" id="foryou-grid">
          {latestKnowledge.slice(0, 4).map((post) => (
            <article class="card">
              {coverSrc(post.cover) && (
                <div class="card-media card-media-sm">
                  <img src={coverSrc(post.cover)} alt="" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <h3 class="card-title">
                  <a href={`${lp}/knowledge/${post.slug}`}>{pickB(locale, post.name)}</a>
                </h3>
                {post.excerpt && <p class="card-excerpt">{pickB(locale, post.excerpt)}</p>}
                <div class="card-meta">
                  <span class="tag">{categoryLabel(post.category)}</span>
                  {(post.tags ?? []).slice(0, 2).map((tag: string) => (
                    <span class="tag tag-plain">{tagLabel(tag)}</span>
                  ))}
                  <span class="read-time">· {post.readMin}{t(' 分钟阅读', ' min read')}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {/* 信任带：认证徽章 + 一句话（来自后台「站点信息」trust / certBadges） */}
  {
    (siteInfo.trustTitle || siteInfo.trustSub || (siteInfo.certBadges?.length ?? 0) > 0) && (
      <section class="trust">
        <div class="trust-inner">
          {siteInfo.trustTitle && <h2>{siteInfo.trustTitle}</h2>}
          {siteInfo.trustSub && <p>{siteInfo.trustSub}</p>}
          {(siteInfo.certBadges?.length ?? 0) > 0 && (
            <div class="badges">
              {siteInfo.certBadges.map((b) => (
                <div class="badge">
                  <span class="badge-label">{b.label}</span>
                  {b.note && <span class="badge-note">{b.note}</span>}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* 关于本站 + 询盘闭环：引导从内容走向联系页 */}
  <section class="band">
    <div class="band-inner">
      <div class="section-head">
        <h2>{home.bandTitle}</h2>
        <p>{home.bandSub}</p>
      </div>
      <div class="band-actions">
        <a class="btn btn-primary" href={`${lp}/contact`}>{home.bandCta1}</a>
        <a class="btn" href={`${lp}/knowledge`}>{home.bandCta2}</a>
      </div>
    </div>
  </section>

  {/* L5 订阅：邮箱捕获，POST /api/subscribe（CF KV 绑定后持久化，缺失则前端乐观降级） */}
  <section class="subscribe" id="subscribe">
    <div class="sub-inner">
      <h2>{t('订阅选型与产品更新', 'Subscribe to selection & product updates')}</h2>
      <p>{t('留下邮箱，新场景方案与产品资料上线时第一时间通知你。', 'Drop your email to get notified when new scenario solutions and product docs go live.')}</p>
      <form id="sub-form" class="sub-form" novalidate>
        <input
          id="sub-email"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder={t('你的邮箱', 'your@email.com')}
        />
        <button type="submit" class="btn btn-primary" id="sub-btn">{t('订阅', 'Subscribe')}</button>
      </form>
      <p class="sub-msg" id="sub-msg" hidden></p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var form = document.getElementById('sub-form');
      if (!form) return;
      var email = document.getElementById('sub-email');
      var msg = document.getElementById('sub-msg');
      var btn = document.getElementById('sub-btn');
      var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var v = (email.value || '').trim();
        if (!emailRe.test(v)) {
          msg.hidden = false;
          msg.textContent = document.documentElement.lang === 'en' ? 'Please enter a valid email.' : '请输入有效邮箱';
          msg.className = 'sub-msg sub-err';
          return;
        }
        btn.disabled = true;
        fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: v, lang: document.documentElement.lang }),
        })
          .catch(function () { /* 后端缺失也乐观视为成功 */ })
          .finally(function () {
            msg.hidden = false;
            msg.textContent = document.documentElement.lang === 'en' ? 'Subscribed — thank you!' : '已订阅，谢谢！';
            msg.className = 'sub-msg sub-ok';
            email.value = '';
            btn.disabled = false;
          });
      });
    })();
  </script>

  {/* L1 推荐引擎：读取本机浏览记录，按「同场景 +10 / 每共享标签 +2」打分，实时替换网格 */}
  <script type="application/json" id="rec-index" set:html={JSON.stringify(recIndex)}></script>
  <script is:inline>
    (function () {
      var grid = document.getElementById('foryou-grid');
      var dataEl = document.getElementById('rec-index');
      if (!grid || !dataEl) return;
      var index;
      try { index = JSON.parse(dataEl.textContent || '[]'); } catch (e) { return; }
      if (!index.length) return;

      function getViewed() {
        try { return JSON.parse(localStorage.getItem('tackix_viewed') || '[]'); }
        catch (e) { return []; }
      }
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
        });
      }
      function cardHTML(a) {
        var html = '<article class="card">';
        if (a.cover) html += '<div class="card-media card-media-sm"><img src="' + esc(a.cover) + '" alt="" loading="lazy"></div>';
        html += '<div class="card-body">';
        html += '<h3 class="card-title"><a href="' + esc(a.url) + '">' + esc(a.name) + '</a></h3>';
        if (a.excerpt) html += '<p class="card-excerpt">' + esc(a.excerpt) + '</p>';
        html += '<div class="card-meta">';
        if (a.catLabel) html += '<span class="tag">' + esc(a.catLabel) + '</span>';
        (a.tagLabels || []).forEach(function (tg) { html += '<span class="tag tag-plain">' + esc(tg) + '</span>'; });
        if (a.readMin) html += '<span class="read-time">· ' + esc(a.readMin) + ' min</span>';
        html += '</div></div></article>';
        return html;
      }
      function recommend(viewed, n) {
        var vset = new Set(viewed);
        if (!vset.size) return index.slice(0, n);
        var viewedArticles = index.filter(function (a) { return vset.has(a.slug); });
        var scored = index.filter(function (a) { return !vset.has(a.slug); }).map(function (a) {
          var score = 0;
          viewedArticles.forEach(function (v) {
            if (v.scenario && v.scenario !== 'none' && v.scenario === a.scenario) score += 10;
            (v.tags || []).forEach(function (t) { if ((a.tags || []).indexOf(t) >= 0) score += 2; });
          });
          return { a: a, score: score };
        });
        scored.sort(function (x, y) { return y.score - x.score; });
        var top = scored.filter(function (x) { return x.score > 0; }).map(function (x) { return x.a; });
        if (top.length < n) {
          var rest = index.filter(function (a) { return !vset.has(a.slug) && top.indexOf(a) < 0; });
          top = top.concat(rest).slice(0, n);
        }
        return top.slice(0, n);
      }

      try {
        var viewed = getViewed();
        if (viewed.length) {
          var recs = recommend(viewed, 4);
          if (recs.length) grid.innerHTML = recs.map(cardHTML).join('');
        }
      } catch (e) { /* 无痕模式等：保留服务端兜底 */ }
    })();
  </script>

<style>
  /* ---------- Hero：满屏实景大图 + 左锚定编辑式排版，营造大气感 ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background-color: #18122e;
    background-image: url('/uploads/hero-technician.png');
    background-size: cover;
    background-position: 70% center;     /* 主体（技师）落在右侧，左侧留白放文字 */
    color: #fff;
    text-align: left;
    margin-top: -44px;                    /* 顶到 header 下沿 */
    margin-left: calc(50% - 50vw);        /* 满屏出血 */
    margin-right: calc(50% - 50vw);
    padding: 140px 0 144px;
  }
  /* 左侧深色蒙版：保证文字可读，同时保留右侧实景 */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(100deg, rgba(16,10,34,0.94) 0%, rgba(16,10,34,0.82) 34%, rgba(16,10,34,0.42) 64%, rgba(16,10,34,0.22) 100%),
      radial-gradient(130% 120% at 82% 18%, transparent 42%, rgba(8,5,18,0.55) 100%);
    pointer-events: none;
    z-index: 0;
  }
  /* 左上品牌光晕，增加纵深 */
  .hero-glow {
    position: absolute;
    left: -120px;
    top: -260px;
    width: 760px;
    height: 760px;
    background: radial-gradient(circle, rgba(124, 77, 240, 0.42), transparent 62%);
    pointer-events: none;
    z-index: 0;
  }
  /* 右下角辅助光晕，丰富纵深 */
  .hero::after {
    content: "";
    position: absolute;
    right: -180px;
    bottom: -260px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.12), transparent 62%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;   /* 与 .container 左右内边距一致，使 Hero 文字与下方内容左缘对齐 */
  }
  .hero-eyebrow {
    display: inline-block;
    margin-bottom: 22px;
    padding: 7px 18px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r-pill);
    font-size: 13.5px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-title {
    margin: 0 0 22px;
    max-width: 16ch;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }
  .hero-sub {
    margin: 0 0 36px;
    max-width: 600px;
    font-size: 19px;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.88);
  }
  .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; justify-content: flex-start; }
  .hero .btn { padding: 15px 34px; font-size: 15.5px; font-weight: 600; }
  /* 数据条：以权威数字增强大气与信任感 */
  .hero-stats {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-top: 60px;
    padding-top: 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .hero-stats .stat { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hero-stats span { font-size: 13px; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.72); }

  /* ---------- 版块 ---------- */
