---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import Base from '../layouts/Base.astro';
import { loadSiteData, buildFilterOptions } from '../lib/site-data';

const reader = createReader(process.cwd(), keystaticConfig);
let slugs = [];
try {
  slugs = await reader.collections.posts.list();
} catch (e) {
  console.warn('[build] 读取文章列表失败（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
}

const posts = (await Promise.all(
  slugs.map(async (slug) => {
    try {
      const post = await reader.collections.posts.read(slug);
      return post ? { slug, ...post } : null;
    } catch (e) {
      console.warn('[build] 读取文章失败：', slug, e);
      return null;
    }
  })
)).filter((p) => p && p.published !== false); // 仅展示已发布

// 估算阅读时长：中文约 400 字/分钟，英文约 200 词/分钟
function readingMinutes(body) {
  if (!body || typeof body !== 'string') return 1;
  const cjk = (body.match(/[一-龥]/g) || []).length;
  const words = (body.replace(/[一-龥]/g, ' ').match(/[a-zA-Z0-9]+/g) || []).length;
  return Math.max(1, Math.ceil(cjk / 400 + words / 200));
}

// 给每篇补上阅读时长，供卡片展示与排序使用
const withMeta = posts.map((p) => ({ ...p, readMin: readingMinutes(p.body) }));

// 按发布日期倒序
withMeta.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

// 置顶（后台勾选「首页置顶」）单独抽出来做大卡片；同一篇只出现一次
const featured = withMeta.find((p) => p.featured);
const rest = withMeta.filter((p) => p.slug !== featured?.slug);

// 分类/标签/站点信息统一从公共模块读取（后台可增删改），读不到自动回落默认值
const { site: siteInfo, categories: managedCategories, categoryLabel, tagLabel, tags } =
  await loadSiteData();

// T11：首页新增「解决方案」引导区，串联 文章→产品→案例→询盘 内链闭环，
// 卡片展示真实条目数（来自后台集合），锚文本使用描述性文案以利 SEO 内部链接。
let productSlugs = [];
let caseSlugs = [];
try { productSlugs = await reader.collections.products.list(); } catch (e) {}
try { caseSlugs = await reader.collections.cases.list(); } catch (e) {}
const productCount = productSlugs.length;
const caseCount = caseSlugs.length;

// 只列出实际有文章的分类/标签，避免出现点进去是空的筛选项
const categories = buildFilterOptions(withMeta, managedCategories);
const usedTags = tags.filter((t) => withMeta.some((p) => (p.tags ?? []).includes(t.value)));

// 计数基于网格实际展示的 rest，避免筛选后数量对不上
const catCounts = {};
rest.forEach((p) => {
  const k = p.category ?? 'uncategorized';
  catCounts[k] = (catCounts[k] ?? 0) + 1;
});
const tagCounts = {};
rest.forEach((p) => (p.tags ?? []).forEach((t) => { tagCounts[t] = (tagCounts[t] ?? 0) + 1; }));

// 参考站签名四色渐变，依索引轮换
const TILE_GRADS = [
  'linear-gradient(135deg, #1ec8c8, #12a0c9)',
  'linear-gradient(135deg, #f6a63c, #f2792f)',
  'linear-gradient(135deg, #9b5cf5, #6f2fe0)',
  'linear-gradient(135deg, #4f9bf5, #3d6ee8)',
  'linear-gradient(135deg, #26c281, #12a150)',
  'linear-gradient(135deg, #f2668b, #d63f6f)',
];
const categoryCards = categories.map((c, i) => ({
  ...c,
  count: c.value === 'all' ? rest.length : (catCounts[c.value] ?? 0),
  grad: TILE_GRADS[i % TILE_GRADS.length],
}));
const tagCards = usedTags.map((t) => ({ ...t, count: tagCounts[t.value] ?? 0 }));

// 结构化数据：首页文章列表（ItemList），利于搜索引擎理解
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: rest.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`/posts/${p.slug}`, Astro.site ?? Astro.url).toString(),
    name: p.title,
  })),
};
---

<Base
  title="首页"
  description={siteInfo.description || `${siteInfo.title} —— 记录技术、实践与思考的独立空间。`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-inner">
      <span class="hero-eyebrow">工业胶粘剂与密封剂 · 选型 · 技术 · 询盘</span>
      <h1 class="hero-title">{siteInfo.title}</h1>
      <p class="hero-sub">{siteInfo.tagline || '面向工业胶粘剂与密封剂行业的垂直平台：产品数据库、在线选型、技术文章与客户案例，支持多语言与在线询盘。'}</p>
      <div class="hero-actions">
        <a class="btn btn-light" href="#solutions">探索解决方案</a>
        <a class="btn btn-outline-light" href="/contact">联系我们报价</a>
      </div>
    </div>
  </section>

  {/* T11：解决方案引导区 —— 串联 文章→产品→案例→询盘 内链闭环 */}
  <section class="block" id="solutions">
    <div class="section-head">
      <h2>解决方案</h2>
      <p>从产品选型到落地应用，一站式找到适合的胶粘剂方案</p>
    </div>
    <div class="sol-cards">
      <a class="sol-card" href="/products">
        <span class="sol-icon" style="--sol:#7c4df0" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" /></svg>
        </span>
        <h3>产品数据库</h3>
        <p>按化学体系、固化方式与认证筛选工业胶粘剂与密封剂，查看关键参数与文档。</p>
        <span class="sol-cta">浏览胶粘剂产品库（{productCount} 款） →</span>
      </a>
      <a class="sol-card" href="/selector">
        <span class="sol-icon" style="--sol:#18a06a" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14" /><line x1="4" y1="10" x2="4" y2="3" /><line x1="12" y1="21" x2="12" y2="12" /><line x1="12" y1="8" x2="12" y2="3" /><line x1="20" y1="21" x2="20" y2="16" /><line x1="20" y1="12" x2="20" y2="3" /><line x1="1" y1="14" x2="7" y2="14" /><line x1="9" y1="8" x2="15" y2="8" /><line x1="17" y1="16" x2="23" y2="16" /></svg>
        </span>
        <h3>选型工具</h3>
        <p>根据应用场景、固化需求与基材自动推荐匹配的胶型，快速缩小选型范围。</p>
        <span class="sol-cta">开始在线选型 →</span>
      </a>
      <a class="sol-card" href="/cases">
        <span class="sol-icon" style="--sol:#f0883e" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6m0 5h12m0 0h1.5a2.5 2.5 0 0 0 0-5H18m0 5v3a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9m0 0V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3" /><path d="M9 17l3 3 3-3" /></svg>
        </span>
        <h3>应用案例</h3>
        <p>看同行如何在新能源、电子、汽车等场景落地胶粘剂方案与选型结果。</p>
        <span class="sol-cta">查看应用案例（{caseCount} 个） →</span>
      </a>
      <a class="sol-card" href="/contact">
        <span class="sol-icon" style="--sol:#3a7bff" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.7 9.7 0 0 1-2.8-.4L4 21l1.4-4.2A8.4 8.4 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z" /><path d="M8.5 10.4h7M8.5 13.4h4" /></svg>
        </span>
        <h3>在线询盘</h3>
        <p>提供应用场景与技术要求，获取针对性选型建议、样品与技术文档。</p>
        <span class="sol-cta">获取选型建议与报价 →</span>
      </a>
    </div>
  </section>

  {
    posts.length === 0 ? (
      <p class="empty">还没有文章，去后台创建第一篇吧。</p>
    ) : (
      <>
        {/* 浏览分类：彩色渐变瓷砖，点击筛选下方网格 */}
        <section class="block">
          <div class="section-head">
            <h2>浏览分类</h2>
            <p>按主题快速找到你感兴趣的内容</p>
          </div>
          <div class="cat-cards">
            {categoryCards.map((c, i) => (
              <button
                type="button"
                class={`tile cat-card${i === 0 ? ' is-active' : ''}`}
                data-filter={c.value}
                aria-pressed={i === 0 ? 'true' : 'false'}
                style={`--tile-grad:${c.grad}`}
              >
                <span class="tile-name">{c.label}</span>
                <span class="tile-count">{c.count} 篇</span>
              </button>
            ))}
          </div>
        </section>

        {featured && (
          <section class="block">
            <div class="section-head">
              <h2>精选推荐</h2>
              <p>值得优先一读的文章</p>
            </div>
            <article class="card card-featured">
              {featured.cover && (
                <div class="card-media">
                  <img src={featured.cover} alt="" loading="eager" />
                </div>
              )}
              <div class="card-body">
                <h3 class="card-title">
                  <a href={`/posts/${featured.slug}`}>{featured.title}</a>
                </h3>
                {featured.excerpt && <p class="card-excerpt">{featured.excerpt}</p>}
                <div class="card-meta">
                  <span class="tag">{categoryLabel(featured.category)}</span>
                  {(featured.tags ?? []).map((t) => (
                    <span class="tag tag-plain">{tagLabel(t)}</span>
                  ))}
                  {featured.publishedAt && <span>{featured.publishedAt}</span>}
                  <span class="read-time">· {featured.readMin} 分钟</span>
                </div>
              </div>
            </article>
          </section>
        )}

        <section class="block" id="latest">
          <div class="section-head">
            <h2>最新文章</h2>
            <p>持续记录，持续更新</p>
          </div>
          <div class="sort-bar" role="group" aria-label="排序方式">
            <button type="button" class="sort-btn is-active" data-sort="newest" aria-pressed="true">最新</button>
            <button type="button" class="sort-btn" data-sort="title" aria-pressed="false">标题</button>
            <span class="sort-count" data-count></span>
          </div>
          {rest.length === 0 ? (
            <p class="empty">暂无更多文章。</p>
          ) : (
            <div class="grid">
              {rest.map((post) => (
                <article
                  class="card"
                  data-category={post.category ?? 'uncategorized'}
                  data-tags={(post.tags ?? []).join(' ')}
                  data-title={post.title}
                  data-date={post.publishedAt ?? ''}
                >
                  {post.cover && (
                    <div class="card-media card-media-sm">
                      <img src={post.cover} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={`/posts/${post.slug}`}>{post.title}</a>
                    </h3>
                    {post.excerpt && <p class="card-excerpt">{post.excerpt}</p>}
                    <div class="card-meta">
                      <span class="tag">{categoryLabel(post.category)}</span>
                      {(post.tags ?? []).slice(0, 2).map((t) => (
                        <span class="tag tag-plain">{tagLabel(t)}</span>
                      ))}
                      {post.publishedAt && <span>{post.publishedAt}</span>}
                      <span class="read-time">· {post.readMin} 分钟</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
          <button type="button" class="load-more" data-loadmore hidden>加载更多</button>
          <p class="empty" data-empty hidden>该筛选下暂无文章。</p>
        </section>

        {tagCards.length > 0 && (
          <section class="block">
            <div class="section-head">
              <h2>热门标签</h2>
              <p>点击标签，查看同主题文章</p>
            </div>
            <div class="tag-pills">
              {tagCards.map((t) => (
                <button type="button" class="tag-pill" data-tagfilter={t.value} aria-pressed="false">
                  #{tagLabel(t.value)} <span class="pill-count">{t.count}</span>
                </button>
              ))}
            </div>
          </section>
        )}

        {/* 关于本站 + 询盘闭环：引导从内容/案例走向联系页 */}
        <section class="band">
          <div class="band-inner">
            <div class="section-head">
              <h2>需要选型建议？</h2>
              <p>{siteInfo.description || '面向工业胶粘剂与密封剂行业的垂直平台，提供产品、选型、技术与案例。'}</p>
            </div>
            <div class="band-actions">
              <a class="btn btn-primary" href="/contact">联系我们获取报价</a>
              <a class="btn" href="/posts">浏览技术文章</a>
            </div>
          </div>
        </section>

        <script>
          // 分类瓷砖 + 标签胶囊 + 排序 + 分页：纯前端统一处理，切换无需重新部署
          const PAGE = 6;
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const grid = document.querySelector('.grid');
          const emptyHint = document.querySelector('[data-empty]');
          const loadMoreBtn = document.querySelector('[data-loadmore]');
          const counter = document.querySelector('[data-count]');
          const cards = grid ? Array.from(grid.querySelectorAll('.card')) : [];
          const catCards = Array.from(document.querySelectorAll('.cat-card'));
          const tagPills = Array.from(document.querySelectorAll('.tag-pill'));
          const sortBtns = Array.from(document.querySelectorAll('.sort-btn'));
          const gridSection = document.getElementById('latest');

          const state = { cat: 'all', tag: '', sort: 'newest', visible: PAGE };

          function matches(card) {
            const cat = card.getAttribute('data-category');
            const tags = (card.getAttribute('data-tags') || '').split(' ').filter(Boolean);
            if (state.cat !== 'all' && cat !== state.cat) return false;
            if (state.tag && !tags.includes(state.tag)) return false;
            return true;
          }

          function sorted() {
            const list = cards.filter(matches);
            list.sort((a, b) => {
              if (state.sort === 'title') {
                return (a.getAttribute('data-title') || '').localeCompare(
                  b.getAttribute('data-title') || '',
                  'zh'
                );
              }
              return String(b.getAttribute('data-date') || '').localeCompare(
                String(a.getAttribute('data-date') || '')
              );
            });
            return list;
          }

          function render() {
            const list = sorted();
            cards.forEach((c) => (c.hidden = true));
            list.slice(0, state.visible).forEach((c) => {
              c.hidden = false;
              grid.appendChild(c); // 按排序结果重排 DOM 顺序
            });
            if (loadMoreBtn) loadMoreBtn.hidden = list.length <= state.visible;
            if (emptyHint) emptyHint.hidden = list.length > 0;
            if (counter) counter.textContent = `共 ${list.length} 篇`;
          }

          function scrollToGrid() {
            if (gridSection && (state.cat !== 'all' || state.tag)) {
              gridSection.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
            }
          }

          catCards.forEach((btn) => {
            btn.addEventListener('click', () => {
              catCards.forEach((b) => {
                const on = b === btn;
                b.classList.toggle('is-active', on);
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
              });
              tagPills.forEach((p) => {
                p.classList.remove('is-active');
                p.setAttribute('aria-pressed', 'false');
              });
              state.cat = btn.getAttribute('data-filter') || 'all';
              state.tag = '';
              state.visible = PAGE;
              render();
              scrollToGrid();
            });
          });

          tagPills.forEach((btn) => {
            btn.addEventListener('click', () => {
              tagPills.forEach((p) => {
                const on = p === btn;
                p.classList.toggle('is-active', on);
                p.setAttribute('aria-pressed', on ? 'true' : 'false');
              });
              catCards.forEach((c) => {
                c.classList.remove('is-active');
                c.setAttribute('aria-pressed', 'false');
              });
              state.tag = btn.getAttribute('data-tagfilter') || '';
              state.cat = 'all';
              state.visible = PAGE;
              render();
              scrollToGrid();
            });
          });

          sortBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
              sortBtns.forEach((b) => {
                const on = b === btn;
                b.classList.toggle('is-active', on);
                b.setAttribute('aria-pressed', on ? 'true' : 'false');
              });
              state.sort = btn.getAttribute('data-sort') || 'newest';
              render();
            });
          });

          if (loadMoreBtn) {
            loadMoreBtn.addEventListener('click', () => {
              state.visible += PAGE;
              render();
            });
          }

          render();
        </script>
      </>
    )
  }
</Base>

<style>
  /* ---------- Hero：深紫渐变 + 居中白字（对齐参考站） ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-grad);
    color: #fff;
    text-align: center;
    margin-top: -44px;                 /* 顶到 header 下沿 */
    margin-left: calc(50% - 50vw);     /* 满屏出血 */
    margin-right: calc(50% - 50vw);
    padding: 84px 24px 92px;
  }
  .hero-glow {
    position: absolute;
    left: 50%;
    top: -180px;
    width: 640px;
    height: 640px;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.22), transparent 62%);
    pointer-events: none;
  }
  .hero-inner { position: relative; max-width: 760px; margin: 0 auto; }
  .hero-eyebrow {
    display: inline-block;
    margin-bottom: 18px;
    padding: 6px 16px;
    border: 1px solid rgba(255, 255, 255, 0.38);
    border-radius: var(--r-pill);
    font-size: 12.5px;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.92);
  }
  .hero-title {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: 46px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.18);
  }
  .hero-sub {
    margin: 0 auto 30px;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.85);
  }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }

  /* ---------- 版块 ---------- */
  .block { margin: 64px 0; }

  /* 分类瓷砖网格 */
  .cat-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(196px, 1fr));
    gap: 18px;
  }

  /* T11：解决方案引导卡片 */
  .sol-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
  }
  .sol-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--fg-soft);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .sol-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
    text-decoration: none;
  }
  .sol-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--sol, var(--accent)) 16%, transparent);
    color: var(--sol, var(--accent));
    margin-bottom: 4px;
  }
  .sol-card h3 { margin: 0; font-size: 18px; font-weight: 700; color: var(--fg); }
  .sol-card p { margin: 0; font-size: 13.5px; color: var(--muted); line-height: 1.7; }
  .sol-cta {
    margin-top: auto;
    padding-top: 6px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap; /* 文案+箭头强制单行，避免「→」被挤到第二行 */
    transition: gap var(--dur) var(--ease);
  }
