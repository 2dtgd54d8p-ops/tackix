---
/**
 * 英文首页 /en（T12）
 * ---------------------------------------------------------------
 * 面向东南亚 B2B 买家的英文落地页。与中文首页共用 Base 外壳，
 * 但使用**英文文案 + en 平行字段**，并在 SEO 层输出 hreflang
 * （zh-CN / en 互指，x-default → /en）。
 *
 * 为什么先做 en：东南亚市场实际采购语言以英文为主，英文页是海外
 * 流量的真实入口；vi / th 待按市场优先级补译。
 */
import { createReader } from '@keystatic/core/reader';
// ⚠️ src/pages/en/ 是三层深（en → pages → src），须用 ../../../；
//    相对导入层级算错会报 "Could not resolve ... from ..."，构建直接失败。
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import { pick } from '../../lib/i18n-content';
import { loadSiteData, loadContent } from '../../lib/site-data';

const reader = createReader(process.cwd(), keystaticConfig);

async function readAll(col: 'products' | 'cases' | 'posts') {
  let slugs: string[] = [];
  try {
    slugs = await reader.collections[col].list();
  } catch {
    return [];
  }
  const out = await Promise.all(
    slugs.map(async (slug) => {
      try {
        const d = await reader.collections[col].read(slug);
        return d && d.published !== false ? { slug, ...d } : null;
      } catch {
        return null;
      }
    })
  );
  return out.filter(Boolean) as any[];
}

const products = (await readAll('products')).sort(
  (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false)
);
const cases = await readAll('cases');
const posts = await readAll('posts');
posts.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

// hreflang：仅声明真实存在的语种，避免软 404
const alternates = [
  { lang: 'zh-CN', href: '/' },
  { lang: 'en', href: '/en/' },
  { lang: 'x-default', href: '/en/' },
];

const featuredProducts = products.slice(0, 4);
const featuredCases = cases.filter((c) => c.featured).slice(0, 3);
const latestPosts = posts.slice(0, 3);

// 分类英文标签（与 site-data 的 DEFAULT_PRODUCT_CATEGORIES 对齐）
const CAT_EN: Record<string, string> = {
  epoxy: 'Epoxy',
  polyurethane: 'Polyurethane',
  acrylic: 'Acrylic',
  silicone: 'Silicone',
  cyanoacrylate: 'Cyanoacrylate',
  uv: 'UV-Curable',
  anaerobic: 'Anaerobic',
  hotmelt: 'Hot Melt',
};

// 标签与化学体系计数：用于首页「热门标签」「按化学体系浏览」两个导流模块
const { tagLabelEn } = await loadSiteData();
// 首页文案来自后台「首页内容」singleton（可编辑、前后端贯通），en 路径取 .en
const L = await loadContent();
const t = (b: { zh: string; en: string }) => b.en;
const usedTags = [...new Set(posts.flatMap((p) => (p.tags ?? []) as string[]))];
const tagItems = usedTags.map((t) => ({ value: t, label: tagLabelEn(t) || t }));
const chemCounts: Record<string, number> = {};
products.forEach((p) => {
  const k = p.category ?? 'uncategorized';
  chemCounts[k] = (chemCounts[k] ?? 0) + 1;
});
const chemTiles = Object.keys(CAT_EN).map((k) => ({
  key: k,
  label: CAT_EN[k],
  count: chemCounts[k] ?? 0,
}));
---

<Base
  title="Industrial Adhesives & Sealants"
  description="B2B platform for industrial adhesives and sealants in Southeast Asia: product database, selection tool, technical articles and case studies with online quotation."
  alternates={alternates}
  locale="en_US"
>
  <section>
    <!-- Hero -->
    <div class="hero en-hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-inner">
        <span class="eyebrow">{t(L.home.heroEyebrow)}</span>
        <h1 class="hero-title">Select the right adhesive for your assembly</h1>
        <p class="hero-sub">
          A technical platform for Southeast Asian contractors, fabricators and procurement teams —
          covering epoxy, polyurethane, silicone, UV, anaerobic and hot-melt systems with
          full parameter data and engineering support.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/en/products">Browse Products</a>
          <a class="btn" href="/en/selector">Selection Tool</a>
          <a class="btn" href="/en/contact">Request a Quotation</a>
        </div>
        <div class="hero-stats">
          <div class="stat"><strong>{products.length}</strong><span>Products</span></div>
          <div class="stat"><strong>{cases.length}</strong><span>Case Studies</span></div>
          <div class="stat"><strong>4</strong><span>Solution Modules</span></div>
          <div class="stat"><strong>EN</strong><span>Multi-language</span></div>
        </div>
      </div>
    </div>

    <!-- Solutions grid：串联 产品→选型→案例→询盘 内链闭环（对齐中文首页「解决方案」） -->
    <section class="block">
      <div class="section-head">
        <h2 class="section-title">{t(L.home.solutionsTitle)}</h2>
        <p>{t(L.home.solutionsSub)}</p>
      </div>
      <div class="sol-cards">
        <a class="sol-card" href={`/en${L.home.solutionCards[0].href}`}>
          <span class="sol-icon" style="--sol:#7c4df0" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" /><path d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" /></svg>
          </span>
          <h3>{t(L.home.solutionCards[0].title)}</h3>
          <p>{t(L.home.solutionCards[0].desc)}</p>
          <span class="sol-cta">{t(L.home.solutionCards[0].cta)} →</span>
        </a>
        <a class="sol-card" href={`/en${L.home.solutionCards[1].href}`}>
          <span class="sol-icon" style="--sol:#18a06a" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="21" x2="4" y2="14" /><line x1="4" y1="10" x2="4" y2="3" /><line x1="12" y1="21" x2="12" y2="12" /><line x1="12" y1="8" x2="12" y2="3" /><line x1="20" y1="21" x2="20" y2="16" /><line x1="20" y1="12" x2="20" y2="3" /><line x1="1" y1="14" x2="7" y2="14" /><line x1="9" y1="8" x2="15" y2="8" /><line x1="17" y1="16" x2="23" y2="16" /></svg>
          </span>
          <h3>{t(L.home.solutionCards[1].title)}</h3>
          <p>{t(L.home.solutionCards[1].desc)}</p>
          <span class="sol-cta">{t(L.home.solutionCards[1].cta)} →</span>
        </a>
        <a class="sol-card" href={`/en${L.home.solutionCards[2].href}`}>
          <span class="sol-icon" style="--sol:#f0883e" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6m0 5h12m0 0h1.5a2.5 2.5 0 0 0 0-5H18m0 5v3a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9m0 0V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3" /><path d="M9 17l3 3 3-3" /></svg>
          </span>
          <h3>{t(L.home.solutionCards[2].title)}</h3>
          <p>{t(L.home.solutionCards[2].desc)}</p>
          <span class="sol-cta">{t(L.home.solutionCards[2].cta)} →</span>
        </a>
        <a class="sol-card" href={`/en${L.home.solutionCards[3].href}`}>
          <span class="sol-icon" style="--sol:#3a7bff" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.7 9.7 0 0 1-2.8-.4L4 21l1.4-4.2A8.4 8.4 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z" /><path d="M8.5 10.4h7M8.5 13.4h4" /></svg>
          </span>
          <h3>{t(L.home.solutionCards[3].title)}</h3>
          <p>{t(L.home.solutionCards[3].desc)}</p>
          <span class="sol-cta">{t(L.home.solutionCards[3].cta)} →</span>
        </a>
      </div>
    </section>

    <!-- Featured products -->
    <div class="section-head">
      <h2 class="section-title">Product Database</h2>
      <p>
        {products.length} industrial adhesives and sealants across eight chemistry families,
        with substrates, gap, temperature range, cure mechanism and certifications.
      </p>
    </div>
    <div class="grid en-cards">
      {
        featuredProducts.map((p) => (
          <a class="card en-card" href={`/en/products/${p.slug}/`}>
            <div class="en-card-cat">{CAT_EN[p.category] ?? p.category}</div>
            <h3>{pick(p.name, p.nameEn)}</h3>
            <p class="en-card-excerpt">{pick(p.excerpt, p.excerptEn)}</p>
            <span class="sol-cta">View technical data →</span>
          </a>
        ))
      }
    </div>
    <div class="en-more">
      <a class="btn btn-outline" href="/en/products">View all {products.length} products →</a>
    </div>

    <!-- Browse by chemistry：按化学体系浏览（对齐中文首页「浏览分类」的导流意图） -->
    <section class="block">
      <div class="section-head">
        <h2 class="section-title">Browse by Chemistry</h2>
        <p>Jump straight to the adhesive family that fits your process.</p>
      </div>
      <div class="chem-cards">
        {
          chemTiles.map((c) => (
            <a class="chem-card" href="/en/products">
              <span class="chem-name">{c.label}</span>
              <span class="chem-count">{c.count} {c.count === 1 ? 'product' : 'products'}</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Selection tool -->
    <div class="band">
      <div class="band-inner">
        <h2 class="section-title">Not sure which adhesive to use?</h2>
        <p>
          Answer three questions — application scenario, cure mechanism and substrate — and our
          selection tool ranks matching products for you.
        </p>
        <a class="btn btn-primary" href="/en/selector">Open the Selection Tool</a>
      </div>
    </div>

    <!-- Cases -->
    <div class="section-head">
      <h2 class="section-title">Application Case Studies</h2>
      <p>Engineering solutions across automotive, electronics, construction, packaging and more.</p>
    </div>
    <div class="grid en-cards">
      {
        featuredCases.map((c) => (
          <a class="card en-card" href={`/en/cases/${c.slug}/`}>
            <h3>{pick(c.title, c.titleEn)}</h3>
            <p class="en-card-excerpt">{pick(c.excerpt, c.excerptEn)}</p>
            <span class="sol-cta">Read the case study →</span>
          </a>
        ))
      }
    </div>

    <!-- Articles -->
    <div class="section-head">
      <h2 class="section-title">Technical Articles</h2>
      <p>Selection guides, failure troubleshooting and application notes.</p>
    </div>
    <ul class="en-post-list">
      {
        latestPosts.map((p) => (
          <li>
            <a href={`/en/posts/${p.slug}/`}>
              <strong>{pick(p.title, p.titleEn)}</strong>
              <span>{pick(p.excerpt, p.excerptEn)}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Popular Topics：热门标签（对齐中文首页「热门标签」导流模块） -->
    {
      tagItems.length > 0 && (
        <section class="block">
          <div class="section-head">
            <h2 class="section-title">Popular Topics</h2>
            <p>Explore articles by the questions engineers ask most.</p>
          </div>
          <div class="tag-pills">
            {
              tagItems.map((t) => (
                <a class="tag-pill" href="/en/posts">{t.label}</a>
              ))
            }
          </div>
        </section>
      )
    }

    <!-- CTA -->
    <div class="band">
      <div class="band-inner">
        <h2 class="section-title">Need a recommendation?</h2>
        <p>
          Send us your substrate, load, temperature and cure conditions — our engineers will
          recommend a grade and process, and provide TDS/SDS documentation on request.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/en/contact">Contact Sales</a>
          <a class="btn" href="/en/posts">Browse Technical Articles</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 英文站 Hero：与中文首页一致的「大气」处理（补全背景/出血/纹理）── */
  .en-hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-grad);
    color: #fff;
    text-align: center;
    margin-top: -44px;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 128px 24px 132px;
  }
  .en-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 32%, #000 38%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 32%, #000 38%, transparent 100%);
    pointer-events: none;
  }
  .en-hero .hero-glow {
    position: absolute;
    left: 50%;
    top: -230px;
    width: 900px;
    height: 900px;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(255, 255, 255, 0.2), transparent 62%);
    pointer-events: none;
  }
  /* 右下角辅助光晕，丰富纵深（对齐中文首页 .hero::after） */
  .en-hero::after {
    content: "";
    position: absolute;
    right: -180px;
    bottom: -260px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.14), transparent 62%);
    pointer-events: none;
  }
  .en-hero .hero-inner { position: relative; max-width: 900px; margin: 0 auto; }
  .en-hero .eyebrow {
    display: inline-block;
    margin-bottom: 22px;
    padding: 7px 18px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--r-pill);
    font-size: 13.5px;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.92);
  }
  .en-hero .hero-title {
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.22);
  }
  .en-hero .hero-sub { max-width: 640px; margin: 0 auto 36px; font-size: 18px; line-height: 1.85; color: rgba(255, 255, 255, 0.86); }
  .en-hero .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
  .en-hero .btn { padding: 14px 32px; font-size: 15.5px; font-weight: 600; }
  .hero-stats {
    display: flex;
    gap: 36px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 56px;
    padding-top: 34px;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .hero-stats .stat { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
  }
  .hero-stats span { font-size: 13px; letter-spacing: 0.08em; color: rgba(255, 255, 255, 0.72); }

  .en-cards { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .en-card { display: flex; flex-direction: column; }
  .en-card-cat {
    font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 8px;
  }
  .en-card h3 { font-size: 18px; margin: 0 0 8px; line-height: 1.35; }
  .en-card-excerpt {
    color: var(--muted); font-size: 14.5px; line-height: 1.7;
    margin: 0 0 14px; flex: 1;
  }
  .en-more { text-align: center; margin: 28px 0 8px; }

  /* ── 解决方案卡片（对齐中文首页「解决方案」网格）── */
  .sol-cards { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .sol-card {
    display: flex; flex-direction: column; gap: 10px; padding: 24px;
    border: 1px solid var(--border); border-radius: var(--r-lg);
    background: var(--surface); box-shadow: var(--shadow-sm);
    text-decoration: none; color: var(--fg-soft);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .sol-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--border-strong); text-decoration: none; }
  .sol-icon {
    width: 44px; height: 44px; border-radius: 12px; display: inline-flex;
    align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--sol, var(--accent)) 16%, transparent);
    color: var(--sol, var(--accent)); margin-bottom: 4px;
  }
  .sol-card h3 { margin: 0; font-size: 18px; font-weight: 700; color: var(--fg); }
  .sol-card p { margin: 0; font-size: 13.5px; color: var(--muted); line-height: 1.7; }
  .sol-cta {
    margin-top: auto; padding-top: 6px; font-size: 14px; font-weight: 600;
    color: var(--accent); display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
    transition: gap var(--dur) var(--ease);
  }
  .sol-card:hover .sol-cta { gap: 10px; }

  /* ── 按化学体系浏览 ── */
  .chem-cards { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  .chem-card {
    display: flex; flex-direction: column; gap: 4px; padding: 20px 18px;
    border: 1px solid var(--border); border-radius: var(--r-md);
    background: var(--surface); text-decoration: none; color: var(--fg);
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .chem-card:hover { border-color: var(--accent); background: var(--surface-2); transform: translateY(-2px); text-decoration: none; }
  .chem-name { font-size: 16px; font-weight: 600; }
  .chem-count { font-size: 12.5px; color: var(--muted); }

  /* ── 热门标签胶囊 ── */
  .tag-pills { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .tag-pill {
    display: inline-flex; align-items: center; gap: 6px; padding: 7px 16px;
    border: 1px solid var(--border-strong); border-radius: var(--r-pill);
    background: var(--surface); color: var(--fg-soft);
    font-size: 13px; font-weight: 500; text-decoration: none;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .tag-pill:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); text-decoration: none; }

  .en-post-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .en-post-list a {
    display: flex; flex-direction: column; gap: 4px; padding: 16px 18px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .en-post-list a:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }
  .en-post-list strong { color: var(--fg); font-size: 16px; }
  .en-post-list span { color: var(--muted); font-size: 14px; line-height: 1.65; }

  /* 移动端：Hero 缩放与中文首页保持一致 */
  @media (max-width: 700px) {
    .en-hero { margin-top: -24px; padding: 84px 18px 88px; }
    .en-hero .hero-title { font-size: 32px; }
    .en-hero .hero-sub { font-size: 16px; }
    .en-hero .hero-stats { gap: 22px; margin-top: 40px; padding-top: 26px; }
    .en-hero .hero-stats strong { font-size: 26px; }
  }
</style>
