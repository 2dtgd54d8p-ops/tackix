---
/**
 * 英文联系/询盘页 /en/contact（P0-3 英文版补齐）
 * ---------------------------------------------------------------
 * 与中文联系页保持功能对等：
 * 1. **联系方式优先于表单**——B2B 买家看完参数表后的下一步是「找谁问」。
 *    预上线期表单被闸门关闭，联系方式是唯一转化入口，必须放最上面。
 * 2. 所有字段留空即隐藏对应入口，不留空链接（与中文版一致）。
 * 3. 预上线期在表单区明确提示状态，避免英文访客反复提交却收不到回复。
 * 4. **修复假成功**：提交后必须读 API 返回的 `prelaunch` 标记——
 *    预上线时 API 返回 200 + {prelaunch:true}，旧逻辑只看 res.ok 会误报成功。
 */
import Base from '../../layouts/Base.astro';
import { loadSiteData, loadContent } from '../../lib/site-data';
import { isPreLaunch } from '../../lib/prelaunch';

const { site } = await loadSiteData();
const prelaunch = isPreLaunch();
// 联系页文案来自后台「联系页文案」singleton（可编辑、前后端贯通）
const L = await loadContent();
const t = (b: { zh: string; en: string }) => b.en;
const successMsg = t(L.contact.success);
const prelaunchMsg = t(L.contact.prelaunchBody);

const email = (site.email ?? '').trim();
const company = (site.company ?? '').trim();
const phone = (site.phone ?? '').trim();
const address = (site.address ?? '').trim();
const hours = (site.hours ?? '').trim();
const whatsapp = (site.whatsapp ?? '').replace(/[^0-9]/g, '');
const waText = encodeURIComponent(
  (site.whatsappPrefill ?? '').trim() ||
    'Hello, I would like a quotation for industrial adhesives. Could you share TDS/SDS and technical support?'
);
const wechat = (site.wechat ?? '').trim();

// 任一联系方式存在才渲染该区块
const hasContact = !!(email || whatsapp || wechat || phone || address || company || hours);
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : '';
const mailHref = email
  ? `mailto:${email}?subject=${encodeURIComponent('Quotation inquiry · ' + (company || 'Tackix'))}`
  : '';

const ICON = {
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6 9 6.5L21 6"/>',
  phone: '<path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"/>',
  pin: '<path d="M12 21s7-5.3 7-11a7 7 0 1 0-14 0c0 5.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  building: '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 10h2m-2 4h2m2-4h2m-2 4h2"/>',
  wechat: '<path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.7 9.7 0 0 1-2.8-.4L4 21l1.4-4.2A8.4 8.4 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z" /><path d="M8.5 10.4h7M8.5 13.4h4" />',
};
---

<Base
  title="Contact Sales"
  description="Request a quotation for industrial adhesives and sealants. Send your substrate, load and temperature conditions for a tailored recommendation, TDS and SDS available on request."
  alternates={[{ lang: 'zh-CN', href: '/contact/' }, { lang: 'en', href: '/en/contact/' }, { lang: 'x-default', href: '/en/contact/' }]}
  locale="en_US"
>
  <section>
    <div class="page-head">
      <h1>{t(L.contact.pageTitle)}</h1>
      <p>{t(L.contact.pageSub)}</p>
    </div>

    <div class:list={['en-contact-grid', !hasContact && 'en-contact-grid--single']}>
      {
        hasContact && (
          <div class="contact-info">
            <h2 class="section-title">{t(L.contact.contactInfoTitle)}</h2>

            {email && (
              <a class="contact-item" href={mailHref}>
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.mail} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">Email</span>
                  <span class="ci-value">{email}</span>
                </span>
              </a>
            )}

            {whatsapp && (
              <a class="contact-item" href={`https://wa.me/${whatsapp}?text=${waText}`} target="_blank" rel="noopener">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.3 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.8-.7-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .7.5l.9 2.2c.1.2.1.4 0 .6l-.4.6-.3.3c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.3.2.5.1.7-.1l.8-1c.2-.2.4-.2.6-.1l2.1 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
                </span>
                <span class="ci-body">
                  <span class="ci-label">WhatsApp</span>
                  <span class="ci-value">+{whatsapp}</span>
                </span>
              </a>
            )}

            {wechat && (
              <div class="contact-item contact-item-static">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.wechat} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">WeChat</span>
                  <span class="ci-value">{wechat}</span>
                </span>
              </div>
            )}

            {phone && (
              <a class="contact-item" href={telHref}>
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.phone} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">Phone</span>
                  <span class="ci-value">{phone}</span>
                </span>
              </a>
            )}

            {company && (
              <div class="contact-item contact-item-static">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.building} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">Company</span>
                  <span class="ci-value">{company}</span>
                </span>
              </div>
            )}

            {address && (
              <div class="contact-item contact-item-static">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.pin} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">Address</span>
                  <span class="ci-value">{address}</span>
                </span>
              </div>
            )}

            {hours && (
              <div class="contact-item contact-item-static">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.clock} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">Business Hours</span>
                  <span class="ci-value">{hours}</span>
                </span>
              </div>
            )}
          </div>
        )
      }

      <div class="contact-form-wrap">
        <h2 class="section-title">{t(L.contact.formSectionTitle)}</h2>
        {
          prelaunch && (
            <div class="notice">
              <strong>{t(L.contact.prelaunchTitle)}</strong>
              <p>{t(L.contact.prelaunchBody)}</p>
            </div>
          )
        }
        <form id="contact-form" class="contact-form" novalidate>
          <div class="field">
            <label for="name">{t(L.contact.formName)} *</label>
            <input id="name" name="name" type="text" required maxlength="60" autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">{t(L.contact.formEmail)} *</label>
            <input id="email" name="email" type="email" required maxlength="120" autocomplete="email" />
          </div>
          <div class="field">
            <label for="message">{t(L.contact.formMsg)} *</label>
            <textarea id="message" name="message" required rows="6" maxlength="2000"
              placeholder="e.g. Bonding aluminium to FRP in an EV battery pack housing, continuous vibration, -40 to 85°C, gap 0.5 mm."></textarea>
          </div>
          <button type="submit" class="btn btn-primary" id="submit-btn">{t(L.contact.submit)}</button>
          <p class="status" id="form-status" hidden data-success={successMsg} data-prelaunch={prelaunchMsg}></p>
        </form>

        <div class="en-tips-box">
          <h3>{t(L.contact.tipsTitle)}</h3>
          <ul class="en-tips">
            {L.contact.tipsItems.map((tip) => <li>{t(tip)}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .en-contact-grid {
    display: grid; gap: 40px; align-items: start;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
  }
  /* 无联系方式时退化为单栏，避免空 320px 左列把表单压成半幅 */
  .en-contact-grid--single { grid-template-columns: minmax(0, 1fr); }
  .en-contact-grid--single .contact-form { max-width: 100%; }

  @media (max-width: 820px) { .en-contact-grid { grid-template-columns: 1fr; } }

  .contact-info { display: grid; gap: 10px; align-content: start; }
  .contact-item {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 13px 15px; border-radius: var(--r-md);
    background: var(--surface); border: 1px solid var(--border);
    color: inherit; text-decoration: none;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  a.contact-item:hover { border-color: var(--accent); background: var(--surface-2); text-decoration: none; }

  .ci-icon { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
  .ci-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ci-label { font-size: 12px; color: var(--faint); letter-spacing: 0.03em; }
  .ci-value { font-size: 14.5px; color: var(--fg); word-break: break-word; line-height: 1.5; }

  .notice {
    padding: 13px 16px; border-radius: var(--r-md); margin-bottom: 18px;
    font-size: 14px; line-height: 1.7;
    background: var(--surface-2); border: 1px solid var(--border); color: var(--fg-soft);
  }
  .notice strong { display: block; margin-bottom: 4px; color: var(--fg); }
  .notice p { margin: 0; }

  .contact-form {
    display: flex; flex-direction: column; gap: 18px;
    max-width: 560px;
    padding: 26px 24px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .contact-form .field { display: flex; flex-direction: column; gap: 6px; }
  .contact-form .field label { font-size: 13px; font-weight: 600; color: var(--fg-soft); }
  .contact-form .field input,
  .contact-form .field textarea {
    padding: 11px 13px; border: 1px solid var(--border-strong); border-radius: var(--r-md);
    background: var(--surface); color: var(--fg); font: inherit; font-size: 14.5px;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .contact-form .field input:focus,
  .contact-form .field textarea:focus {
    outline: none; border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .contact-form .btn { align-self: flex-start; }
  .contact-form .status { text-align: left; }

  .en-tips-box {
    margin-top: 22px; padding: 18px 20px;
    border: 1px solid var(--border); border-radius: var(--r-md);
    background: var(--surface);
  }
  .en-tips-box h3 { margin: 0 0 10px; font-size: 15px; color: var(--fg); }
  .en-tips { margin: 0; padding-left: 18px; color: var(--muted); font-size: 14px; line-height: 1.9; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const status = document.getElementById('form-status') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn) return;
    const data = Object.fromEntries(new FormData(form).entries());
    btn.disabled = true;
    status.hidden = false;
    status.className = 'status';
    status.textContent = 'Sending…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      // 关键修复：预上线期 API 返回 200 + {prelaunch:true}，只读 res.ok 会误报成功。
      // 必须显式判断 json.prelaunch，把「已收下但暂不处理」和「真正成功」区分开。
      if (res.ok && json.ok && !json.prelaunch) {
        form.reset();
        status.className = 'status ok';
        status.textContent = status.dataset.success || 'Thank you — your enquiry has been received.';
      } else if (json.prelaunch) {
        status.className = 'status err';
        status.textContent = json.error || status.dataset.prelaunch || 'This site is not yet live for enquiries.';
      } else {
        status.className = 'status err';
        status.textContent = 'Submission failed: ' + (json.error || 'unknown error');
      }
    } catch {
      status.className = 'status err';
      status.textContent = 'Network error. Please try again later.';
    } finally {
      btn.disabled = false;
    }
  });
</script>
