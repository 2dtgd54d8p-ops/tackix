---
/**
 * 英文文章列表页 /en/posts（T12）
 */
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../../keystatic.config';
import Base from '../../../layouts/Base.astro';
import { pick } from '../../../lib/i18n-content';
import { loadSiteData, buildFilterOptions, loadContent } from '../../../lib/site-data';

const reader = createReader(process.cwd(), keystaticConfig);
let slugs: string[] = [];
try {
  slugs = await reader.collections.posts.list();
} catch (e) {
  console.warn('[build] 读取文章列表失败：', e);
}

const posts = (
  await Promise.all(
    slugs.map(async (slug) => {
      try {
        const p = await reader.collections.posts.read(slug);
        return p && p.published !== false ? { slug, ...p } : null;
      } catch {
        return null;
      }
    })
  )
).filter(Boolean) as any[];

posts.sort(
  (a, b) =>
    Number(b.featured ?? false) - Number(a.featured ?? false) ||
    String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? ''))
);

// 列表页标题/副标题来自后台「列表页标题」singleton（可编辑、前后端贯通）
const L = await loadContent();
const t = (b: { zh: string; en: string }) => b.en;
const postsSub = t(L.pages.postsSub).replace('{n}', String(posts.length));

// 分类标签（英文）与筛选条：与中文列表页共用同一套逻辑，保证两页表现一致
const { categories, categoryLabelEn, tagLabelEn } = await loadSiteData();
const filterOptions = buildFilterOptions(posts, categories);
---

<Base
  title="Technical Articles"
  description="Adhesive selection guides, failure troubleshooting and application notes for industrial adhesives and sealants."
  alternates={[{ lang: 'zh-CN', href: '/posts/' }, { lang: 'en', href: '/en/posts/' }, { lang: 'x-default', href: '/en/posts/' }]}
  locale="en_US"
>
  <section>
    <div class="page-head">
      <h1>{t(L.pages.postsTitle)}</h1>
      <p>{postsSub}</p>
    </div>

    {
      posts.length === 0 ? (
        <p class="empty">No articles published yet.</p>
      ) : (
        <>
          {filterOptions.length > 1 && (
            <nav class="filters" id="cat-filter" aria-label="Filter articles by category">
              {filterOptions.map((c, i) => (
                <button
                  type="button"
                  class={`filter-btn${i === 0 ? ' is-active' : ''}`}
                  data-filter={c.value}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {c.value === 'all' ? 'All' : categoryLabelEn(c.value) || c.value}
                </button>
              ))}
            </nav>
          )}
          <div class="grid en-cards">
            {posts.map((p) => (
              <a class="card en-card" href={`/en/posts/${p.slug}/`} data-category={p.category ?? 'uncategorized'}>
                {p.publishedAt && <time class="en-card-date">{new Date(p.publishedAt).toISOString().slice(0, 10)}</time>}
                <h3>{pick(p.title, p.titleEn)}</h3>
                <p class="en-card-excerpt">{pick(p.excerpt, p.excerptEn)}</p>
                <div class="en-card-meta">
                  {p.category && p.category !== 'uncategorized' && (
                    <span class="tag">{categoryLabelEn(p.category)}</span>
                  )}
                  {(p.tags ?? []).slice(0, 2).map((tg: string) => (
                    <span class="tag tag-plain">{tagLabelEn(tg)}</span>
                  ))}
                </div>
                <span class="sol-cta">Read article →</span>
              </a>
            ))}
          </div>
          <p class="empty" data-empty hidden>No articles in this category.</p>
        </>
      )
    }
  </section>
</Base>

<style>
  .filters { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin: -8px 0 30px; }
  .filter-btn {
    padding: 7px 18px; border: 1px solid var(--border-strong); border-radius: var(--r-pill);
    background: var(--surface); color: var(--muted); font: inherit; font-size: 13px; font-weight: 500;
    cursor: pointer; transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
  .filter-btn.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

  .en-cards { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
  .en-card { display: flex; flex-direction: column; }
  .en-card-date { font-size: 12px; color: var(--faint); margin-bottom: 8px; }
  .en-card h3 { font-size: 18px; margin: 0 0 8px; line-height: 1.35; }
  .en-card-excerpt { color: var(--muted); font-size: 14.5px; line-height: 1.7; margin: 0 0 14px; flex: 1; }
  .en-card-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .en-card-meta .tag { padding: 3px 10px; font-size: 12px; border-radius: var(--r-pill); background: var(--surface-2); border: 1px solid var(--border); color: var(--fg-soft); }
  .en-card-meta .tag-plain { background: transparent; }
</style>

<script>
  const bar = document.getElementById('cat-filter');
  const grid = document.querySelector('.en-cards');
  const emptyHint = document.querySelector('[data-empty]');
  if (bar && grid) {
    const cards = Array.from(grid.querySelectorAll('.en-card'));
    bar.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-btn');
      if (!btn) return;
      const value = btn.getAttribute('data-filter');
      bar.querySelectorAll('.filter-btn').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      let visible = 0;
      cards.forEach((c) => {
        const show = value === 'all' || c.getAttribute('data-category') === value;
        c.hidden = !show;
        if (show) visible += 1;
      });
      if (emptyHint) emptyHint.hidden = visible > 0;
    });
  }
</script>
