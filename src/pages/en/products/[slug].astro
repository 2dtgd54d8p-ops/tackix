---
/**
 * 英文产品详情页 /en/products/[slug]（T12）
 * 与中文页共用参数表渲染逻辑，文案走 en 平行字段，缺失则回退中文。
 */
import { createReader } from '@keystatic/core/reader';
// ⚠️ src/pages/en/products/ 是四层深（products → en → pages → src）
import keystaticConfig from '../../../../keystatic.config';
import Base from '../../../layouts/Base.astro';
import { marked } from 'marked';
import { loadSiteData, loadContent } from '../../../lib/site-data';
import { pick } from '../../../lib/i18n-content';

/**
 * ⚠️ 静态站必须在 getStaticPaths 内自建 reader —— frontmatter 顶层创建的
 *    reader 在 getStaticPaths 作用域不可见（沿用中文详情页的做法）。
 */
export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  let slugs: string[] = [];
  try {
    slugs = await reader.collections.products.list();
  } catch (e) {
    console.warn('[build] 读取产品列表失败：', e);
  }
  const entries = await Promise.all(
    slugs.map(async (slug) => {
      try {
        const product = await reader.collections.products.read(slug);
        return product && product.published !== false ? { params: { slug }, props: { product } } : null;
      } catch {
        return null;
      }
    })
  );
  return entries.filter(Boolean) as any[];
}

const { product } = Astro.props;
const slug = Astro.params.slug;

const { productCategoryLabelEn, scenarioLabelEn, cureLabelEn, certLabelEn } = await loadSiteData();
// 详情页区块标题来自后台「详情页区块标题」singleton（可编辑、前后端贯通）
const L = await loadContent();
const t = (b: { zh: string; en: string }) => b.en;

// 英文技术标签
const T: Record<string, string> = {
  model: 'Model',
  baseMaterial: 'Substrates',
  displacement: 'Gap / Bond Line',
  tempRange: 'Temperature Range',
  viscosity: 'Viscosity',
  category: 'Chemistry',
  scenario: 'Application',
  cureType: 'Cure Mechanism',
  certifications: 'Certifications',
  overview: 'Technical Data',
  download: 'Documents',
  inquiry: 'Request Quotation',
  tds: 'TDS',
  sds: 'SDS',
  back: '← All Products',
  wa: 'Chat on WhatsApp',
  contact: 'Contact Sales',
  none: 'Not specified',
};

// 产品示意图（P0-1）：缺省时回退中文原名，保证 alt 始终有值
const name = pick(product.name, product.nameEn);
const coverUrl = product.cover
  ? (product.cover.startsWith('/') ? product.cover : `/uploads/${product.cover}`)
  : '';

// 文件下载链接：Keystatic 的文件字段存的是相对于 publicPath 的文件名，
// 与中文详情页统一用 toPublicUrl 处理（兼容带/不带 / 前缀两种存储方式）。
function toPublicUrl(v: unknown): string {
  if (!v || typeof v !== 'string') return '';
  return v.startsWith('/') ? v : `/uploads/${v}`;
}
const tdsUrl = toPublicUrl(product.tds);
const sdsUrl = toPublicUrl(product.sds);
const excerpt = pick(product.excerpt, product.excerptEn);
const bodyHtml = await marked.parse(pick(product.body, product.bodyEn));

// 仅渲染有值的字段
const specs = [
  ['model', product.model],
  ['category', product.category ? productCategoryLabelEn(product.category) : ''],
  ['scenario', product.scenario ? scenarioLabelEn(product.scenario) : ''],
  ['baseMaterial', product.baseMaterial],
  ['displacement', product.displacement],
  ['tempRange', product.tempRange],
  ['cureType', product.cureType ? cureLabelEn(product.cureType) : ''],
  ['viscosity', product.viscosity],
].filter(([, v]) => !!v);

const certs: string[] = product.certifications ?? [];

const alternates = [
  { lang: 'zh-CN', href: `/products/${product.slug ?? slug}/` },
  { lang: 'en', href: `/en/products/${product.slug ?? slug}/` },
  { lang: 'x-default', href: `/en/products/${product.slug ?? slug}/` },
];

// Product JSON-LD（英文版）——与中文页等价，保证 Google 购物/富结果可用。
// 价格刻意不写（站点不标价，offers 指向 /en/contact 询盘），符合 B2B 询盘制做法。
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  model: product.model ?? undefined,
  description: excerpt,
  sku: product.model || slug || undefined,
  category: product.category ? productCategoryLabelEn(product.category) : undefined,
  url: `https://tackix.pages.dev/en/products/${slug}/`,
  ...(coverUrl ? { image: new URL(coverUrl, 'https://tackix.pages.dev').href } : {}),
  ...(certs.length ? { certification: certs.map((c) => certLabelEn(c)).filter(Boolean) } : {}),
  additionalProperty: [
    product.baseMaterial && { propertyID: 'substrates', name: 'Substrates', value: product.baseMaterial },
    product.displacement && { propertyID: 'gap', name: 'Gap / Bond Line', value: product.displacement },
    product.tempRange && { propertyID: 'temperature', name: 'Temperature Range', value: product.tempRange },
    product.viscosity && { propertyID: 'viscosity', name: 'Viscosity', value: product.viscosity },
    product.cureType && { propertyID: 'cure', name: 'Cure Mechanism', value: cureLabelEn(product.cureType) },
    product.scenario && { propertyID: 'application', name: 'Application', value: scenarioLabelEn(product.scenario) },
  ].filter(Boolean),
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    priceSpecification: { '@type': 'PriceSpecification', valueAddedTaxIncluded: false },
    url: `https://tackix.pages.dev/en/contact/`,
    // 不标价：引导询盘而非直接购买
    price: '0',
    priceCurrency: 'USD',
    description: 'Contact us for quotation',
  },
};
---

<Base title={name} description={excerpt} alternates={alternates} locale="en_US">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  </Fragment>

  <section>
    <a class="en-back" href="/en/products/">{T.back}</a>

    <div class="en-detail-head">
      <h1>{name}</h1>
      <p class="en-detail-sub">{excerpt}</p>
    </div>

    <div class="en-detail-grid">
      <div class="en-detail-main">
        {coverUrl && <img class="en-cover" src={coverUrl} alt={name} loading="lazy" />}
        <h2 class="section-title">{t(L.detail.productDescTitle)}</h2>
        <div class="prose en-prose" set:html={bodyHtml} />

        {
          (tdsUrl || sdsUrl) && (
            <div class="en-downloads">
              <h2 class="section-title">{t(L.detail.productDocsTitle)}</h2>
              <div class="en-download-btns">
                {tdsUrl && (
                  <a class="btn" href={tdsUrl} target="_blank" rel="noopener noreferrer" download>
                    Download {T.tds} (PDF)
                  </a>
                )}
                {sdsUrl && (
                  <a class="btn" href={sdsUrl} target="_blank" rel="noopener noreferrer" download>
                    Download {T.sds} (PDF)
                  </a>
                )}
              </div>
            </div>
          )
        }
      </div>

      <aside class="en-detail-side">
        <div class="spec-table">
          <h2 class="section-title">{t(L.detail.productSpecsTitle)}</h2>
          <table>
            <tbody>
              {
                specs.map(([k, v]) => (
                  <tr>
                    <th>{T[k as string] ?? k}</th>
                    <td>{v}</td>
                  </tr>
                ))
              }
              {
                certs.length > 0 && (
                  <tr>
                    <th>{T.certifications}</th>
                    <td>
                      <span class="en-certs">
                        {certs.map((c) => (
                          <span class="tag">{certLabelEn(c)}</span>
                        ))}
                      </span>
                    </td>
                  </tr>
                )
              }
            </tbody>
          </table>
        </div>

        <div class="quote-block">
          <h3>{t(L.detail.productQuoteTitle)}</h3>
          <p>{t(L.detail.productQuoteCopy)}</p>
          <div class="en-download-btns">
            <a class="btn btn-primary" href="/en/contact">{T.contact}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .en-back { display: inline-block; margin-bottom: 18px; font-size: 14px; color: var(--muted); }
  .en-detail-head { margin-bottom: 32px; }
  .en-detail-head h1 { font-size: 34px; line-height: 1.2; margin: 0 0 12px; }
  .en-detail-sub { color: var(--muted); font-size: 16px; line-height: 1.7; max-width: 720px; }

  .en-detail-grid { display: grid; gap: 40px; grid-template-columns: minmax(0, 1fr) 320px; align-items: start; }
  @media (max-width: 900px) { .en-detail-grid { grid-template-columns: 1fr; } }

  .en-cover {
    width: 100%; height: auto; display: block; border-radius: var(--r-md);
    border: 1px solid var(--border); margin-bottom: 28px;
  }
  .en-prose { margin-bottom: 32px; }
  .en-downloads { margin-top: 32px; }
  .en-download-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }

  .spec-table table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .spec-table th, .spec-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .spec-table th { color: var(--muted); font-weight: 600; width: 40%; }
  .en-certs { display: flex; gap: 6px; flex-wrap: wrap; }
  .quote-block { margin-top: 24px; padding: 20px; background: var(--surface-2); border-radius: var(--r-md); border: 1px solid var(--border); }
  .quote-block h3 { margin: 0 0 8px; font-size: 17px; }
  .quote-block p { color: var(--muted); font-size: 14px; line-height: 1.7; margin: 0; }
</style>
