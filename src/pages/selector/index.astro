---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import { loadSiteData, DEFAULT_SCENARIOS, DEFAULT_CURE } from '../../lib/site-data';

const reader = createReader(process.cwd(), keystaticConfig);
let slugs: string[] = [];
try {
  slugs = await reader.collections.products.list();
} catch (e) {
  console.warn('[build] 读取产品列表失败：', e);
}

// 仅取已发布产品的选型维度，构建期嵌入前端做客户端打分（无需后端）
const products = (
  await Promise.all(
    slugs.map(async (slug) => {
      try {
        const p = await reader.collections.products.read(slug);
        if (!p || p.published === false) return null;
        return {
          slug,
          name: p.name ?? '',
          model: p.model ?? '',
          category: p.category ?? '',
          scenario: p.scenario ?? '',
          cureType: p.cureType ?? '',
          baseMaterial: p.baseMaterial ?? '',
          tempRange: p.tempRange ?? '',
          excerpt: p.excerpt ?? '',
          cover: p.cover ?? '',
        };
      } catch {
        return null;
      }
    })
  )
).filter(Boolean) as any[];

const { scenarioLabel, cureLabel, productCategoryLabel } = await loadSiteData();

const scenarioOpts = DEFAULT_SCENARIOS;
const cureOpts = [{ label: '不限', value: '' }, ...DEFAULT_CURE];
const dataJson = JSON.stringify(
  products.map((p) => ({
    ...p,
    categoryLabel: productCategoryLabel(p.category),
    scenarioLabel: scenarioLabel(p.scenario),
    cureLabel: cureLabel(p.cureType),
  }))
);
---

<Base title="产品选型"
  alternates={[
    { lang: 'zh-CN', href: '/selector/' },
    { lang: 'en', href: '/en/selector/' },
    { lang: 'x-default', href: '/en/selector/' },
  ]}>
  <section>
    <div class="page-head">
      <h1>产品选型</h1>
      <p>按应用场景、固化方式与适用基材，为您推荐匹配的工业胶粘剂与密封剂。</p>
    </div>

    <form class="selector-form" id="selector-form" aria-label="产品选型">
      <div class="field">
        <label for="f-scenario">应用场景 *</label>
        <select id="f-scenario" name="scenario" required>
          <option value="">请选择应用场景</option>
          {
            scenarioOpts.map((o) => (
              <option value={o.value}>{o.label}</option>
            ))
          }
        </select>
      </div>
      <div class="field">
        <label for="f-cure">固化方式</label>
        <select id="f-cure" name="cure">
          {cureOpts.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
      </div>
      <div class="field field-wide">
        <label for="f-material">适用基材（可选，多个用空格分隔）</label>
        <input
          id="f-material"
          name="material"
          type="text"
          placeholder="如：铝 碳纤维 FRP"
          autocomplete="off"
        />
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">开始选型</button>
        <button type="reset" class="btn" id="btn-reset">重置</button>
      </div>
    </form>

    <p class="hint" id="form-hint" hidden>请先选择「应用场景」，然后点击「开始选型」。</p>

    <div class="results-head" id="results-head" hidden>
      <h2>推荐结果</h2>
      <span class="results-count" id="results-count"></span>
    </div>

    <div class="grid" id="results" aria-live="polite"></div>

    <p class="empty" id="empty-hint" hidden>暂无匹配产品，请放宽筛选条件或<a href="/products">浏览全部产品</a>。</p>
  </section>

  <script type="application/json" set:html={dataJson} id="selector-data"></script>
  <script>
    const data = JSON.parse(
      (document.getElementById('selector-data') as HTMLScriptElement).textContent || '[]'
    );
    const form = document.getElementById('selector-form') as HTMLFormElement;
    const hint = document.getElementById('form-hint') as HTMLElement;
    const results = document.getElementById('results') as HTMLElement;
    const resultsHead = document.getElementById('results-head') as HTMLElement;
    const resultsCount = document.getElementById('results-count') as HTMLElement;
    const emptyHint = document.getElementById('empty-hint') as HTMLElement;

    function scoreProduct(p: any, sel: { scenario: string; cure: string; material: string }) {
      let score = 0;
      const reasons: string[] = [];
      if (sel.scenario && p.scenario === sel.scenario) { score += 3; reasons.push('场景匹配'); }
      if (sel.cure && p.cureType === sel.cure) { score += 2; reasons.push('固化匹配'); }
      if (sel.material) {
        const tokens = sel.material
          .trim()
          .split(/[\s,，、/]+/)
          .filter(Boolean)
          .map((t) => t.toLowerCase());
        const bm = (p.baseMaterial || '').toLowerCase();
        if (tokens.some((t) => bm.includes(t))) { score += 2; reasons.push('基材匹配'); }
      }
      return { score, reasons };
    }

    function render(sel: { scenario: string; cure: string; material: string }) {
      if (!sel.scenario) {
        hint.hidden = false;
        resultsHead.hidden = true;
        results.innerHTML = '';
        emptyHint.hidden = true;
        return;
      }
      hint.hidden = true;

      const ranked = data
        .map((p: any) => ({ p, ...scoreProduct(p, sel) }))
        .filter((r: any) => r.score > 0)
        .sort((a: any, b: any) => b.score - a.score);

      resultsHead.hidden = false;
      resultsCount.textContent = `共 ${ranked.length} 款匹配`;

      if (ranked.length === 0) {
        results.innerHTML = '';
        emptyHint.hidden = false;
        return;
      }
      emptyHint.hidden = true;

      results.innerHTML = ranked
        .map((r: any, i: number) => {
          const p = r.p;
          const cover = p.cover
            ? p.cover.startsWith('/')
              ? p.cover
              : `/uploads/${p.cover}`
            : '';
          const matchTag =
            i === 0
              ? '<span class="tag tag-match">最佳匹配</span>'
              : `<span class="tag tag-plain">匹配度 ${r.score}</span>`;
          const meta = [p.categoryLabel, p.scenarioLabel, p.cureLabel]
            .filter(Boolean)
            .map((m) => `<span class="tag tag-plain">${m}</span>`)
            .join('');
          return `
            <article class="card">
              <a class="card-link" href="/products/${p.slug}">
                ${
                  cover
                    ? `<div class="card-media card-media-sm"><img src="${cover}" alt="${p.name}" loading="lazy" /></div>`
                    : `<div class="card-media card-media-sm card-media-empty"></div>`
                }
                <div class="card-body">
                  <div class="card-meta" style="margin:0 0 6px">${matchTag}</div>
                  <h2 class="card-title">${p.name}</h2>
                  ${p.model ? `<p class="card-model">${p.model}</p>` : ''}
                  ${p.excerpt ? `<p class="card-excerpt">${p.excerpt}</p>` : ''}
                  ${r.reasons.length ? `<div class="card-meta">${r.reasons.map((x: string) => `<span class="tag tag-plain">${x}</span>`).join('')}</div>` : ''}
                  <div class="card-meta">${meta}</div>
                </div>
              </a>
            </article>`;
        })
        .join('');
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      render({
        scenario: (fd.get('scenario') as string) || '',
        cure: (fd.get('cure') as string) || '',
        material: (fd.get('material') as string) || '',
      });
    });
    form.addEventListener('reset', () => {
      hint.hidden = true;
      resultsHead.hidden = true;
      results.innerHTML = '';
      emptyHint.hidden = true;
    });

    // 初始化：若已选场景则直接出结果
    const initSel = (new FormData(form).get('scenario') as string) || '';
    if (initSel) render({ scenario: initSel, cure: '', material: '' });
  </script>
</Base>

<style>
  .selector-form {
    max-width: 820px;
    margin: 0 auto 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 18px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .selector-form .field { display: flex; flex-direction: column; gap: 6px; flex: 1 1 220px; }
  .selector-form .field-wide { flex: 1 1 100%; }
  .selector-form label { font-size: 13px; font-weight: 600; color: var(--fg-soft); }
  .selector-form select,
  .selector-form input {
    font: inherit;
    font-size: 14px;
    padding: 11px 13px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--fg);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .selector-form select:focus,
  .selector-form input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .form-actions { display: flex; gap: 12px; align-items: center; margin-left: auto; }

  .results-head { display: flex; align-items: baseline; gap: 12px; margin: 10px 0 18px; }
  .results-head h2 { font-size: 21px; margin: 0; color: var(--fg); }
  .results-count { color: var(--muted); font-size: 13px; }

  .tag-match { background: var(--accent); color: var(--on-accent); }

  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .card:hover .card-title { color: var(--accent); }
  .card-media-empty { background: linear-gradient(135deg, var(--g3), var(--g1)); }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .form-actions { margin-left: 0; width: 100%; }
    .form-actions .btn { flex: 1; }
  }
</style>
