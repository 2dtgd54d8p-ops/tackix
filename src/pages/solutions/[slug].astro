---
import SolutionsDetail from '../../components/pages/SolutionsDetail.astro';
import { makeReader } from '../../lib/content-reader';

// 静态预渲染：枚举所有已发布场景生成对应 HTML（中文版 /）。
export async function getStaticPaths() {
  const reader = makeReader();
  let slugs: string[] = [];
  try {
    slugs = await reader.collections.scenarios.list();
  } catch {
    slugs = [];
  }
  const out: { params: { slug: string } }[] = [];
  for (const slug of slugs) {
    try {
      const item = await reader.collections.scenarios.read(slug);
      if (item && item.published !== false) out.push({ params: { slug } });
    } catch {
      /* 跳过读取失败的单篇 */
    }
  }
  return out;
}
---

<SolutionsDetail locale="zh-CN" slug={Astro.params.slug!} />
