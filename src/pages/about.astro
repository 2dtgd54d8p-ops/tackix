---
import Base from '../layouts/Base.astro';
import { loadSiteData, loadContent } from '../lib/site-data';
import { organizationSchema } from '../lib/schema';
import { coverSrc } from '../lib/markdown';
import { getLocale, type Locale } from '../lib/i18n';

const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocale(Astro);
const lp = locale === 'en' ? '/en' : '';
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);

const L = await loadContent(locale);
const about = L.about;
const { site } = await loadSiteData(locale);
const certBadges = site.certBadges ?? [];
const factoryImage = coverSrc(about.factoryImage);
const orgLd = {
  '@context': 'https://schema.org',
  ...organizationSchema(locale, site, Astro.site ?? Astro.url),
};
---

<Base title={about.pageTitle} description={about.pageSub}>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <section>
    <div class="page-head">
      <h1>{about.pageTitle}</h1>
      <p>{about.pageSub}</p>
    </div>

    <article class="prose about">
      <h2>{about.storyTitle}</h2>
      <p>{about.storyBody}</p>

      <h2>{about.missionTitle}</h2>
      <p>{about.missionBody}</p>

      {
        factoryImage && (
          <figure class="factory">
            <img src={factoryImage} alt="" />
            {about.factoryCaption && <figcaption>{about.factoryCaption}</figcaption>}
          </figure>
        )
      }
    </article>

    {
      certBadges.length > 0 && (
        <section class="certs">
          <h2>{t('认证与信任', 'Certifications & Trust')}</h2>
          <div class="badges">
            {certBadges.map((b) => (
              <div class="badge">
                <span class="badge-label">{b.label}</span>
                {b.note && <span class="badge-note">{b.note}</span>}
              </div>
            ))}
          </div>
        </section>
      )
    }

    <div class="about-cta">
      <a class="btn btn-primary" href={`${lp}/contact`}>{t('联系我们获取报价', 'Contact us for quotation')}</a>
    </div>
  </section>
</Base>

<style>
  article.about { max-width: var(--readw); margin: 0 auto; }
  article.about h2 { margin-top: 34px; }
  .factory {
    margin: 28px 0 0;
    text-align: center;
  }
  .factory img {
    width: 100%;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-md);
    display: block;
  }
  .factory figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--faint);
  }
  .certs {
    max-width: var(--readw);
    margin: 48px auto 0;
    text-align: center;
  }
  .certs h2 { font-size: 22px; margin: 0 0 20px; }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }
  .badge {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 22px;
    min-width: 140px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .badge-label { font-size: 15px; font-weight: 700; color: var(--fg); }
  .badge-note { font-size: 12.5px; color: var(--faint); line-height: 1.5; }
  .about-cta { text-align: center; margin-top: 40px; }
</style>
