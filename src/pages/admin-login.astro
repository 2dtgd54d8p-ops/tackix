---
// 极简后台登录页（静态预渲染）。输入管理口令 → POST /api/admin-login →
// 成功后跳转 /keystatic。浏览器全程不接触 github.com，无需外网代理。
const siteName = 'Tackix';
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>内容后台登录 · {siteName}</title>
    <style>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; display: grid; place-items: center;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
        background: #f5f6f8; color: #1c2330;
      }
      .card {
        width: min(92vw, 380px); background: #fff; border: 1px solid #e6e8ec;
        border-radius: 14px; padding: 32px 28px; box-shadow: 0 8px 30px rgba(20,30,50,.08);
      }
      h1 { margin: 0 0 4px; font-size: 20px; }
      .sub { margin: 0 0 22px; font-size: 13px; color: #5b6472; line-height: 1.5; }
      label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
      input[type="password"] {
        width: 100%; padding: 11px 12px; font-size: 15px; border: 1px solid #cdd2da;
        border-radius: 9px; outline: none; transition: border-color .15s;
      }
      input[type="password"]:focus { border-color: #2563eb; }
      button {
        width: 100%; margin-top: 16px; padding: 11px 12px; font-size: 15px; font-weight: 600;
        color: #fff; background: #2563eb; border: 0; border-radius: 9px; cursor: pointer;
        transition: background .15s;
      }
      button:hover { background: #1d4ed8; }
      button:disabled { background: #9db4e8; cursor: not-allowed; }
      .msg { min-height: 18px; margin: 12px 0 0; font-size: 13px; color: #d23f3f; }
      .ok { color: #1a9d5a; }
    </style>
  </head>
  <body>
    <main class="card">
      <h1>{siteName} 内容后台</h1>
      <p class="sub">输入管理口令以登录。无需 GitHub 账号，不依赖外网代理。</p>
      <form id="login" novalidate>
        <label for="pw">管理口令</label>
        <input type="password" id="pw" name="password" placeholder="请输入口令" autocomplete="current-password" required />
        <button type="submit" id="btn">登录</button>
        <p class="msg" id="msg" role="alert"></p>
      </form>
    </main>

    <script>
      const form = document.getElementById('login');
      const pw = document.getElementById('pw');
      const btn = document.getElementById('btn');
      const msg = document.getElementById('msg');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        msg.textContent = '登录中…';
        msg.classList.remove('ok');
        btn.disabled = true;
        try {
          const res = await fetch('/api/admin-login', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ password: pw.value }),
          });
          const data = await res.json().catch(() => ({}));
          if (res.ok && data.ok) {
            msg.textContent = '登录成功，正在进入后台…';
            msg.classList.add('ok');
            // 等待 cookie 落盘后整页跳转；/keystatic 读取该 cookie 即视为已登录
            setTimeout(() => { window.location.href = '/keystatic'; }, 150);
          } else {
            msg.textContent = data.error || '登录失败';
            btn.disabled = false;
          }
        } catch (err) {
          msg.textContent = '网络错误，请重试';
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>
