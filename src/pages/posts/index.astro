---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import { loadSiteData, buildFilterOptions } from '../../lib/site-data';

const reader = createReader(process.cwd(), keystaticConfig);
let slugs = [];
try {
  slugs = await reader.collections.posts.list();
} catch (e) {
  console.warn('[build] 读取文章列表失败：', e);
}

const posts = (
  await Promise.all(
    slugs.map(async (slug) => {
      try {
        const post = await reader.collections.posts.read(slug);
        return post && post.published !== false ? { slug, ...post } : null;
      } catch (e) {
        return null;
      }
    })
  )
).filter(Boolean);

posts.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

// 与首页共用同一套分类数据与筛选逻辑，避免两页表现不一致
const { categories, categoryLabel, tagLabel } = await loadSiteData();
const filterOptions = buildFilterOptions(posts, categories);
---

<Base title="文章">
  <section>
    <div class="page-head">
      <h1>全部文章</h1>
      <p>共 {posts.length} 篇 · 记录技术、实践与思考</p>
    </div>

    {
      filterOptions.length > 1 && (
        <nav class="filters" id="cat-filter" aria-label="按分类筛选文章">
          {filterOptions.map((c, i) => (
            <button
              type="button"
              class={`filter-btn${i === 0 ? ' is-active' : ''}`}
              data-filter={c.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {c.label}
            </button>
          ))}
        </nav>
      )
    }

    {
      posts.length === 0 ? (
        <p class="empty">还没有文章。</p>
      ) : (
        <div class="grid">
          {posts.map((post) => (
            <article class="card" data-category={post.category ?? 'uncategorized'}>
              {post.cover && (
                <div class="card-media card-media-sm">
                  <img src={post.cover} alt="" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <h2 class="card-title">
                  <a href={`/posts/${post.slug}`}>{post.title}</a>
                </h2>
                {post.excerpt && <p class="card-excerpt">{post.excerpt}</p>}
                <div class="card-meta">
                  <span class="tag">{categoryLabel(post.category)}</span>
                  {(post.tags ?? []).slice(0, 2).map((t) => (
                    <span class="tag tag-plain">{tagLabel(t)}</span>
                  ))}
                  {post.publishedAt && <span>{post.publishedAt}</span>}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
    <p class="empty" data-empty hidden>该分类下暂无文章。</p>
  </section>

  <script>
    // 分类筛选：纯前端过滤，与首页行为一致
    const bar = document.getElementById('cat-filter');
    const grid = document.querySelector('.grid');
    const emptyHint = document.querySelector('[data-empty]');
    if (bar && grid) {
      const cards = Array.from(grid.querySelectorAll('.card'));
      bar.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;
        const value = btn.getAttribute('data-filter');
        bar.querySelectorAll('.filter-btn').forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        let visible = 0;
        cards.forEach((c) => {
          const show = value === 'all' || c.getAttribute('data-category') === value;
          c.hidden = !show;
          if (show) visible += 1;
        });
        if (emptyHint) emptyHint.hidden = visible > 0;
      });
    }
  </script>
</Base>

<style>
  .filters { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin: -8px 0 30px; }
  .filter-btn {
    padding: 7px 18px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .filter-btn:hover { border-color: var(--accent); color: var(--accent); }
  .filter-btn.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .filters { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; justify-content: flex-start; }
    .filter-btn { white-space: nowrap; }
  }
</style>
