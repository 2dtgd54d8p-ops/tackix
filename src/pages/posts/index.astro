---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import { loadSiteData, buildFilterOptions } from '../../lib/site-data';

const reader = createReader(process.cwd(), keystaticConfig);
let slugs = [];
try {
  slugs = await reader.collections.posts.list();
} catch (e) {
  console.warn('[build] 读取文章列表失败：', e);
}

const posts = (
  await Promise.all(
    slugs.map(async (slug) => {
      try {
        const post = await reader.collections.posts.read(slug);
        return post && post.published !== false ? { slug, ...post } : null;
      } catch (e) {
        return null;
      }
    })
  )
).filter(Boolean);

posts.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

// 与首页共用同一套分类数据与筛选逻辑，避免两页表现不一致
const { categories, categoryLabel, tagLabel } = await loadSiteData();
const filterOptions = buildFilterOptions(posts, categories);
---

<Base title="文章">
  <section>
    <h1>全部文章</h1>
    <p class="list-count">共 {posts.length} 篇</p>

    {
      filterOptions.length > 1 && (
        <nav class="filters" id="cat-filter" aria-label="按分类筛选文章">
          {filterOptions.map((c, i) => (
            <button
              type="button"
              class={`filter-btn${i === 0 ? ' is-active' : ''}`}
              data-filter={c.value}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {c.label}
            </button>
          ))}
        </nav>
      )
    }

    {
      posts.length === 0 ? (
        <p class="empty">还没有文章。</p>
      ) : (
        <div class="grid">
          {posts.map((post) => (
            <article class="card" data-category={post.category ?? 'uncategorized'}>
              {post.cover && (
                <div class="card-media card-media-sm">
                  <img src={post.cover} alt="" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <h2 class="card-title">
                  <a href={`/posts/${post.slug}`}>{post.title}</a>
                </h2>
                {post.excerpt && <p class="card-excerpt">{post.excerpt}</p>}
                <div class="card-meta">
                  <span class="tag">{categoryLabel(post.category)}</span>
                  {(post.tags ?? []).slice(0, 2).map((t) => (
                    <span class="tag tag-plain">{tagLabel(t)}</span>
                  ))}
                  {post.publishedAt && <span>{post.publishedAt}</span>}
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
    <p class="empty" data-empty hidden>该分类下暂无文章。</p>
  </section>

  <script>
    // 分类筛选：纯前端过滤，与首页行为一致
    const bar = document.getElementById('cat-filter');
    const grid = document.querySelector('.grid');
    const emptyHint = document.querySelector('[data-empty]');
    if (bar && grid) {
      const cards = Array.from(grid.querySelectorAll('.card'));
      bar.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;
        const value = btn.getAttribute('data-filter');
        bar.querySelectorAll('.filter-btn').forEach((b) => {
          const on = b === btn;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        let visible = 0;
        cards.forEach((c) => {
          const show = value === 'all' || c.getAttribute('data-category') === value;
          c.hidden = !show;
          if (show) visible += 1;
        });
        if (emptyHint) emptyHint.hidden = visible > 0;
      });
    }
  </script>
</Base>

<style>
  h1 { margin: 0 0 4px; font-size: 24px; font-weight: 600; }
  .list-count { margin: 0 0 4px; color: var(--muted); font-size: 13px; }

  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin: 20px 0 8px; }
  .filter-btn {
    padding: 4px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  .filter-btn:hover { border-color: #cfd4da; }
  .filter-btn.is-active { background: var(--fg); border-color: var(--fg); color: #fff; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 18px;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
    overflow: hidden;
  }
  .card[hidden] { display: none; }
  .card-media-sm { aspect-ratio: 16 / 9; background: #f2f4f6; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-body { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; flex: 1; }
  .card-title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.4; }
  .card-title a { color: var(--fg); }
  .card-excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 6px;
    color: #9aa1a9;
    font-size: 12px;
  }
  .tag { padding: 2px 8px; border-radius: 6px; background: #eef3f8; color: #185fa5; }
  .tag-plain { background: #f2f4f6; color: #6b7280; }
  .empty { color: var(--muted); padding: 32px 0; text-align: center; }
  .empty[hidden] { display: none; }

  @media (max-width: 640px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .filters { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 4px; }
    .filter-btn { white-space: nowrap; }
  }
</style>
