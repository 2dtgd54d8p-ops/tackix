---
import { createReader } from '@keystatic/core/reader';
import { marked } from 'marked';
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { loadSiteData } from '../../lib/site-data';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  let slugs = [];
  try {
    slugs = await reader.collections.posts.list();
  } catch (e) {
    console.warn('[build] 读取文章列表失败（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
  }
  const entries = await Promise.all(
    slugs.map(async (slug) => {
      try {
        const post = await reader.collections.posts.read(slug);
        // 未发布（published === false）的文章不生成静态页
        return post && post.published !== false
          ? { params: { slug }, props: { post } }
          : null;
      } catch (e) {
        console.warn('[build] 读取文章失败：', slug, e);
        return null;
      }
    })
  );
  return entries.filter(Boolean);
}

const { post } = Astro.props;
const html = marked(post.body ?? '');

// 分类/标签中文名从后台管理的 singleton 读取；读不到自动回落默认值。
const { categoryLabel, tagLabel } = await loadSiteData();
const categoryName = post.category && post.category !== 'uncategorized'
  ? categoryLabel(post.category)
  : null;
const tagNames = Array.isArray(post.tags)
  ? post.tags.map((t) => tagLabel(t)).filter(Boolean)
  : [];
---

<Base title={post.title}>
  <article class="prose">
    <header class="post-head">
      {categoryName && <span class="badge">{categoryName}</span>}
      <h1>{post.title}</h1>
      {post.publishedAt && <p class="post-meta">{post.publishedAt}</p>}
    </header>
    {
      post.cover && (
        <img
          class="cover"
          src={post.cover.startsWith('/') ? post.cover : `/uploads/${post.cover}`}
          alt={post.title}
        />
      )
    }
    <div set:html={html} />
    {
      tagNames.length > 0 && (
        <div class="tags">
          {tagNames.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }
  </article>
  <Comments />
</Base>

<style>
  .post-head {
    text-align: center;
    margin-bottom: 30px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .post-head h1 { font-size: 36px; }
  .post-head .badge { margin-bottom: 14px; }
  .post-meta { margin: 0; color: var(--muted); font-size: 13.5px; }
  .tags {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  @media (max-width: 700px) {
    .post-head h1 { font-size: 27px; }
  }
</style>
