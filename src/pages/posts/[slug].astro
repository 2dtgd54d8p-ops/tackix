---
import { createReader } from '@keystatic/core/reader';
import { marked } from 'marked';
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { loadSiteData } from '../../lib/site-data';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  let slugs = [];
  try {
    slugs = await reader.collections.posts.list();
  } catch (e) {
    console.warn('[build] 读取文章列表失败（检查 KEYSTATIC_GITHUB_TOKEN 是否有效）：', e);
  }
  const entries = await Promise.all(
    slugs.map(async (slug) => {
      try {
        const post = await reader.collections.posts.read(slug);
        // 未发布（published === false）的文章不生成静态页
        return post && post.published !== false
          ? { params: { slug }, props: { post } }
          : null;
      } catch (e) {
        console.warn('[build] 读取文章失败：', slug, e);
        return null;
      }
    })
  );
  return entries.filter(Boolean);
}

const { post } = Astro.props;
const slug = Astro.params.slug;   // 用于 hreflang 互指
const html = marked(post.body ?? '');

// 分类/标签/应用场景/决策阶段中文名从后台管理的 singleton 读取；读不到自动回落默认值。
const { site, categoryLabel, tagLabel, scenarioLabel, stageLabel } = await loadSiteData();
const siteTitle = site.title;
const base = Astro.site ?? new URL('https://tackix.pages.dev');
const canonical = new URL(Astro.url.pathname, base).href;

const categoryName =
  post.category && post.category !== 'uncategorized' ? categoryLabel(post.category) : null;
const tagNames = Array.isArray(post.tags)
  ? post.tags.map((t: string) => tagLabel(t)).filter(Boolean)
  : [];
const scenarioName = scenarioLabel(post.scenario);
const stageName = stageLabel(post.stage);

// SEO 关键词：标签 + 应用场景 + 决策阶段
const keywords = [...tagNames, scenarioName, stageName].filter(Boolean);

// Article / BlogPosting 结构化数据（利于 Google / Bing / AI 检索体理解正文）
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt || '',
  datePublished: post.publishedAt || undefined,
  dateModified: post.publishedAt || undefined,
  author: { '@type': 'Organization', name: siteTitle },
  publisher: {
    '@type': 'Organization',
    name: siteTitle,
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', base).href },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: keywords.join(', '),
  ...(scenarioName ? { articleSection: scenarioName } : {}),
};

// FAQPage 结构化数据（FAQ 区块存在时生成，直接喂给搜索/AI 的问答抽取）
const faqSchema =
  Array.isArray(post.faq) && post.faq.length
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faq.map((f: { question?: string; answer?: string }) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;
---

<Base
  title={post.title}
  description={post.excerpt}
  type="article"
  publishedTime={post.publishedAt}
  keywords={keywords}
  alternates={[
    { lang: 'zh-CN', href: `/posts/${slug}/` },
    { lang: 'en', href: `/en/posts/${slug}/` },
    { lang: 'x-default', href: `/en/posts/${slug}/` },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>
  <article class="prose">
    <header class="post-head">
      {categoryName && <span class="badge">{categoryName}</span>}
      <h1>{post.title}</h1>
      {(scenarioName || stageName) && (
        <div class="post-badges">
          {scenarioName && <span class="badge badge-scenario">场景：{scenarioName}</span>}
          {stageName && <span class="badge badge-stage">阶段：{stageName}</span>}
        </div>
      )}
      {post.publishedAt && <p class="post-meta">{post.publishedAt}</p>}
    </header>
    {
      post.cover && (
        <img
          class="cover"
          src={post.cover.startsWith('/') ? post.cover : `/uploads/${post.cover}`}
          alt={post.title}
        />
      )
    }
    <div set:html={html} />
    {
      post.faq && post.faq.length > 0 && (
        <section class="post-faq" aria-label="常见问题">
          <h2>常见问题（FAQ）</h2>
          <div class="faq-list">
            {post.faq.map((f: { question?: string; answer?: string }) => (
              <details class="faq-item">
                <summary>{f.question}</summary>
                <p class="faq-a">{f.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }
    {
      tagNames.length > 0 && (
        <div class="tags">
          {tagNames.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }
  </article>
  <Comments />
</Base>

<style>
  .post-head {
    text-align: center;
    margin-bottom: 30px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .post-head h1 { font-size: 36px; }
  .post-head .badge { margin-bottom: 14px; }
  .post-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin: 12px 0 0;
  }
  .post-badges .badge { margin-bottom: 0; }
  .badge-scenario { background: color-mix(in srgb, var(--g1) 18%, transparent); color: var(--g1); }
  .badge-stage { background: color-mix(in srgb, var(--g2) 18%, transparent); color: var(--g2); }
  .post-meta { margin: 12px 0 0; color: var(--muted); font-size: 13.5px; }

  /* FAQ 区块 */
  .post-faq {
    margin: 38px 0 10px;
    padding: 22px 22px 8px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .post-faq h2 {
    font-size: 20px;
    margin: 0 0 14px;
    text-align: left;
  }
  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    padding: 0 16px;
    transition: border-color var(--dur) var(--ease);
  }
  .faq-item[open] { border-color: var(--accent); }
  .faq-item summary {
    cursor: pointer;
    padding: 14px 0;
    font-weight: 600;
    color: var(--fg);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    font-size: 20px;
    line-height: 1;
    color: var(--accent);
    flex: none;
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-a {
    margin: 0;
    padding: 0 0 16px;
    color: var(--muted);
    line-height: 1.8;
  }

  .tags {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
  }
  @media (max-width: 700px) {
    .post-head h1 { font-size: 27px; }
  }
</style>
