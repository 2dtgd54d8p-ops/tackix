---
import { makeReader } from '../../lib/content-reader';
import Base from '../../layouts/Base.astro';
import { loadSiteData, loadContent, buildFilterOptions } from '../../lib/site-data';
import { readingMinutes, coverSrc } from '../../lib/markdown';
import { getLocale, pickB, type Locale, type Bilingual } from '../../lib/i18n';
import { freshnessInfo } from '../../lib/freshness';

const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocale(Astro);
const lp = locale === 'en' ? '/en' : '';
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);

const reader = makeReader();
const L = await loadContent(locale);
const pages = L.pages;

let slugs: string[] = [];
try {
  slugs = await reader.collections.knowledge.list();
} catch (e) {
  console.warn('[build] knowledge list failed:', e);
}

const posts = (
  await Promise.all(
    slugs.map(async (slug) => {
      try {
        const p = await reader.collections.knowledge.read(slug);
        return p ? { slug, ...p } : null;
      } catch {
        return null;
      }
    })
  )
).filter((p) => p && p.published !== false);

const withMeta = posts.map((p) => ({
  ...p,
  readMin: readingMinutes(pickB(locale, p.body)),
  fresh: freshnessInfo(p.publishedAt, locale),
}));
withMeta.sort((a, b) => String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? '')));

const { categories, categoryLabel, tagLabel } = await loadSiteData(locale);

// 场景标签映射（scenario slug → 本地化名称），用于「按场景筛选」与卡片标注
const scenarioMap = new Map<string, string>();
try {
  const sSlugs = await reader.collections.scenarios.list();
  await Promise.all(
    sSlugs.map(async (s: string) => {
      try {
        const sc: any = await reader.collections.scenarios.read(s);
        if (sc && sc.published !== false)
          scenarioMap.set(s, pickB(locale, (sc.name as Bilingual) ?? ({ zh: s, en: s } as Bilingual)));
      } catch {
        /* 忽略单个场景读取失败 */
      }
    })
  );
} catch {
  /* 场景集合不可用时降级为无场景筛选 */
}
// 仅展示「确实有文章关联」的场景，避免出现空筛选项
const usedScenarios = new Set(
  withMeta.map((p: any) => p.scenario).filter((v: any) => v && v !== 'none')
);
const scenarioOptions = [
  { value: 'all', label: locale === 'en' ? 'All scenarios' : '全部场景' },
  ...[...scenarioMap.entries()]
    .filter(([value]) => usedScenarios.has(value))
    .map(([value, label]) => ({ value, label })),
];
const scenarioLabel = (v: string) => scenarioMap.get(v) || v;

// 服务端分类筛选项（链接式，SEO 友好）
const catOptions = buildFilterOptions(withMeta, categories);
---

<Base title={pages.knowledgeTitle} description={pages.knowledgeSub}>
  <section>
    <div class="page-head">
      <h1>{pages.knowledgeTitle}</h1>
      <p>
        {pages.knowledgeSub.split('{n}')[0]}
        <span id="kb-count">{withMeta.length}</span>
        {pages.knowledgeSub.split('{n}')[1]}
      </p>
    </div>

    <!-- 内容类型切换：案例库、资料下载均从主导航降级到这里（与「全部文章」并列的 tab 组） -->
    <nav class="kb-tabs" aria-label={t('内容类型', 'Content type')}>
      <a class="kb-tab is-active" href={`${lp}/knowledge`}>{t('全部文章', 'All articles')}</a>
      <a class="kb-tab" href={`${lp}/cases`}>{t('案例库', 'Case Studies')}</a>
      <a class="kb-tab" href={`${lp}/downloads`}>{t('资料下载', 'Downloads')}</a>
    </nav>

    <!-- L6 AI 问答入口：纯前端，后端（Workers AI + Vectorize）缺失时优雅提示 -->
    <section class="ask-box" aria-label={t('AI 问答', 'AI Q&A')}>
      <div class="ask-row">
        <input
          id="ask-q"
          class="ask-input"
          placeholder={t('用自然语言提问，例如：厨卫接缝该用什么胶？', 'Ask in natural language, e.g. what sealant for kitchen joints?')}
        />
        <button id="ask-btn" class="ask-btn" type="button">{t('问 AI', 'Ask AI')}</button>
      </div>
      <div id="ask-ans" class="ask-ans" hidden></div>
    </section>

    <!-- 场景筛选条：按 4 大场景定位推荐方案（客户端即时筛选，静态站也可用） -->
    {
      scenarioOptions.length > 1 && (
        <div class="filter-bar kb-filter" role="group" aria-label={t('按场景筛选', 'Filter by scenario')}>
          {scenarioOptions.map((s) => (
            <button
              type="button"
              class="chip"
              data-filter="scenario"
              data-value={s.value}
              aria-pressed="false"
            >
              {s.label}
            </button>
          ))}
        </div>
      )
    }

    <!-- 分类筛选条 -->
    <div class="filter-bar kb-filter" role="group" aria-label={t('按分类筛选', 'Filter by category')}>
      {
        catOptions.map((c) => (
          <button
            type="button"
            class="chip"
            data-filter="cat"
            data-value={c.value}
            aria-pressed="false"
          >
            {c.label}
          </button>
        ))
      }
    </div>

    {
      withMeta.length === 0 ? (
        <p class="empty">{t('暂无文章。', 'No articles yet.')}</p>
      ) : (
        <div class="grid" id="kb-grid">
          {withMeta.map((post) => (
            <article
              class="card"
              data-category={post.category ?? 'uncategorized'}
              data-scenario={post.scenario ?? 'none'}
              data-tags={(post.tags ?? []).join(',')}
            >
              {coverSrc(post.cover) && (
                <div class="card-media card-media-sm">
                  <img src={coverSrc(post.cover)} alt="" loading="lazy" />
                </div>
              )}
              <div class="card-body">
                <h3 class="card-title">
                  <a href={`${lp}/knowledge/${post.slug}`}>{pickB(locale, post.name)}</a>
                </h3>
                {post.excerpt && <p class="card-excerpt">{pickB(locale, post.excerpt)}</p>}
                <div class="card-meta">
                  {post.scenario && post.scenario !== 'none' && (
                    <span class="tag tag-scenario">{scenarioLabel(post.scenario)}</span>
                  )}
                  <span class="tag">{categoryLabel(post.category)}</span>
                  {(post.tags ?? []).slice(0, 2).map((tg: string) => (
                    <span class="tag tag-plain">{tagLabel(tg)}</span>
                  ))}
                  {post.fresh && (
                    <span class={`tag tag-fresh level-${post.fresh.level}`}>{post.fresh.label}</span>
                  )}
                  <span class="read-time">· {post.readMin}{t(' 分钟阅读', ' min read')}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>
</Base>

<script is:inline>
  (function () {
    var grid = document.getElementById('kb-grid');
    if (!grid) return;
    var chips = Array.prototype.slice.call(document.querySelectorAll('.kb-filter [data-filter]'));
    var countEl = document.getElementById('kb-count');
    var total = grid.querySelectorAll('.card').length;

    function getParam(name) {
      try {
        return new URLSearchParams(location.search).get(name) || 'all';
      } catch (e) {
        return 'all';
      }
    }
    var state = { cat: getParam('cat'), scenario: getParam('scenario'), tag: getParam('tag') };

    function apply() {
      var cards = grid.querySelectorAll('.card');
      var visible = 0;
      cards.forEach(function (card) {
        var okCat = state.cat === 'all' || card.getAttribute('data-category') === state.cat;
        var okSc =
          state.scenario === 'all' || card.getAttribute('data-scenario') === state.scenario;
        var okTag =
          state.tag === 'all' ||
          (card.getAttribute('data-tags') || '').split(',').indexOf(state.tag) >= 0;
        var show = okCat && okSc && okTag;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (countEl) countEl.textContent = String(visible);
      chips.forEach(function (chip) {
        var f = chip.getAttribute('data-filter');
        var v = chip.getAttribute('data-value');
        var active = state[f] === v;
        chip.classList.toggle('is-active', active);
        chip.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var f = chip.getAttribute('data-filter');
        var v = chip.getAttribute('data-value');
        state[f] = v;
        var params = new URLSearchParams();
        if (state.cat !== 'all') params.set('cat', state.cat);
        if (state.scenario !== 'all') params.set('scenario', state.scenario);
        var qs = params.toString();
        try {
          history.replaceState(null, '', qs ? location.pathname + '?' + qs : location.pathname);
        } catch (e) {}
        apply();
      });
    });

    apply();
  })();
</script>

<script is:inline>
  (function () {
    var input = document.getElementById('ask-q');
    var btn = document.getElementById('ask-btn');
    var ans = document.getElementById('ask-ans');
    if (!input || !btn || !ans) return;
    function ask() {
      var q = input.value.trim();
      if (!q) return;
      ans.hidden = false;
      ans.textContent = '…';
      btn.disabled = true;
      fetch('/api/ask', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ question: q }),
      })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          ans.innerHTML = '';
          var p = document.createElement('p');
          p.textContent = d.answer || '（无回答）';
          ans.appendChild(p);
          if (d.sources && d.sources.length) {
            var cap = document.createElement('p');
            cap.className = 'ask-src';
            cap.textContent = t_src() + d.sources.join(', ');
            ans.appendChild(cap);
          }
        })
        .catch(function () {
          ans.textContent = t_fallback();
        })
        .finally(function () { btn.disabled = false; });
    }
    function t_src() { return document.documentElement.lang === 'en' ? 'Sources: ' : '参考：'; }
    function t_fallback() {
      return document.documentElement.lang === 'en'
        ? 'AI Q&A requires backend (Workers AI + Vectorize) enabled.'
        : 'AI 问答需部署后端（Workers AI + Vectorize）后启用。';
    }
    btn.addEventListener('click', ask);
    input.addEventListener('keydown', function (e) { if (e.key === 'Enter') ask(); });
  })();
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin: -8px 0 36px;
  }
  /* 内容类型切换 tab（案例库从主导航降级到此处） */
  .kb-tabs { display: flex; gap: 8px; justify-content: center; margin: 0 0 22px; }
  .kb-tab {
    padding: 8px 20px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--fg-soft);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    background: var(--surface);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .kb-tab:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .kb-tab.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .kb-filter:first-of-type { margin-top: 4px; }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 7px 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--fg-soft);
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .chip:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }
  .chip.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  /* 场景徽章：用强调色区分「所属场景」，帮助访客一眼定位推荐方案 */
  .tag-scenario {
    background: var(--accent-soft);
    color: var(--accent-strong);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }
  /* 新鲜度徽章（L4①）：新鲜=绿，较旧=琥珀，未标注=灰 */
  .tag-fresh { font-variant-numeric: tabular-nums; }
  .tag-fresh.level-fresh { background: var(--success-bg); color: var(--success); border-color: color-mix(in srgb, var(--success) 30%, transparent); }
  .tag-fresh.level-stale { background: color-mix(in srgb, #e8a33d 16%, var(--surface)); color: #b9791f; border-color: color-mix(in srgb, #e8a33d 34%, transparent); }
  .tag-fresh.level-ok { background: var(--surface-2); color: var(--muted); border-color: var(--border); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
  .empty { text-align: center; color: var(--muted); padding: 44px 0; }
  @media (max-width: 700px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 18px; } }

  /* AI 问答入口（L6） */
  .ask-box {
    max-width: 720px;
    margin: 0 auto 28px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .ask-row { display: flex; gap: 10px; }
  .ask-input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--fg);
    font-family: inherit;
    font-size: 14px;
  }
  .ask-btn {
    border: 0;
    background: var(--accent);
    color: #fff;
    border-radius: var(--r-md);
    padding: 0 20px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
  }
  .ask-ans { margin-top: 14px; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .ask-ans p { margin: 0 0 8px; }
  .ask-src { font-size: 12px; color: var(--faint); }
</style>
