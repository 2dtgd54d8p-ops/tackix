---
// 通用编辑页：根据 src/lib/admin-schema.ts 的字段描述递归渲染表单，
// 提交时把值还原成与 D1 `data` 列同构的对象。受 middleware 守卫。
// 设为 SSR：请求期由 middleware 守卫，构建期不再被预渲染成跳转残页。
export const prerender = false;
import { SCHEMAS } from '../../lib/admin-schema';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>编辑 · Tackix 后台</title>
    {/* is:global 必需：表单字段由 edit.astro 的脚本按 schema 动态创建，
        scoped 样式命不中动态节点（无 astro-cid 属性），输入框会失去宽度与边框。 */}
    <style is:global>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      :focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; border-radius: 4px; }
      body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif; background: #f1f5f9; color: #0f172a; }
      #topbar { position: sticky; top: 0; z-index: 10; }
      header { background: #0f172a; color: #fff; padding: 12px 20px; display: flex; align-items: center; gap: 12px; }
      header h1 { font-size: 15px; margin: 0; flex: 1; }
      header a, header button { font-size: 13px; background: #1e293b; border: 1px solid #334155; color: #e2e8f0; padding: 7px 12px; border-radius: 8px; text-decoration: none; cursor: pointer; }
      header button.save { background: #2563eb; border-color: #2563eb; }
      header button.save:disabled { background: #94a3b8; border-color: #94a3b8; cursor: not-allowed; }
      main { max-width: 860px; margin: 20px auto; padding: 0 16px 80px; }
      .field { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px; margin-bottom: 12px; }
      .field > label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; color: #1e293b; }
      .field .desc { font-size: 12px; color: #64748b; margin: -4px 0 8px; }
      .bi { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
      .bi small { display:block; color:#64748b; font-size:11px; margin-bottom:3px; }
      input[type=text], input[type=date], textarea, select { width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13px; font-family: inherit; background: #fff; color: #0f172a; }
      textarea { min-height: 90px; resize: vertical; }
      .checks { display: flex; flex-wrap: wrap; gap: 10px; }
      .checks label { font-weight: 400; font-size: 13px; display: inline-flex; align-items: center; gap: 5px; }
      fieldset { border: 1px dashed #cbd5e1; border-radius: 10px; padding: 10px 12px; margin: 0; }
      fieldset > legend { font-size: 13px; font-weight: 600; padding: 0 6px; color: #334155; }
      .arr-item { border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; background: #f8fafc; position: relative; }
      .arr-item .rm { position: absolute; top: 8px; right: 10px; font-size: 12px; background: #fee2e2; color: #991b1b; border: 0; padding: 4px 9px; border-radius: 6px; cursor: pointer; }
      .add-btn { font-size: 12px; background: #e0e7ff; color: #3730a3; border: 0; padding: 6px 11px; border-radius: 7px; cursor: pointer; margin-top: 4px; }
      .img-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
      .img-row img { max-height: 60px; border-radius: 6px; border: 1px solid #e2e8f0; }
      .img-row .rm-img { font-size: 12px; background: #fee2e2; color: #991b1b; border: 0; padding: 5px 10px; border-radius: 6px; cursor: pointer; }
      .md-preview-btn { font-size: 12px; background: #e0e7ff; color: #3730a3; border: 0; padding: 4px 10px; border-radius: 6px; cursor: pointer; margin-top: 6px; }
      .md-preview { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 14px; margin-top: 8px; font-size: 13px; line-height: 1.7; }
      .md-preview h1, .md-preview h2, .md-preview h3, .md-preview h4, .md-preview h5, .md-preview h6 { margin: 0.5em 0 0.3em; line-height: 1.3; }
      .md-preview h1 { font-size: 20px; }
      .md-preview h2 { font-size: 17px; }
      .md-preview h3 { font-size: 15px; }
      .md-preview p { margin: 0.4em 0; }
      .md-preview ul, .md-preview ol { margin: 0.4em 0; padding-left: 20px; }
      .md-preview code { background: #e2e8f0; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
      .md-preview a { color: #2563eb; }
      .md-preview .md-empty { color: #94a3b8; margin: 0; }
      #toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: #0f172a; color: #fff; padding: 10px 16px; border-radius: 9px; font-size: 13px; opacity: 0; transition: opacity .2s; pointer-events: none; }
      #toast.show { opacity: 1; }
      #pending-bar { display: none; align-items: center; gap: 12px; background: #fef9c3; border-bottom: 1px solid #fde68a; color: #854d0e; font-size: 13px; padding: 9px 16px; }
      #pending-bar.show { display: flex; }
      #pending-bar.published { background: #dcfce7; border-color: #bbf7d0; color: #166534; }
      #pending-bar .grow { flex: 1; }
      #pending-bar button { font-size: 12px; background: #2563eb; color: #fff; border: 0; padding: 6px 12px; border-radius: 7px; cursor: pointer; }
      #pending-bar button:disabled { background: #94a3b8; cursor: not-allowed; }
      #pending-bar.published button { background: #16a34a; }
      dialog.cdlg { border: 0; border-radius: 12px; padding: 0; box-shadow: 0 12px 40px rgba(0,0,0,.28); max-width: 440px; width: calc(100vw - 32px); color: #0f172a; }
      dialog.cdlg::backdrop { background: rgba(15,23,42,.5); }
      .cdlg form { margin: 0; }
      .cdlg p { margin: 0; padding: 20px 22px 6px; font-size: 14px; line-height: 1.65; white-space: pre-wrap; }
      .cdlg menu { margin: 0; padding: 14px 22px 20px; display: flex; justify-content: flex-end; gap: 10px; }
      .cdlg button { font-size: 13px; padding: 8px 16px; border-radius: 8px; cursor: pointer; border: 1px solid #cbd5e1; background: #fff; color: #334155; }
      .cdlg button.cdlg-ok { background: #2563eb; border-color: #2563eb; color: #fff; }
      .cdlg button.cdlg-ok.danger { background: #dc2626; border-color: #dc2626; }
    </style>
  </head>
  <body>
    <div id="topbar">
      <header>
        <a href="/admin" id="back-link">← 返回</a>
        <h1 id="page-title">编辑</h1>
        <a href="#" id="history-link" style="display:none">版本历史</a>
        <button class="save" id="save-btn">保存</button>
      </header>
      <div id="pending-bar" role="status" aria-live="polite">
        <span class="grow" id="pending-text">已保存，尚未发布 —— 前台暂未更新。</span>
        <button id="publish-now" type="button">立即发布</button>
      </div>
    </div>
    <main>
      <div id="slug-wrap" class="field" style="display:none">
        <label for="slug-input">URL slug（创建后勿随意改）</label>
        <input type="text" id="slug-input" placeholder="例如 choose-bathroom-sealant" />
      </div>
      <div id="form-root">加载中…</div>
    </main>
    <div id="toast" role="status" aria-live="polite"></div>

    {/* 必须用 set:html：普通 script 标签里的 {…} 不会被求值，会原样输出成
        “{JSON.stringify(SCHEMAS)}”，前端 JSON.parse 直接抛 SyntaxError、表单永远停在「加载中…」。
        < 转成 \u003c 防止字段值里出现标签闭合序列破坏 script。 */}
    <script type="application/json" id="schemas" set:html={JSON.stringify(SCHEMAS).replace(/</g, '\\u003c')}></script>
    <script is:inline>
      let SCHEMAS = {};
      try {
        SCHEMAS = JSON.parse(document.getElementById('schemas').textContent || '{}');
      } catch (e) {
        document.getElementById('form-root').textContent =
          '表单配置解析失败：' + e.message + '（请把这条信息发给开发，页面已停止渲染以免误改数据）';
        throw e;
      }
      const params = new URLSearchParams(location.search);
      const singleton = params.get('singleton');
      const collection = params.get('collection');
      const slug = params.get('slug');
      const schema = singleton ? SCHEMAS[singleton] : SCHEMAS[collection];
      const meta = { collection: schema ? schema.collection : (singleton || collection), slug: slug || '', isSingleton: !!singleton };

      const $ = (id) => document.getElementById(id);
      function toast(text, ok = true) {
        const t = $('toast'); t.textContent = text; t.style.background = ok ? '#0f172a' : '#991b1b';
        t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 2600);
      }
      // —— P0：脏数据保护 —— 任何用户输入置位，保存成功后复位
      let dirty = false;
      function markDirty() { dirty = true; }
      // 统一确认层（替换原生 confirm）：<dialog>.showModal() 自带焦点陷阱 + Esc 取消
      function confirmDialog(message, { danger = false } = {}) {
        const d = document.createElement('dialog');
        d.className = 'cdlg';
        const form = document.createElement('form');
        form.method = 'dialog';
        const p = document.createElement('p');
        p.textContent = message;
        const menu = document.createElement('menu');
        const cancel = document.createElement('button');
        cancel.value = 'cancel';
        cancel.className = 'cdlg-c';
        cancel.textContent = '取消';
        const ok = document.createElement('button');
        ok.value = 'ok';
        ok.className = 'cdlg-ok' + (danger ? ' danger' : '');
        ok.textContent = '确认';
        menu.append(cancel, ok);
        form.append(p, menu);
        d.appendChild(form);
        document.body.appendChild(d);
        d.showModal();
        return new Promise((resolve) => {
          d.addEventListener('close', () => { resolve(d.returnValue === 'ok'); d.remove(); }, { once: true });
        });
      }
      async function confirmLeave() {
        if (!dirty) return true;
        const ok = await confirmDialog('有未保存的更改，确定离开？');
        if (ok) dirty = false; // 已确认放弃更改，避免 beforeunload 二次提示
        return ok;
      }
      // —— P0：保存后「未发布」提示条 ——
      function showPendingBar() {
        const bar = $('pending-bar');
        bar.classList.remove('published');
        $('pending-text').textContent = '已保存，尚未发布 —— 前台暂未更新。';
        bar.classList.add('show');
      }
      function markPublished() {
        const bar = $('pending-bar');
        bar.classList.add('published');
        $('pending-text').textContent = '已发布，前台已更新。';
        setTimeout(() => { bar.classList.remove('show'); bar.classList.remove('published'); }, 4000);
      }
      // 极简 Markdown → HTML（后台预览用，覆盖标题/列表/加粗/斜体/链接/行内代码/段落）
      function md2html(md) {
        if (!md) return '<p class="md-empty">（空）</p>';
        const escHtml = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const inline = (s) => {
          let t = escHtml(s);
          t = t.replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
          t = t.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
          t = t.replace(/\*([^*]+)\*/g, '<em>$1</em>');
          t = t.replace(/`([^`]+)`/g, '<code>$1</code>');
          return t;
        };
        let html = '', inList = false, listType = '';
        const closeList = () => { if (inList) { html += listType === 'ul' ? '</ul>' : '</ol>'; inList = false; } };
        for (const raw of String(md).split(/\r?\n/)) {
          const line = raw.trim();
          if (!line) { closeList(); continue; }
          let m = line.match(/^(#{1,6})\s+(.*)$/);
          if (m) { closeList(); html += '<h' + m[1].length + '>' + inline(m[2]) + '</h' + m[1].length + '>'; continue; }
          m = line.match(/^[-*+]\s+(.*)$/);
          if (m) { if (!inList || listType !== 'ul') { closeList(); html += '<ul>'; inList = true; listType = 'ul'; } html += '<li>' + inline(m[1]) + '</li>'; continue; }
          m = line.match(/^\d+\.\s+(.*)$/);
          if (m) { if (!inList || listType !== 'ol') { closeList(); html += '<ol>'; inList = true; listType = 'ol'; } html += '<li>' + inline(m[1]) + '</li>'; continue; }
          closeList();
          html += '<p>' + inline(line) + '</p>';
        }
        closeList();
        return html;
      }
      function h(tag, props = {}, children = []) {
        const e = document.createElement(tag);
        for (const [k, v] of Object.entries(props)) {
          if (k === 'class') e.className = v;
          else if (k.startsWith('on') && typeof v === 'function') e.addEventListener(k.slice(2), (ev) => { markDirty(); v(ev); });
          else if (k === 'html') e.innerHTML = v;
          else e.setAttribute(k, v);
        }
        (Array.isArray(children) ? children : [children]).forEach((c) => {
          if (c == null) return;
          e.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
        });
        return e;
      }

      const data = {};
      let slugInput = null;

      // 「版本历史」入口：仅在编辑已存在条目（有 slug 或单例）时出现
      function syncHistoryLink() {
        const el = $('history-link');
        if (!el) return;
        if (!meta.isSingleton && !meta.slug) { el.style.display = 'none'; return; }
        el.style.display = '';
        el.href = meta.isSingleton
          ? '/admin/revisions?singleton=' + encodeURIComponent(meta.collection)
          : '/admin/revisions?collection=' + encodeURIComponent(meta.collection) + '&slug=' + encodeURIComponent(meta.slug);
      }

      function fieldShell(field, control) {
        const wrap = h('div', { class: 'field' });
        wrap.appendChild(h('label', {}, field.label));
        if (field.description) wrap.appendChild(h('div', { class: 'desc' }, field.description));
        wrap.appendChild(control);
        return wrap;
      }

      function renderField(parent, field, data) {
        switch (field.type) {
          case 'bilingual': {
            data[field.key] = data[field.key] || { zh: '', en: '' };
            if (typeof data[field.key] === 'string') data[field.key] = { zh: data[field.key], en: '' };
            const zh = h('textarea', { oninput: (e) => (data[field.key].zh = e.target.value) });
            zh.value = data[field.key].zh || '';
            const en = h('textarea', { oninput: (e) => (data[field.key].en = e.target.value) });
            en.value = data[field.key].en || '';
            if (!field.multiline) { zh.setAttribute('rows', '1'); en.setAttribute('rows', '1'); }
            const control = h('div', { class: 'bi' }, [h('div', {}, [h('small', {}, '中文'), zh]), h('div', {}, [h('small', {}, 'English'), en])]);
            const wrap = fieldShell(field, control);
            if (field.multiline) {
              const pv = h('div', { class: 'md-preview' });
              pv.hidden = true;
              const btn = h('button', { type: 'button', class: 'md-preview-btn', onclick: () => {
                if (pv.hidden) { pv.innerHTML = md2html((data[field.key] && data[field.key].zh) || ''); pv.hidden = false; control.style.display = 'none'; btn.textContent = '编辑'; }
                else { pv.hidden = true; control.style.display = ''; btn.textContent = '预览'; }
              } }, '预览（中文）');
              wrap.appendChild(btn);
              wrap.appendChild(pv);
            }
            parent.appendChild(wrap);
            break;
          }
          case 'textarea': {
            const ta = h('textarea', { oninput: (e) => (data[field.key] = e.target.value) });
            ta.value = data[field.key] || '';
            const wrap = fieldShell(field, ta);
            const pv = h('div', { class: 'md-preview' });
            pv.hidden = true;
            const btn = h('button', { type: 'button', class: 'md-preview-btn', onclick: () => {
              if (pv.hidden) { pv.innerHTML = md2html(ta.value); pv.hidden = false; ta.style.display = 'none'; btn.textContent = '编辑'; }
              else { pv.hidden = true; ta.style.display = ''; btn.textContent = '预览'; }
            } }, '预览');
            wrap.appendChild(btn);
            wrap.appendChild(pv);
            parent.appendChild(wrap);
            break;
          }
          case 'text': {
            const inp = h('input', { type: 'text', oninput: (e) => (data[field.key] = e.target.value) });
            inp.value = data[field.key] || '';
            parent.appendChild(fieldShell(field, inp));
            break;
          }
          case 'date': {
            const inp = h('input', { type: 'date', oninput: (e) => (data[field.key] = e.target.value) });
            inp.value = (data[field.key] || '').slice(0, 10);
            parent.appendChild(fieldShell(field, inp));
            break;
          }
          case 'checkbox': {
            data[field.key] = !!data[field.key];
            const inp = h('input', { type: 'checkbox', onchange: (e) => (data[field.key] = e.target.checked) });
            inp.checked = data[field.key];
            const control = h('label', { class: 'checks' }, [inp, field.description || '']);
            parent.appendChild(fieldShell(field, control));
            break;
          }
          case 'select': {
            const sel = h('select', { onchange: (e) => (data[field.key] = e.target.value) });
            for (const o of field.options) {
              const opt = h('option', { value: o.value }, o.label);
              if (data[field.key] === o.value) opt.selected = true;
              sel.appendChild(opt);
            }
            if (!field.options.some((o) => o.value === data[field.key])) {
              sel.appendChild(h('option', { value: data[field.key] || '' }, data[field.key] || '(未列出)'));
            }
            parent.appendChild(fieldShell(field, sel));
            break;
          }
          case 'multiselect': {
            data[field.key] = Array.isArray(data[field.key]) ? data[field.key] : [];
            const box = h('div', { class: 'checks' });
            const sync = () => {
              const vals = Array.from(box.querySelectorAll('input:checked')).map((i) => i.value);
              data[field.key] = vals;
            };
            for (const o of field.options) {
              const cb = h('input', { type: 'checkbox', value: o.value, onchange: sync });
              if (data[field.key].includes(o.value)) cb.checked = true;
              box.appendChild(h('label', {}, [cb, o.label]));
            }
            parent.appendChild(fieldShell(field, box));
            break;
          }
          case 'image': {
            data[field.key] = data[field.key] || '';
            const img = h('img', { alt: '' });
            const preview = () => {
              // 兼容本站路径（/uploads/…）与外链（https://…），渲染层由 coverSrc/uploadsUrl 统一处理
              const v = data[field.key];
              if (v) { img.src = v; img.style.display = ''; }
              else { img.removeAttribute('src'); img.style.display = 'none'; }
            };
            img.addEventListener('error', () => { img.style.display = 'none'; });
            const urlInp = h('input', {
              type: 'text',
              placeholder: '/uploads/xxx.png  或  https://example.com/a.png',
              oninput: (e) => { data[field.key] = e.target.value.trim(); preview(); },
            });
            urlInp.value = data[field.key];
            preview();
            const file = h('input', { type: 'file', accept: 'image/*,application/pdf' });
            file.addEventListener('change', async () => {
              const f = file.files && file.files[0];
              if (!f) return;
              markDirty();
              const fd = new FormData();
              fd.append('file', f);
              toast('上传中…');
              const r = await fetch('/api/media/upload', { method: 'POST', body: fd }).then((x) => x.json()).catch(() => ({}));
              if (r.ok) {
                urlInp.value = r.url; data[field.key] = r.url; preview();
                toast('已上传（' + (r.backend === 'r2' ? 'R2' : 'KV') + '）');
              } else toast(r.error || '上传失败', false);
            });
            const rmImg = h('button', { type: 'button', class: 'rm-img', onclick: () => { data[field.key] = ''; urlInp.value = ''; preview(); } }, '移除');
            const control = h('div', { class: 'img-row' }, [img, urlInp, file, rmImg]);
            const wrap = fieldShell(field, control);
            wrap.appendChild(h('div', { class: 'desc' }, '可上传到本站存储（图片 / PDF），也可直接填外部链接 https://…。'));
            parent.appendChild(wrap);
            break;
          }
          case 'group': {
            data[field.key] = data[field.key] || {};
            const fs = h('fieldset', {}, [h('legend', {}, field.label)]);
            if (field.description) fs.appendChild(h('div', { class: 'desc' }, field.description));
            for (const sub of field.fields) renderField(fs, sub, data[field.key]);
            parent.appendChild(fs);
            break;
          }
          case 'array': {
            data[field.key] = Array.isArray(data[field.key]) ? data[field.key] : [];
            const container = h('div', {});
            const renderItems = () => {
              container.innerHTML = '';
              data[field.key].forEach((item, idx) => {
                const card = h('div', { class: 'arr-item' });
                const rm = h('button', { class: 'rm', type: 'button', onclick: () => { data[field.key].splice(idx, 1); renderItems(); } }, '删除');
                card.appendChild(rm);
                for (const sub of field.fields) renderField(card, sub, item);
                container.appendChild(card);
              });
            };
            renderItems();
            const add = h('button', { class: 'add-btn', type: 'button', onclick: () => { data[field.key].push({}); renderItems(); } }, '+ ' + (field.itemLabel || '添加'));
            const fs = h('fieldset', {}, [h('legend', {}, field.label), container, add]);
            if (field.description) fs.insertBefore(h('div', { class: 'desc' }, field.description), container);
            parent.appendChild(fs);
            break;
          }
        }
      }

      async function init() {
        if (!schema) { $('form-root').textContent = '未知的内容类型：' + (singleton || collection); return; }
        $('page-title').textContent = (meta.isSingleton ? '' : (meta.slug ? '编辑：' : '新建：')) + schema.title;
        syncHistoryLink();

        // —— P0：脏数据保护 —— 站内跳转前确认；关页/刷新走 beforeunload 兜底
        window.addEventListener('beforeunload', (e) => {
          if (dirty) { e.preventDefault(); e.returnValue = ''; }
        });
        // 先同步 preventDefault 阻止默认导航，再异步确认；否则 await 之后才 preventDefault 会因
        // 浏览器默认动作已执行而失效（页面已跳走）。
        $('back-link').addEventListener('click', async (e) => {
          e.preventDefault();
          if (await confirmLeave()) location.href = '/admin';
        });
        $('history-link').addEventListener('click', async (e) => {
          e.preventDefault();
          const href = e.currentTarget.getAttribute('href');
          if (await confirmLeave()) location.href = href;
        });

        // —— P0：「立即发布」入口（编辑页即可触发重建，避免回仪表盘）——
        $('publish-now').onclick = async () => {
          const btn = $('publish-now');
          btn.disabled = true; btn.textContent = '发布中…';
          const r = await fetch('/api/content/publish', { method: 'POST' }).then((x) => x.json()).catch(() => ({}));
          btn.disabled = false; btn.textContent = '立即发布';
          if (r.ok) { toast(r.message || '已发布'); markPublished(); }
          else toast(r.error || '发布失败', false);
        };

        // 创建模式：集合项需填 slug
        if (schema.slugEditableOnCreate && !meta.slug) {
          $('slug-wrap').style.display = '';
          slugInput = $('slug-input');
          slugInput.addEventListener('input', markDirty);
        }

        if (meta.slug || meta.isSingleton) {
          const q = meta.isSingleton ? 'singleton=' + encodeURIComponent(meta.collection) : 'collection=' + encodeURIComponent(meta.collection) + '&slug=' + encodeURIComponent(meta.slug);
          try {
            const j = await fetch('/api/content/read?' + q, { headers: { accept: 'application/json' } }).then((r) => r.json());
            if (j.ok && j.entry) Object.assign(data, j.entry.data || {});
          } catch (e) { /* 新建或读取失败，留空 */ }
        }

        const root = $('form-root');
        root.innerHTML = '';
        for (const f of schema.fields) renderField(root, f, data);

        let saving = false;
        async function save() {
          if (saving) return;
          // 单例的 entry id 是 singleton/<collection>，没有独立 slug —— 这里必须用 collection 键，
          // 否则 slug 为空串，/api/content/save 直接 400「参数缺失」。
          let s = meta.isSingleton ? meta.collection : meta.slug;
          if (!meta.isSingleton && schema.slugEditableOnCreate && !meta.slug) {
            s = (slugInput?.value || '').trim();
            if (!/^[a-z0-9-]+$/i.test(s)) { toast('slug 非法（仅小写字母/数字/连字符）', false); return; }
          }
          const payload = { collection: meta.collection, slug: s, data: data, published: !!data.published, featured: !!data.featured };
          if (!meta.isSingleton) payload.data.title = s; // 保持与迁移数据同构（title=slug）
          const btn = $('save-btn');
          saving = true;
          btn.disabled = true;
          btn.textContent = '保存中…';
          try {
            const r = await fetch('/api/content/save', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }).then((x) => x.json());
            if (r.ok) {
              toast('已保存');
              dirty = false;
              showPendingBar();
              if (!meta.isSingleton && !meta.slug && s) { meta.slug = s; history.replaceState(null, '', '/admin/edit?collection=' + meta.collection + '&slug=' + s); $('slug-wrap').style.display = 'none'; syncHistoryLink(); }
            } else toast(r.error || '保存失败', false);
          } catch (e) { toast('网络错误：' + e.message, false); }
          finally {
            saving = false;
            btn.disabled = false;
            btn.textContent = '保存';
          }
        }
        $('save-btn').onclick = save;

        // Cmd/Ctrl+S 快捷保存
        window.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && (e.key === 's' || e.key === 'S')) {
            e.preventDefault();
            save();
          }
        });
      }
      init();
    </script>
  </body>
</html>
