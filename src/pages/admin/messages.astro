---
// 留言后台：受 middleware 会话守卫（未登录 302 到 /admin/login）。
// 数据走 /api/submissions（服务端会话鉴权 + 兼容旧 ADMIN_TOKEN）。
// 独立成页（不套站点 Base），统一到主后台深色顶栏 + 浅色正文。
// 声明 noindex，避免被搜索引擎收录。
export const prerender = false;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>留言管理 · Tackix 后台</title>
    {/* is:global 必需：留言卡片/删除按钮均为脚本动态创建，scoped 样式命不中（无 astro-cid）。 */}
    <style is:global>
      :root {
        --bg: #f1f5f9; --surface: #ffffff; --surface-2: #f5f6f9; --surface-3: #fafbfd;
        --fg: #0f172a; --fg-soft: #334155; --muted: #64748b; --faint: #94a3b8;
        --accent: #2563eb; --accent-strong: #1d4ed8; --accent-soft: #dbeafe; --on-accent: #ffffff;
        --success: #166534; --success-bg: #dcfce7; --danger: #991b1b; --danger-bg: #fee2e2;
        --border: #e2e8f0; --border-strong: #cbd5e1;
        --r-sm: 8px; --r-md: 12px; --r-lg: 18px; --r-pill: 999px;
        --font-sans: system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        --dur: 0.18s; --ease: cubic-bezier(0.4, 0, 0.2, 1);
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font-sans); background: var(--bg); color: var(--fg); }
      header { background: #0f172a; color: #fff; padding: 14px 22px; display: flex; align-items: center; gap: 14px; position: sticky; top: 0; z-index: 10; }
      header h1 { font-size: 16px; margin: 0; flex: 1; }
      header a { color: #e2e8f0; text-decoration: none; font-size: 13px; background: #1e293b; border: 1px solid #334155; padding: 7px 12px; border-radius: 8px; cursor: pointer; }
      main { max-width: 920px; margin: 22px auto; padding: 0 16px 60px; }
      code { background: var(--surface-2); padding: 1px 6px; border-radius: 4px; font-size: 13px; font-family: var(--font-mono); color: var(--fg-soft); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }

      .toolbar { display: flex; align-items: center; gap: 10px; margin: 6px 0 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
      .toolbar button { font: inherit; padding: 8px 16px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); background: var(--surface); color: var(--fg-soft); cursor: pointer; font-size: 13px; transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
      .toolbar button:hover { border-color: var(--accent); color: var(--accent); }
      .summary { color: var(--muted); font-size: 13px; margin-right: auto; }
      .status { font-size: 14px; min-height: 20px; margin: 0; color: var(--muted); }
      .status.err { color: var(--danger); }

      .list { display: flex; flex-direction: column; gap: 12px; }
      .card { border: 1px solid var(--border); border-radius: var(--r-md); padding: 14px 16px; background: var(--surface); }
      .card-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: 13px; }
      .who { font-weight: 600; color: var(--fg); }
      .mail { color: var(--accent); }
      .mail:hover { color: var(--accent-strong); }
      .time { color: var(--muted); margin-right: auto; }
      .del { font: inherit; font-size: 12px; padding: 4px 10px; border: 1px solid var(--border-strong); border-radius: var(--r-sm); background: var(--surface); color: var(--danger); cursor: pointer; transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease); }
      .del:hover { background: var(--danger-bg); border-color: var(--danger); }
      .msg { margin-top: 8px; color: var(--fg-soft); white-space: normal; word-break: break-word; }
      .empty { color: var(--muted); padding: 40px 0; text-align: center; }

      #toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: #0f172a; color: #fff; padding: 10px 16px; border-radius: 9px; font-size: 13px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 20; max-width: 80vw; }
      #toast.show { opacity: 1; }
      dialog.cdlg { border: 0; border-radius: 12px; padding: 0; box-shadow: 0 12px 40px rgba(0,0,0,.28); max-width: 440px; width: calc(100vw - 32px); color: #0f172a; }
      dialog.cdlg::backdrop { background: rgba(15,23,42,.5); }
      .cdlg form { margin: 0; }
      .cdlg p { margin: 0; padding: 20px 22px 6px; font-size: 14px; line-height: 1.65; white-space: pre-wrap; }
      .cdlg menu { margin: 0; padding: 14px 22px 20px; display: flex; justify-content: flex-end; gap: 10px; }
      .cdlg button { font-size: 13px; padding: 8px 16px; border-radius: 8px; cursor: pointer; border: 1px solid #cbd5e1; background: #fff; color: #334155; }
      .cdlg button.cdlg-ok { background: #2563eb; border-color: #2563eb; color: #fff; }
      .cdlg button.cdlg-ok.danger { background: #dc2626; border-color: #dc2626; }
    </style>
  </head>
  <body>
    <header>
      <a href="/admin">← 后台</a>
      <h1>留言管理</h1>
      <a href="/">查看站点</a>
    </header>
    <main data-pagefind-ignore>
      <div class="toolbar">
        <span id="summary" class="summary"></span>
        <button id="refresh" type="button" class="ghost">刷新</button>
      </div>
      <p id="list-status" class="status" role="status" aria-live="polite"></p>
      <div id="list" class="list"></div>
    </main>
    <div id="toast" role="status" aria-live="polite"></div>

    <script is:inline>
      (function () {
        var $ = function (id) { return document.getElementById(id); };
        var listEl = $('list');
        var listStatus = $('list-status');
        var summary = $('summary');

        function toast(text, ok) {
          var t = $('toast');
          t.textContent = text;
          t.style.background = ok === false ? '#991b1b' : '#0f172a';
          t.classList.add('show');
          setTimeout(function () { t.classList.remove('show'); }, 2600);
        }
        function confirmDialog(message, opts) {
          opts = opts || {};
          var d = document.createElement('dialog');
          d.className = 'cdlg';
          var form = document.createElement('form');
          form.method = 'dialog';
          var p = document.createElement('p');
          p.textContent = message;
          var menu = document.createElement('menu');
          var cancel = document.createElement('button');
          cancel.value = 'cancel'; cancel.className = 'cdlg-c'; cancel.textContent = '取消';
          var ok = document.createElement('button');
          ok.value = 'ok'; ok.className = 'cdlg-ok' + (opts.danger ? ' danger' : ''); ok.textContent = '确认';
          menu.appendChild(cancel); menu.appendChild(ok);
          form.appendChild(p); form.appendChild(menu);
          d.appendChild(form);
          document.body.appendChild(d);
          d.showModal();
          return new Promise(function (resolve) {
            d.addEventListener('close', function () { resolve(d.returnValue === 'ok'); d.remove(); }, { once: true });
          });
        }

        function esc(s) {
          return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
          });
        }
        function fmt(iso) {
          if (!iso) return '';
          var d = new Date(iso);
          if (isNaN(d.getTime())) return String(iso);
          var p = function (n) { return n < 10 ? '0' + n : '' + n; };
          return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
        }

        async function load() {
          listStatus.textContent = '加载中…';
          listStatus.className = 'status';
          try {
            var res = await fetch('/api/submissions?limit=100', { cache: 'no-store' });
            var data = await res.json().catch(function () { return {}; });
            if (res.status === 401) {
              listStatus.textContent = '未登录或会话已过期。';
              listStatus.className = 'status err';
              return;
            }
            if (!res.ok || !data.ok) {
              listStatus.textContent = '加载失败：' + (data.error || res.status);
              listStatus.className = 'status err';
              return;
            }
            var items = data.items || [];
            summary.textContent = '共 ' + (data.total ?? items.length) + ' 条，当前显示 ' + items.length + ' 条';
            if (!items.length) {
              listEl.innerHTML = '<p class="empty">还没有收到留言。</p>';
              listStatus.textContent = '';
              return;
            }
            listEl.innerHTML = items.map(function (it) {
              return '<div class="card">' +
                '<div class="card-head">' +
                '<span class="who">' + esc(it.name) + '</span>' +
                '<a class="mail" href="mailto:' + esc(it.email) + '">' + esc(it.email) + '</a>' +
                '<span class="time">' + esc(fmt(it.created_at)) + '</span>' +
                '<button type="button" class="del" data-id="' + esc(it.id) + '">删除</button>' +
                '</div>' +
                '<div class="msg">' + esc(it.message).replace(/\n/g, '<br />') + '</div>' +
                '</div>';
            }).join('');
            listStatus.textContent = '';
          } catch (e) {
            listStatus.textContent = '加载失败：' + (e && e.message ? e.message : e);
            listStatus.className = 'status err';
          }
        }

        async function remove(id, btn) {
          if (!(await confirmDialog('删除留言 #' + id + '？此操作不可撤销。', { danger: true }))) return;
          btn.disabled = true;
          try {
            var res = await fetch('/api/submissions?id=' + encodeURIComponent(id), { method: 'DELETE' });
            var data = await res.json().catch(function () { return {}; });
            if (!res.ok || !data.ok) {
              toast('删除失败：' + (data.error || res.status), false);
              btn.disabled = false;
              return;
            }
            toast('已删除');
            load();
          } catch (e) {
            toast('删除失败：' + (e && e.message ? e.message : e), false);
            btn.disabled = false;
          }
        }

        $('refresh').addEventListener('click', load);
        listEl.addEventListener('click', function (e) {
          var t = e.target;
          if (t && t.classList && t.classList.contains('del')) {
            remove(t.getAttribute('data-id'), t);
          }
        });

        load();
      })();
    </script>
  </body>
</html>
