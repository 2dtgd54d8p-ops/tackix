---
// 内容版本历史：列表 + 快照预览 + 一键回滚。
// 入口：/admin/edit 顶部「版本历史」按钮。
// 参数：?singleton=home  或  ?collection=knowledge&slug=xxx
// entry.id 规则与 save.ts 一致：`${kind}/${slug}`。
// 受 middleware 守卫（/admin/* 未登录 302 到 /admin/login）。
export const prerender = false;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>版本历史 · Tackix 后台</title>
    {/* is:global 必需：历史行、徽标、按钮、快照面板均为脚本动态插入，
        scoped 样式不会命中（缺 astro-cid 属性），会变成无样式裸文本。 */}
    <style is:global>
      :root { color-scheme: light dark; }
      * { box-sizing: border-box; }
      :focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; border-radius: 4px; }
      body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif; background: #f1f5f9; color: #0f172a; }
      header { background: #0f172a; color: #fff; padding: 12px 20px; display: flex; align-items: center; gap: 12px; position: sticky; top: 0; z-index: 10; }
      header h1 { font-size: 15px; margin: 0; flex: 1; }
      header h1 small { font-weight: 400; color: #94a3b8; margin-left: 8px; font-size: 12px; }
      header a, header button { font-size: 13px; background: #1e293b; border: 1px solid #334155; color: #e2e8f0; padding: 7px 12px; border-radius: 8px; text-decoration: none; cursor: pointer; }
      main { max-width: 920px; margin: 20px auto; padding: 0 16px 60px; }
      .hint { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e40af; font-size: 12.5px; line-height: 1.6; padding: 10px 14px; border-radius: 10px; margin-bottom: 14px; }
      .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
      .row { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border-top: 1px solid #f1f5f9; }
      .row:first-child { border-top: 0; }
      .time { font-size: 13px; font-weight: 600; color: #0f172a; min-width: 150px; }
      .time small { display: block; font-weight: 400; color: #64748b; font-size: 11px; margin-top: 2px; }
      .badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; white-space: nowrap; }
      .badge.save { background: #e0e7ff; color: #3730a3; }
      .badge.restore { background: #fef9c3; color: #854d0e; }
      .badge.delete { background: #fee2e2; color: #991b1b; }
      .badge.cur { background: #dcfce7; color: #166534; }
      .grow { flex: 1; font-size: 12px; color: #64748b; }
      button.act { font-size: 12px; padding: 5px 10px; border-radius: 7px; border: 0; cursor: pointer; }
      button.view { background: #e2e8f0; color: #334155; }
      button.roll { background: #2563eb; color: #fff; }
      button.roll:disabled { background: #cbd5e1; cursor: not-allowed; }
      .snapshot { background: #fff; border: 1px solid #e2e8f0; border-top: 0; margin: 0; padding: 14px 16px; font-size: 13px; line-height: 1.6; }
      .snapshot .sum-title, .snapshot .diff-title { font-weight: 700; font-size: 12px; color: #0f172a; margin-bottom: 8px; }
      .snapshot .sum { border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; margin-bottom: 10px; }
      .snapshot .sum-row { display: flex; gap: 12px; padding: 3px 0; }
      .snapshot .sum-row .k { color: #64748b; min-width: 80px; font-size: 12px; }
      .snapshot .sum-row .v { color: #0f172a; word-break: break-word; }
      .snapshot .diff { border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 12px; margin-bottom: 10px; }
      .snapshot .diff-row { padding: 3px 0; color: #0f172a; }
      .snapshot .diff-row .k { color: #64748b; font-size: 12px; margin-right: 8px; }
      .snapshot .diff-row .from { color: #991b1b; text-decoration: line-through; margin-right: 6px; }
      .snapshot .diff-row .to { color: #166534; font-weight: 600; }
      .snapshot .diff-none { color: #64748b; font-size: 12.5px; }
      .snapshot details { margin-top: 4px; }
      .snapshot details summary { cursor: pointer; color: #2563eb; font-size: 12.5px; user-select: none; }
      .snapshot pre.json { background: #0f172a; color: #e2e8f0; margin: 8px 0 0; padding: 12px 14px; font-size: 12px; line-height: 1.55; max-height: 360px; overflow: auto; white-space: pre-wrap; word-break: break-word; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; border-radius: 8px; }
      .empty { padding: 34px 16px; text-align: center; color: #64748b; font-size: 13px; }
      #toast { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); background: #0f172a; color: #fff; padding: 10px 16px; border-radius: 9px; font-size: 13px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 20; max-width: 80vw; }
      #toast.show { opacity: 1; }
      dialog.cdlg { border: 0; border-radius: 12px; padding: 0; box-shadow: 0 12px 40px rgba(0,0,0,.28); max-width: 440px; width: calc(100vw - 32px); color: #0f172a; }
      dialog.cdlg::backdrop { background: rgba(15,23,42,.5); }
      .cdlg form { margin: 0; }
      .cdlg p { margin: 0; padding: 20px 22px 6px; font-size: 14px; line-height: 1.65; white-space: pre-wrap; }
      .cdlg menu { margin: 0; padding: 14px 22px 20px; display: flex; justify-content: flex-end; gap: 10px; }
      .cdlg button { font-size: 13px; padding: 8px 16px; border-radius: 8px; cursor: pointer; border: 1px solid #cbd5e1; background: #fff; color: #334155; }
      .cdlg button.cdlg-ok { background: #2563eb; border-color: #2563eb; color: #fff; }
      .cdlg button.cdlg-ok.danger { background: #dc2626; border-color: #dc2626; }
    </style>
  </head>
  <body>
    <header>
      <a href="/admin" id="back-admin">← 后台</a>
      <h1 id="page-title">版本历史<small id="page-sub"></small></h1>
      <a href="#" id="back-edit">返回编辑</a>
    </header>
    <main>
      <div class="hint">
        每次「保存」都会留一条快照，回滚 = 用旧快照覆盖当前内容，并自动记录一次回滚动作（所以回滚本身也能被回滚）。
        回滚不会自动上线，需回到后台点「发布」重建站点后前台才生效。
      </div>
      <div class="card" id="list"><div class="empty">加载中…</div></div>
    </main>
    <div id="toast" role="status" aria-live="polite"></div>

    <script is:inline>
      const $ = (id) => document.getElementById(id);
      const params = new URLSearchParams(location.search);
      const singleton = params.get('singleton');
      const collection = params.get('collection');
      const slug = params.get('slug') || '';

      function kindOf(c) {
        if (c === 'knowledge') return 'knowledge';
        if (c === 'scenarios') return 'scenario';
        return 'singleton';
      }
      const coll = singleton || collection || '';
      const entryId = slug ? kindOf(collection) + '/' + slug : 'singleton/' + coll;

      // 编辑页回跳链接：保留原始参数
      $('back-edit').href = singleton
        ? '/admin/edit?singleton=' + encodeURIComponent(singleton)
        : '/admin/edit?collection=' + encodeURIComponent(collection || '') + '&slug=' + encodeURIComponent(slug);

      $('page-sub').textContent = entryId;

      let toastTimer = null;
      function toast(text, ok = true) {
        const t = $('toast');
        t.textContent = text;
        t.style.background = ok ? '#0f172a' : '#991b1b';
        t.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => t.classList.remove('show'), 3200);
      }
      // 统一确认层（替换原生 confirm）：<dialog>.showModal() 自带焦点陷阱 + Esc 取消
      function confirmDialog(message, { danger = false } = {}) {
        const d = document.createElement('dialog');
        d.className = 'cdlg';
        const form = document.createElement('form');
        form.method = 'dialog';
        const p = document.createElement('p');
        p.textContent = message;
        const menu = document.createElement('menu');
        const cancel = document.createElement('button');
        cancel.value = 'cancel';
        cancel.className = 'cdlg-c';
        cancel.textContent = '取消';
        const ok = document.createElement('button');
        ok.value = 'ok';
        ok.className = 'cdlg-ok' + (danger ? ' danger' : '');
        ok.textContent = '确认';
        menu.append(cancel, ok);
        form.append(p, menu);
        d.appendChild(form);
        document.body.appendChild(d);
        d.showModal();
        return new Promise((resolve) => {
          d.addEventListener('close', () => { resolve(d.returnValue === 'ok'); d.remove(); }, { once: true });
        });
      }

      function fmtTime(ms) {
        const d = new Date(Number(ms) || 0);
        const pad = (n) => String(n).padStart(2, '0');
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
      }
      function relTime(ms) {
        const diff = Date.now() - Number(ms || 0);
        if (!Number.isFinite(diff) || diff < 0) return '';
        const m = Math.floor(diff / 60000);
        if (m < 1) return '刚刚';
        if (m < 60) return m + ' 分钟前';
        const h = Math.floor(m / 60);
        if (h < 24) return h + ' 小时前';
        return Math.floor(h / 24) + ' 天前';
      }
      function actionLabel(action) {
        if (action === 'delete') return { text: '删除', cls: 'delete' };
        if (String(action).indexOf('restore:') === 0) {
          return { text: '回滚自 #' + String(action).split(':')[1], cls: 'restore' };
        }
        return { text: '保存', cls: 'save' };
      }
      function fmtBytes(n) {
        const b = Number(n) || 0;
        return b < 1024 ? b + ' B' : (b / 1024).toFixed(1) + ' KB';
      }

      // 双语字段取值工具：{zh,en} 结构取中文优先，兼容字符串
      function biText(v) {
        if (v == null) return '';
        if (typeof v === 'object') return String(v.zh || v.en || '').trim();
        return String(v).trim();
      }
      function biZh(v) { return v && typeof v === 'object' ? String(v.zh || '').trim() : (v == null ? '' : String(v).trim()); }
      function biEn(v) { return v && typeof v === 'object' ? String(v.en || '').trim() : (v == null ? '' : String(v).trim()); }
      function trunc(s, n) { s = s == null ? '' : String(s); return s.length > n ? s.slice(0, n) + '…' : s; }

      // 从快照 data 提取「关键字段摘要」（人类可读，双语取中文优先）
      function summarize(data) {
        if (!data || typeof data !== 'object') return [];
        const rows = [];
        const title = biText(data.name != null ? data.name : data.title);
        if (title) rows.push(['标题', trunc(title, 60)]);
        const excerpt = biText(data.excerpt != null ? data.excerpt : data.conclusion);
        if (excerpt) rows.push(['摘要', trunc(excerpt, 60)]);
        if (typeof data.published === 'boolean') rows.push(['状态', data.published ? '已发布' : '草稿']);
        if (typeof data.featured === 'boolean') rows.push(['首页', data.featured ? '是' : '否']);
        if (data.scenario && data.scenario !== 'none') rows.push(['场景', data.scenario]);
        if (data.category && data.category !== 'uncategorized') rows.push(['分类', data.category]);
        if (Array.isArray(data.tags) && data.tags.length) rows.push(['标签', data.tags.length + ' 项']);
        if (Array.isArray(data.steps) && data.steps.length) rows.push(['步骤', data.steps.length + ' 项']);
        if (Array.isArray(data.faq) && data.faq.length) rows.push(['FAQ', data.faq.length + ' 项']);
        if (data.cover) rows.push(['封面', data.cover]);
        if (data.publishedAt) rows.push(['发布日', data.publishedAt]);
        return rows;
      }

      // 语义级 diff：双语字段中英合并对比、标量字段、数组长度变化
      function diffFields(snap, current) {
        const diffs = [];
        const a = snap || {}, b = current || {};
        const biFields = [['name', '标题'], ['title', '标题'], ['excerpt', '摘要'], ['conclusion', '结论'], ['body', '正文']];
        for (const [key, label] of biFields) {
          const azh = biZh(a[key]), aen = biEn(a[key]);
          const bzh = biZh(b[key]), ben = biEn(b[key]);
          if (azh === bzh && aen === ben) continue;
          if (!azh && !aen && !bzh && !ben) continue;
          const fromP = [], toP = [];
          if (azh !== bzh) { fromP.push('中:' + (trunc(azh, 40) || '（空）')); toP.push('中:' + (trunc(bzh, 40) || '（空）')); }
          if (aen !== ben) { fromP.push('英:' + (trunc(aen, 40) || '（空）')); toP.push('英:' + (trunc(ben, 40) || '（空）')); }
          diffs.push({ label, from: fromP.join(' · '), to: toP.join(' · ') });
        }
        const scalars = [
          ['published', '状态', (v) => (v ? '已发布' : '草稿')],
          ['featured', '首页', (v) => (v ? '是' : '否')],
          ['scenario', '场景', (v) => (v || '（空）')],
          ['category', '分类', (v) => (v || '（空）')],
          ['publishedAt', '发布日期', (v) => (v || '（空）')],
          ['cover', '封面', (v) => (v || '（空）')],
        ];
        for (const [key, label, fmt] of scalars) {
          const x = a[key], y = b[key];
          if (x === y) continue;
          if (x === undefined && y === undefined) continue;
          diffs.push({ label, from: fmt(x), to: fmt(y) });
        }
        const arrs = [['tags', '标签'], ['steps', '步骤'], ['faq', 'FAQ'], ['customSections', '自定义区块'], ['certBadges', '徽章']];
        for (const [key, label] of arrs) {
          const x = Array.isArray(a[key]) ? a[key].length : 0;
          const y = Array.isArray(b[key]) ? b[key].length : 0;
          if (x !== y) diffs.push({ label, from: x + ' 项', to: y + ' 项' });
        }
        return diffs;
      }

      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      async function load() {
        const box = $('list');
        let j;
        // 当前线上内容（用于 diff 对比，读取失败不影响历史列表）
        let currentData = null;
        try {
          const readQ = singleton
            ? 'singleton=' + encodeURIComponent(coll)
            : 'collection=' + encodeURIComponent(collection || '') + '&slug=' + encodeURIComponent(slug);
          const cr = await fetch('/api/content/read?' + readQ, { headers: { accept: 'application/json' } }).then((x) => x.json());
          if (cr.ok && cr.entry) currentData = cr.entry.data || {};
        } catch (e) { /* 忽略 */ }
        try {
          j = await fetch('/api/content/revisions?id=' + encodeURIComponent(entryId) + '&limit=50', {
            headers: { accept: 'application/json' },
          }).then((r) => r.json());
        } catch (e) {
          box.innerHTML = '<div class="empty">加载失败：网络错误</div>';
          return;
        }
        if (!j || !j.ok) {
          box.innerHTML = '<div class="empty">' + ((j && j.error) || '加载失败') + '</div>';
          return;
        }
        const rows = j.rows || [];
        if (!rows.length) {
          box.innerHTML = '<div class="empty">暂无历史快照。<br />第一次在编辑页点「保存」后，这里就会出现版本记录。</div>';
          return;
        }
        box.innerHTML = '';
        rows.forEach((row, idx) => {
          const lab = actionLabel(row.action);

          const line = document.createElement('div');
          line.className = 'row';

          const time = document.createElement('div');
          time.className = 'time';
          time.textContent = fmtTime(row.created_at);
          const sm = document.createElement('small');
          sm.textContent = relTime(row.created_at) + ' · #' + row.id;
          time.appendChild(sm);

          const badge = document.createElement('span');
          badge.className = 'badge ' + lab.cls;
          badge.textContent = lab.text;

          const grow = document.createElement('div');
          grow.className = 'grow';
          grow.textContent = fmtBytes(row.bytes);

          const viewBtn = document.createElement('button');
          viewBtn.className = 'act view';
          viewBtn.textContent = '预览';

          const rollBtn = document.createElement('button');
          rollBtn.className = 'act roll';
          rollBtn.textContent = '回滚到此';
          if (idx === 0) {
            rollBtn.disabled = true;
            rollBtn.title = '这已是最新一次快照';
          }

          line.appendChild(time);
          line.appendChild(badge);
          if (idx === 0) {
            const cur = document.createElement('span');
            cur.className = 'badge cur';
            cur.textContent = '当前';
            line.appendChild(cur);
          }
          line.appendChild(grow);
          line.appendChild(viewBtn);
          line.appendChild(rollBtn);
          box.appendChild(line);

          // 预览面板（懒加载，点开才请求）
          const panel = document.createElement('div');
          panel.className = 'snapshot';
          panel.style.display = 'none';
          box.appendChild(panel);

          let loaded = false;
          viewBtn.onclick = async () => {
            if (panel.style.display !== 'none') {
              panel.style.display = 'none';
              viewBtn.textContent = '预览';
              return;
            }
            panel.style.display = '';
            if (!loaded) {
              panel.innerHTML = '<div class="diff-none" style="padding:8px 0">加载中…</div>';
              const r = await fetch('/api/content/revisions?revisionId=' + row.id, {
                headers: { accept: 'application/json' },
              }).then((x) => x.json()).catch(() => null);
              if (!r || !r.ok) {
                panel.innerHTML = '<div class="diff-none">' + esc((r && r.error) || '快照读取失败') + '</div>';
                return;
              }
              const data = r.revision.data || {};
              const sumRows = summarize(data);
              const diffs = diffFields(data, currentData);
              const sumHtml = sumRows.length
                ? sumRows.map(([k, v]) => '<div class="sum-row"><span class="k">' + esc(k) + '</span><span class="v">' + esc(v) + '</span></div>').join('')
                : '<div class="diff-none">（无关键字段）</div>';
              const diffHtml = diffs.length
                ? diffs.map((d) => '<div class="diff-row"><span class="k">' + esc(d.label) + '</span><span class="from">' + esc(d.from) + '</span>→<span class="to">' + esc(d.to) + '</span></div>').join('')
                : '<div class="diff-none">与当前线上内容一致</div>';
              panel.innerHTML =
                '<div class="sum"><div class="sum-title">快照摘要</div>' + sumHtml + '</div>' +
                '<div class="diff"><div class="diff-title">与当前线上内容的差异</div>' + diffHtml + '</div>' +
                '<details><summary>完整 JSON</summary><pre class="json">' + esc(JSON.stringify(data, null, 2)) + '</pre></details>';
              loaded = true;
            }
            viewBtn.textContent = '收起';
          };

          rollBtn.onclick = async () => {
            const ok = await confirmDialog(
              '回滚到 ' + fmtTime(row.created_at) + '（#' + row.id + '）？\n\n' +
              '当前内容会被这个旧快照整体覆盖。回滚后需要在后台点「发布」才会在前台生效。',
              { danger: true }
            );
            if (!ok) return;
            rollBtn.disabled = true;
            rollBtn.textContent = '回滚中…';
            const r = await fetch('/api/content/revisions', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ id: entryId, revisionId: row.id }),
            }).then((x) => x.json()).catch(() => ({}));
            if (r.ok) {
              toast(r.message || '已回滚');
              await load();
            } else {
              toast(r.error || '回滚失败', false);
              rollBtn.disabled = false;
              rollBtn.textContent = '回滚到此';
            }
          };
        });
      }

      (async () => {
        const me = await fetch('/api/admin/me').then((r) => r.json()).catch(() => ({ authed: false }));
        if (!me.authed) {
          location.href = '/admin/login';
          return;
        }
        await load();
      })();
    </script>
  </body>
</html>
