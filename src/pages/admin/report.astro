---
// 运营报表（运营仪表盘）：内容表现 + 流量统计，仅运营/编辑访问。
// 纯静态页面：token 输入 → 客户端 fetch /api/report?token= → 渲染。
// 说明：本页卡片/表格/图表均由脚本 innerHTML 动态生成，故样式必须用 <style is:global>
//       （Astro 默认 scoped 样式不会命中动态插入的节点）；全部选择器以 .rk-page 前缀收敛。
import Base from '../../layouts/Base.astro';
import { getLocale, type Locale } from '../../lib/i18n';

const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocale(Astro);
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);
---

<Base title={t('运营报表', 'Operations Report')}>
  <section class="rk-page">
    <header class="rk-hero">
      <div class="rk-hero-glow" aria-hidden="true"></div>
      <div class="rk-hero-inner">
        <span class="rk-badge">● {t('实时数据', 'Live data')}</span>
        <h1>{t('运营报表', 'Operations Report')}</h1>
        <p>{t('流量统计与内容表现一站式视图。输入运营令牌即可查看。', 'Traffic analytics and content performance in one view. Enter the operator token to load.')}</p>
      </div>
    </header>

    <div class="rk-tokenbar">
      <div class="rk-field">
        <span class="rk-field-ico" aria-hidden="true">🔑</span>
        <input
          id="rk-token"
          type="password"
          autocomplete="off"
          placeholder={t('输入运营令牌 (ADMIN_TOKEN)', 'Enter operator token (ADMIN_TOKEN)')}
        />
      </div>
      <button type="button" class="rk-btn" id="rk-load">
        <span class="rk-btn-ico" aria-hidden="true">↻</span>
        <span>{t('加载报表', 'Load report')}</span>
      </button>
    </div>
    <p class="rk-status" id="rk-status" aria-live="polite"></p>

    <div id="rk-report" hidden>
      <section class="rk-panel">
        <div class="rk-panel-head">
          <h2><span class="rk-h-ico">📈</span>{t('流量概览', 'Traffic Overview')}</h2>
          <span class="rk-panel-sub" id="rk-traffic-sub"></span>
        </div>
        <div class="rk-kpis" id="rk-traffic-cards"></div>
        <div id="rk-traffic"></div>
      </section>

      <section class="rk-panel">
        <div class="rk-panel-head">
          <h2><span class="rk-h-ico">🧩</span>{t('内容互动', 'Content Engagement')}</h2>
        </div>
        <div class="rk-minis" id="rk-totals"></div>
      </section>

      <section class="rk-panel">
        <div class="rk-panel-head">
          <h2><span class="rk-h-ico">🔥</span>{t('热门内容（有帮助最多）', 'Top content (most helpful)')}</h2>
        </div>
        <div id="rk-hot"></div>
      </section>

      <section class="rk-panel">
        <div class="rk-panel-head">
          <h2><span class="rk-h-ico">❄️</span>{t('待优化（差评/零好评）', 'Needs work (low / no helpful)')}</h2>
        </div>
        <div id="rk-cold"></div>
      </section>

      <section class="rk-panel">
        <div class="rk-panel-head">
          <h2><span class="rk-h-ico">🔎</span>{t('搜索需求缺口（零结果）', 'Search gaps (zero results)')}</h2>
        </div>
        <div id="rk-gaps"></div>
      </section>
    </div>
  </section>
</Base>

<script is:inline>
  function t(zh, en) { return document.documentElement.lang === 'en' ? en : zh; }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
    });
  }

  var TOKEN_KEY = 'tackix_report_token';
  var tokenInput = document.getElementById('rk-token');
  var loadBtn = document.getElementById('rk-load');
  var statusEl = document.getElementById('rk-status');
  var reportEl = document.getElementById('rk-report');

  try { var saved = localStorage.getItem(TOKEN_KEY); if (saved) tokenInput.value = saved; } catch (e) {}

  var titleMap = {};
  fetch('/knowledge-index.json').then(function (r) { return r.ok ? r.json() : {}; }).then(function (m) {
    titleMap = m || {};
  }).catch(function () { titleMap = {}; });

  function titleOf(slug) {
    var rec = titleMap[slug];
    if (rec) return document.documentElement.lang === 'en' ? (rec.en || rec.zh || slug) : (rec.zh || rec.en || slug);
    return slug;
  }
  function articleUrl(slug) {
    var p = document.documentElement.lang === 'en' ? '/en/knowledge/' : '/knowledge/';
    return p + slug;
  }

  function setStatus(msg, kind) {
    statusEl.textContent = msg || '';
    statusEl.className = 'rk-status' + (kind ? ' is-' + kind : '');
  }

  var fmt = function (n) {
    n = Number(n) || 0;
    return n >= 1000 ? n.toLocaleString() : String(n);
  };
  var rank = function (i) { return '<span class="rk-rank">' + (i + 1) + '</span>'; };

  // ---------- 卡片 ----------
  function kpi(icon, label, value, color) {
    return '<div class="rk-kpi" style="--c:' + color + '">' +
      '<span class="rk-kpi-ico" aria-hidden="true">' + icon + '</span>' +
      '<span class="rk-kpi-body"><span class="rk-kpi-v">' + esc(fmt(value)) + '</span>' +
      '<span class="rk-kpi-l">' + esc(label) + '</span></span></div>';
  }
  function miniStat(icon, label, value, color) {
    return '<div class="rk-mini" style="--c:' + color + '">' +
      '<span class="rk-mini-ico" aria-hidden="true">' + icon + '</span>' +
      '<span class="rk-mini-body"><span class="rk-mini-v">' + esc(fmt(value)) + '</span>' +
      '<span class="rk-mini-l">' + esc(label) + '</span></span></div>';
  }

  // ---------- 表格 ----------
  function table(headers, bodyHtml, emptyMsg) {
    if (!bodyHtml) return '<div class="rk-empty">' + esc(emptyMsg) + '</div>';
    return '<div class="rk-table-wrap"><table class="rk-table"><thead><tr>' +
      headers.map(function (h) { return '<th>' + esc(h) + '</th>'; }).join('') +
      '</tr></thead><tbody>' + bodyHtml + '</tbody></table></div>';
  }

  function rowHtml(item, i, kind) {
    var title = titleOf(item.slug);
    var link = '<a href="' + esc(articleUrl(item.slug)) + '" target="_blank" rel="noopener">' + esc(title) + '</a>';
    var rate = Math.round(item.rate * 100);
    // 热文看「好评率」，冷文看「差评率」= 100 - 好评率；数值与进度条口径保持一致
    var shown = kind === 'cold' ? (100 - rate) : rate;
    var cls = kind === 'cold' ? 'is-cold' : 'is-hot';
    return '<tr>' +
      '<td class="rk-rankcell">' + rank(i) + '</td>' +
      '<td class="rk-name">' + link + '</td>' +
      '<td class="num">' + item.yes + '</td>' +
      '<td class="num muted">' + item.no + '</td>' +
      '<td class="rk-ratecell"><span class="rk-ratebar"><span class="rk-ratefill ' + cls + '" style="width:' + shown + '%"></span></span>' +
        '<span class="rk-rateval">' + shown + '%</span></td></tr>';
  }

  function renderGaps(gaps) {
    if (!gaps || !gaps.length) return '<div class="rk-empty">' + esc(t('暂无搜索缺口记录', 'No zero-result searches recorded yet.')) + '</div>';
    return gaps.map(function (g) {
      var notes = (g.notes || []).map(function (n) { return '<li>' + esc(n) + '</li>'; }).join('');
      return '<div class="rk-gap"><div class="rk-gap-head"><span class="rk-gap-term">“' + esc(g.term) + '”</span>' +
        '<span class="rk-gap-badge">×' + g.count + '</span></div>' +
        (notes ? '<ul class="rk-gap-notes">' + notes + '</ul>' : '') + '</div>';
    }).join('');
  }

  // ---------- 分布 ----------
  function distRow(label, value, max, total, iconHtml, color) {
    var pct = max > 0 ? Math.round((value / max) * 100) : 0;
    var share = total > 0 ? Math.round((value / total) * 100) : 0;
    return '<div class="rk-dist" style="--c:' + color + '">' +
      '<span class="rk-dist-ico">' + iconHtml + '</span>' +
      '<span class="rk-dist-name">' + esc(label) + '</span>' +
      '<span class="rk-dist-track"><span class="rk-dist-fill" style="width:' + pct + '%"></span></span>' +
      '<span class="rk-dist-num">' + fmt(value) + '<em>' + share + '%</em></span></div>';
  }

  var DEV_META = {
    desktop: ['🖥️', '#7c6cf0'], mobile: ['📱', '#22a6b3'], tablet: ['📲', '#f0a020'],
    bot: ['🤖', '#8a8f98'], unknown: ['❓', '#b0b4bb']
  };
  var BR_META = {
    chrome: '#4285f4', safari: '#0a84ff', edge: '#0aa1dd', firefox: '#ff7139',
    opera: '#ff1b2d', chromium: '#7c6cf0', ie: '#00a4ef', bot: '#8a8f98', other: '#9aa0a6'
  };
  var BR_LABEL = { chrome: 'Chrome', safari: 'Safari', edge: 'Edge', firefox: 'Firefox', opera: 'Opera', chromium: 'Chromium', ie: 'IE', bot: 'Bot', other: 'Other' };

  function shortRef(ref) {
    if (!ref || ref === '(direct)') return t('直接访问', 'Direct');
    if (ref === '(internal)') return t('站内跳转', 'Internal');
    try { var u = new URL(ref); return u.hostname.replace(/^www\./, '') + (u.pathname && u.pathname !== '/' ? u.pathname : ''); }
    catch (e) { return ref; }
  }

  // ---------- 趋势 SVG ----------
  function buildTrend(trend) {
    if (!trend || !trend.length) return '<div class="rk-empty rk-empty--chart">' + esc(t('暂无访问趋势数据', 'No trend data yet')) + '</div>';
    var W = 760, H = 190, padL = 10, padR = 10, padT = 18, padB = 30;
    var n = trend.length, max = 0, totalPv = 0, i;
    for (i = 0; i < n; i++) { if (trend[i].c > max) max = trend[i].c; totalPv += trend[i].c; }
    var scaleMax = max > 0 ? max : 1;
    var innerW = W - padL - padR, innerH = H - padT - padB;
    var X = function (k) { return padL + (n === 1 ? innerW / 2 : (k * innerW) / (n - 1)); };
    var Y = function (v) { return padT + innerH - (v / scaleMax) * innerH; };
    var line = '', pts = [];
    for (i = 0; i < n; i++) {
      var px = X(i), py = Y(trend[i].c); pts.push([px, py]);
      line += (i ? 'L' : 'M') + px.toFixed(1) + ' ' + py.toFixed(1) + ' ';
    }
    var baseY = (padT + innerH).toFixed(1);
    var area = line + 'L' + pts[n - 1][0].toFixed(1) + ' ' + baseY + ' L' + pts[0][0].toFixed(1) + ' ' + baseY + ' Z';
    var grid = '';
    for (var g = 0; g <= 3; g++) {
      var gy = (padT + (innerH * g) / 3).toFixed(1);
      var val = Math.round(scaleMax * (1 - g / 3));
      grid += '<line class="grid" x1="' + padL + '" y1="' + gy + '" x2="' + (W - padR) + '" y2="' + gy + '"/>';
      grid += '<text class="ax" x="' + (W - padR) + '" y="' + (gy - 4) + '" text-anchor="end">' + val + '</text>';
    }
    var dots = '';
    for (i = 0; i < n; i++) {
      dots += '<circle class="dot" cx="' + pts[i][0].toFixed(1) + '" cy="' + pts[i][1].toFixed(1) + '" r="3.2"><title>' +
        esc(trend[i].day) + ' · PV ' + trend[i].c + ' · UV ' + trend[i].u + '</title></circle>';
    }
    var step = Math.max(1, Math.ceil(n / 6));
    var xlabels = '';
    for (i = 0; i < n; i += step) {
      xlabels += '<text class="ax" x="' + X(i).toFixed(1) + '" y="' + (padT + innerH + 18) + '" text-anchor="middle">' + esc(trend[i].day.slice(5)) + '</text>';
    }
    var svg = '<svg class="rk-svg" viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="xMidYMid meet" role="img">' +
      '<defs><linearGradient id="rkTrendGrad" x1="0" y1="0" x2="0" y2="1">' +
      '<stop offset="0%" class="g-stop-a"/><stop offset="100%" class="g-stop-b"/></linearGradient></defs>' +
      grid +
      '<path class="area" d="' + area + '"/>' +
      '<path class="line" d="' + line + '"/>' +
      dots + xlabels + '</svg>';
    return '<div class="rk-chart">' + svg + '</div>';
  }

  // ---------- 渲染 ----------
  function renderTraffic(tr) {
    if (!tr) {
      document.getElementById('rk-traffic-cards').innerHTML = '';
      document.getElementById('rk-traffic-sub').textContent = '';
      document.getElementById('rk-traffic').innerHTML =
        '<div class="rk-empty">' + esc(t('流量数据库未配置（缺少 D1 DB 绑定），暂无法统计访问量。', 'Traffic database not configured (D1 DB binding missing), visit stats unavailable.')) + '</div>';
      return;
    }
    document.getElementById('rk-traffic-cards').innerHTML =
      kpi('👁️', t('累计访问量 PV', 'Total PV'), tr.totalPv, '#7c6cf0') +
      kpi('👤', t('累计访客 UV', 'Total UV'), tr.totalUv, '#22a6b3') +
      kpi('📅', t('今日 PV', "Today's PV"), tr.todayPv, '#f0a020') +
      kpi('🧭', t('今日 UV', "Today's UV"), tr.todayUv, '#e0529c');

    var trendPv = 0;
    (tr.trend || []).forEach(function (d) { trendPv += d.c; });
    document.getElementById('rk-traffic-sub').textContent = t('今日 ' + (tr.today || ''), 'Today ' + (tr.today || ''));

    var devTotal = 0; (tr.devDist || []).forEach(function (d) { devTotal += d.c; });
    var devMax = 0; (tr.devDist || []).forEach(function (d) { if (d.c > devMax) devMax = d.c; });
    var devHtml = (tr.devDist || []).map(function (d) {
      var meta = DEV_META[d.dev] || DEV_META.unknown;
      return distRow(d.dev, d.c, devMax, devTotal, '<span class="rk-emoji">' + meta[0] + '</span>', meta[1]);
    }).join('') || '<div class="rk-empty">' + esc(t('暂无数据', 'No data')) + '</div>';

    var brTotal = 0; (tr.brDist || []).forEach(function (d) { brTotal += d.c; });
    var brMax = 0; (tr.brDist || []).forEach(function (d) { if (d.c > brMax) brMax = d.c; });
    var brHtml = (tr.brDist || []).map(function (d) {
      var color = BR_META[d.br] || BR_META.other;
      return distRow(BR_LABEL[d.br] || d.br, d.c, brMax, brTotal, '<span class="rk-dotfill" style="--c:' + color + '"></span>', color);
    }).join('') || '<div class="rk-empty">' + esc(t('暂无数据', 'No data')) + '</div>';

    var topPagesHtml = table(
      ['', t('页面', 'Page'), t('PV', 'PV'), t('UV', 'UV')],
      (tr.topPages || []).map(function (p, i) {
        return '<tr><td class="rk-rankcell">' + rank(i) + '</td><td class="rk-name rk-mono">' + esc(p.path) + '</td>' +
          '<td class="num">' + fmt(p.c) + '</td><td class="num muted">' + fmt(p.u) + '</td></tr>';
      }).join(''),
      t('暂无访问记录', 'No visits recorded yet.')
    );

    var topRefHtml = table(
      ['', t('来源', 'Referrer'), t('次数', 'Count')],
      (tr.topRef || []).map(function (r, i) {
        return '<tr><td class="rk-rankcell">' + rank(i) + '</td><td class="rk-name" title="' + esc(r.ref) + '">' + esc(shortRef(r.ref)) + '</td>' +
          '<td class="num">' + fmt(r.c) + '</td></tr>';
      }).join(''),
      t('暂无来源记录', 'No referrers recorded yet.')
    );

    document.getElementById('rk-traffic').innerHTML =
      '<div class="rk-chart-head"><h3>' + esc(t('近 30 天访问趋势（PV）', 'Last 30 days trend (PV)')) + '</h3>' +
        '<span class="rk-chart-total">PV ' + esc(fmt(trendPv)) + '</span></div>' +
      buildTrend(tr.trend) +
      '<div class="rk-grid2">' +
        '<div class="rk-subpanel"><h3>' + esc(t('热门页面 Top 10', 'Top 10 pages')) + '</h3>' + topPagesHtml + '</div>' +
        '<div class="rk-subpanel"><h3>' + esc(t('主要来源 Top 10', 'Top 10 referrers')) + '</h3>' + topRefHtml + '</div>' +
      '</div>' +
      '<div class="rk-grid2">' +
        '<div class="rk-subpanel"><h3>' + esc(t('设备分布', 'Device distribution')) + '</h3>' + devHtml + '</div>' +
        '<div class="rk-subpanel"><h3>' + esc(t('浏览器分布', 'Browser distribution')) + '</h3>' + brHtml + '</div>' +
      '</div>';
  }

  function render(data) {
    reportEl.hidden = false;
    var totals = data.totals || {};
    document.getElementById('rk-totals').innerHTML =
      miniStat('📝', t('已评分文章', 'Articles rated'), totals.articlesRated || 0, '#7c6cf0') +
      miniStat('💬', t('反馈事件', 'Feedback events'), totals.feedbackEvents || 0, '#22a6b3') +
      miniStat('🔍', t('搜索缺口', 'Search gaps'), totals.gaps || 0, '#f0a020');

    document.getElementById('rk-hot').innerHTML = table(
      ['', t('文章', 'Article'), t('有帮助', 'Helpful'), t('没帮助', 'Not'), t('好评率', 'Rate')],
      (data.hot || []).map(function (it, i) { return rowHtml(it, i, 'hot'); }).join(''),
      t('还没有「有帮助」反馈', 'No "helpful" feedback recorded yet.')
    );

    document.getElementById('rk-cold').innerHTML = table(
      ['', t('文章', 'Article'), t('有帮助', 'Helpful'), t('没帮助', 'Not'), t('差评率', 'Low rate')],
      (data.cold || []).map(function (it, i) { return rowHtml(it, i, 'cold'); }).join(''),
      t('没有差评或零好评内容', 'No poorly-rated content.')
    );

    document.getElementById('rk-gaps').innerHTML = renderGaps(data.gaps);
    renderTraffic(data.traffic);
  }

  function load() {
    var token = (tokenInput.value || '').trim();
    if (!token) { setStatus(t('请先输入运营令牌', 'Enter the operator token first.'), 'err'); return; }
    try { localStorage.setItem(TOKEN_KEY, token); } catch (e) {}
    loadBtn.disabled = true;
    loadBtn.classList.add('is-loading');
    setStatus(t('加载中…', 'Loading…'));
    fetch('/api/report?token=' + encodeURIComponent(token))
      .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
      .then(function (res) {
        var b = res.body || {};
        if (res.status === 401 || b.reason === 'unauthorized') {
          setStatus(t('令牌无效', 'Invalid token.'), 'err'); reportEl.hidden = true; return;
        }
        if (b.reason === 'not configured') {
          setStatus(t('报表未启用：请在 Cloudflare 配置 ADMIN_TOKEN 与 FEEDBACK_KV。', 'Report disabled: set ADMIN_TOKEN and FEEDBACK_KV on Cloudflare.'), 'err'); reportEl.hidden = true; return;
        }
        if (b.reason === 'no KV binding') {
          setStatus(t('后端存储未配置（FEEDBACK_KV 缺失），报表暂不可用。', 'Backend storage not configured (FEEDBACK_KV missing).'), 'err'); reportEl.hidden = true; return;
        }
        if (!b.ok) {
          setStatus(t('加载失败：' + (b.reason || 'unknown'), 'Failed: ' + (b.reason || 'unknown')), 'err'); reportEl.hidden = true; return;
        }
        setStatus(t('已更新 · ' + new Date(b.generatedAt).toLocaleString(), 'Updated · ' + new Date(b.generatedAt).toLocaleString()), 'ok');
        render(b);
      })
      .catch(function () {
        setStatus(t('网络错误：无法连接报表接口。', 'Network error: cannot reach the report API.'), 'err'); reportEl.hidden = true;
      })
      .finally(function () { loadBtn.disabled = false; loadBtn.classList.remove('is-loading'); });
  }

  loadBtn.addEventListener('click', load);
  tokenInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') load(); });
  // 已保存令牌则自动加载，省一次点击
  if ((tokenInput.value || '').trim()) load();
</script>

<style is:global>
  /* 说明：本页内容由脚本动态生成，必须使用全局样式（scoped 不会命中 innerHTML 节点）。
     全部规则以 .rk-page 收敛，且本组件仅在本页渲染，不会外泄到其他页面。 */
  .rk-page {
    max-width: 1040px;
    margin: 0 auto;
    --rk-radius: 16px;
  }

  /* ---------- Hero ---------- */
  .rk-hero {
    position: relative;
    overflow: hidden;
    padding: 30px 32px;
    border-radius: 22px;
    border: 1px solid var(--border);
    background:
      radial-gradient(130% 150% at 100% 0%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 58%),
      var(--surface);
    box-shadow: var(--shadow-sm);
    margin-bottom: 20px;
  }
  .rk-hero-glow {
    position: absolute;
    top: -70px;
    right: -50px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%);
    filter: blur(6px);
    pointer-events: none;
  }
  .rk-hero-inner { position: relative; z-index: 1; }
  .rk-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .rk-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 14px 0 8px;
    color: var(--fg);
  }
  .rk-hero p { margin: 0; color: var(--muted); font-size: 14.5px; max-width: 60ch; }

  /* ---------- 令牌栏 ---------- */
  .rk-tokenbar {
    display: flex;
    gap: 12px;
    max-width: 640px;
    margin: 0 auto 6px;
  }
  .rk-field {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--surface);
    transition: border-color 0.18s, box-shadow 0.18s;
  }
