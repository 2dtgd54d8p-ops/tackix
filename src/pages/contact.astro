---
/**
 * 联系页
 * ---------------------------------------------------------------
 * 设计要点：
 * 1. **联系方式优先于表单**。B2B 买家看完参数表后的下一步是「找谁问」。
 *    预上线期表单被闸门关闭，此时联系方式是唯一转化入口，必须放最上面。
 * 2. **全部字段可留空**，留空则对应入口不渲染 —— 不会出现空链接或占位符
 *    （比显示「待补充」更专业，也避免误导买家）。
 * 3. 预上线期在表单区明确说明状态，避免买家反复提交却收不到回复。
 * 4. 全站 EN-only，文案来自后台「联系页文案」singleton（可编辑、前后端贯通）。
 */
import Base from '../layouts/Base.astro';
import { loadSiteData, loadContent } from '../lib/site-data';
import { organizationSchema } from '../lib/schema';
import { isPreLaunch } from '../lib/prelaunch';
import { getLocale, type Locale } from '../lib/i18n';

const { locale: localeProp } = Astro.props;
const locale: Locale = localeProp ?? getLocale(Astro);
const lp = locale === 'en' ? '/en' : '';
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);

const { site } = await loadSiteData(locale);
const prelaunch = isPreLaunch();
// 联系页文案来自后台「联系页文案」singleton（可编辑、前后端贯通）
const L = await loadContent(locale);
const contact = L.contact;
const successMsg = contact.success;

const email = (site.email ?? '').trim();
const company = (site.company ?? '').trim();
const phone = (site.phone ?? '').trim();
const address = (site.address ?? '').trim();
const hours = (site.hours ?? '').trim();
const whatsapp = (site.whatsapp ?? '').replace(/[^0-9]/g, '');
const waText = encodeURIComponent(
  (site.whatsappPrefill ?? '').trim() ||
    'Hello, I would like a quotation for industrial adhesives. Could you share TDS/SDS and technical support?'
);

// 有任一联系方式才渲染该区块
const hasContact = !!(email || whatsapp || phone || address || company || hours);
const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : '';
const mailHref = email
  ? `mailto:${email}?subject=${encodeURIComponent('Product selection & quotation enquiry · ' + (company || 'Tackix'))}`
  : '';
const ICON = {
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3 6 9 6.5L21 6"/>',
  phone: '<path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"/>',
  pin: '<path d="M12 21s7-5.3 7-11a7 7 0 1 0-14 0c0 5.7 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  building: '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 10h2m-2 4h2m2-4h2m-2 4h2"/>',
};

// 组织实体（含 ContactPoint），强化 E-E-A-T 与「公司实体」识别
const orgLd = {
  '@context': 'https://schema.org',
  ...organizationSchema(locale, site, Astro.site ?? Astro.url),
};
---

<Base title={contact.pageTitle}>
  <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  <section>
    <div class="page-head">
      <h1>{contact.pageTitle}</h1>
      <p>{contact.pageSub}</p>
    </div>

    <div class:list={['contact-grid', !hasContact && 'contact-grid--single']}>
      {
        hasContact && (
          <div class="contact-info">
            <h2 class="section-title">{contact.contactInfoTitle}</h2>

            {email && (
              <a class="contact-item" href={mailHref}>
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.mail} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">{t('商务邮箱', 'Business email')}</span>
                  <span class="ci-value">{email}</span>
                </span>
              </a>
            )}

            {whatsapp && (
              <a class="contact-item" href={`https://wa.me/${whatsapp}?text=${waText}`} target="_blank" rel="noopener">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.2.7-1.3 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.8-.7-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.8-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .7.5l.9 2.2c.1.2.1.4 0 .6l-.4.6-.3.3c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.3.2.5.1.7-.1l.8-1c.2-.2.4-.2.6-.1l2.1 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
                </span>
                <span class="ci-body">
                  <span class="ci-label">{t('WhatsApp', 'WhatsApp')}</span>
                  <span class="ci-value">+{whatsapp}</span>
                </span>
              </a>
            )}

            {phone && (
              <a class="contact-item" href={telHref}>
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.phone} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">{t('电话', 'Phone')}</span>
                  <span class="ci-value">{phone}</span>
                </span>
              </a>
            )}

            {company && (
              <div class="contact-item contact-item-static">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.building} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">{t('公司', 'Company')}</span>
                  <span class="ci-value">{company}</span>
                </span>
              </div>
            )}

            {address && (
              <div class="contact-item contact-item-static">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.pin} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">{t('地址', 'Address')}</span>
                  <span class="ci-value">{address}</span>
                </span>
              </div>
            )}

            {hours && (
              <div class="contact-item contact-item-static">
                <span class="ci-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={ICON.clock} />
                </span>
                <span class="ci-body">
                  <span class="ci-label">{t('营业时间', 'Business hours')}</span>
                  <span class="ci-value">{hours}</span>
                </span>
              </div>
            )}
          </div>
        )
      }

      <div class="contact-form-wrap">
        <h2 class="section-title">{contact.formSectionTitle}</h2>
        {
          prelaunch && (
            <div class="notice">
              <strong>{contact.prelaunchTitle}</strong>
              <p>{contact.prelaunchBody}</p>
            </div>
          )
        }
        <form id="contact-form" class="contact-form" novalidate>
          <label class="field">
            <span>{contact.formName}</span>
            <input name="name" type="text" required maxlength="60" autocomplete="name" />
          </label>
          <label class="field">
            <span>{contact.formEmail}</span>
            <input name="email" type="email" required maxlength="120" autocomplete="email" />
          </label>
          <label class="field">
            <span>{contact.formMsg}</span>
            <textarea name="message" required rows="5" maxlength="2000"
              placeholder={t('例如：铝粘 FRP，持续振动，-40~85℃，0.5mm 间隙，需 TDS。', 'e.g. Bonding aluminium to FRP, constant vibration, -40~85℃, 0.5mm gap, TDS required.')}></textarea>
          </label>
          <button type="submit" class="btn btn-primary">{contact.submit}</button>
          <p id="contact-status" class="status" role="status" aria-live="polite" data-success={successMsg}></p>
        </form>
        <div class="tips-box">
          <h3>{contact.tipsTitle}</h3>
          <ul class="tips-list">
            {contact.tipsItems.map((tip) => <li>{tip}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid; gap: 40px; align-items: start;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
  }
  /* 无联系方式可显示时，退化为单栏：否则 grid 会保留空的 320px 左列，
     把右侧表单压到半幅宽，视觉上像是"内容丢了" */
  .contact-grid--single { grid-template-columns: minmax(0, 1fr); }
  .contact-grid--single .contact-form { max-width: 100%; }

  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-info { display: grid; gap: 10px; align-content: start; }
  .contact-item {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 13px 15px; border-radius: var(--r-md);
    background: var(--surface); border: 1px solid var(--border);
    color: inherit; text-decoration: none;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  a.contact-item:hover { border-color: var(--accent); background: var(--surface-2); text-decoration: none; }

  .ci-icon { color: var(--accent); flex-shrink: 0; margin-top: 2px; }
  .ci-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ci-label { font-size: 12px; color: var(--faint); letter-spacing: 0.03em; }
  .ci-value { font-size: 14.5px; color: var(--fg); word-break: break-word; line-height: 1.5; }

  .notice {
    padding: 13px 16px; border-radius: var(--r-md); margin-bottom: 18px;
    font-size: 14px; line-height: 1.7;
    background: var(--surface-2); border: 1px solid var(--border); color: var(--fg-soft);
  }
  .notice strong { display: block; margin-bottom: 4px; color: var(--fg); }
  .notice p { margin: 0; }

  .contact-form {
    display: flex; flex-direction: column; gap: 18px;
    max-width: 560px;
    padding: 26px 24px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .contact-form .btn { align-self: flex-start; }
  .contact-form .status { text-align: left; }

  .tips-box {
    margin-top: 22px; padding: 18px 20px;
    border: 1px solid var(--border); border-radius: var(--r-md);
    background: var(--surface);
  }
  .tips-box h3 { margin: 0 0 10px; font-size: 15px; color: var(--fg); }
  .tips-list { margin: 0; padding-left: 18px; color: var(--muted); font-size: 14px; line-height: 1.9; }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');
    if (!form) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      status.textContent = 'Submitting…';
      status.className = 'status';

      const data = Object.fromEntries(new FormData(form).entries());
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (res.ok && json.ok) {
          status.textContent = status.dataset.success || 'Thank you — your enquiry has been received.';
          status.className = 'status ok';
          form.reset();
        } else {
          status.textContent = 'Submission failed: ' + (json.error || 'unknown error');
          status.className = 'status err';
        }
      } catch (err) {
        status.textContent = 'Submission failed: ' + (err && err.message ? err.message : err);
        status.className = 'status err';
      }
    });
  })();
</script>
