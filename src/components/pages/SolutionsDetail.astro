---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import { loadSiteData } from '../../lib/site-data';
import { readingMinutes, coverSrc } from '../../lib/markdown';
import CtxSuggest from '../CtxSuggest.astro';
import { pickB, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const lp = locale === 'en' ? '/en' : '';
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);
const detail_bottomline_label = t('一句话结论', 'Bottom line');

const reader = createReader(process.cwd(), keystaticConfig);
let item: any = null;
try {
  item = await reader.collections.scenarios.read(slug);
} catch (e) {
  console.warn('[build] 读取场景失败：', slug, e);
}

if (!item) {
  Astro.response.status = 404;
}

const { categoryLabel, tagLabel } = await loadSiteData(locale);

const scenario = item ? { slug, ...item } : null;

// 分类页主内容：该场景下的知识库文章（按 scenario 字段过滤到当前场景 slug）。
let articles: any[] = [];
if (scenario) {
  try {
    const kSlugs = await reader.collections.knowledge.list();
    const kItems = await Promise.all(
      kSlugs.map(async (kslug: string) => {
        try {
          const k: any = await reader.collections.knowledge.read(kslug);
          if (!k || k.published === false) return null;
          if ((k.scenario ?? 'none') !== slug) return null;
          return { slug: kslug, ...k };
        } catch {
          return null;
        }
      })
    );
    articles = kItems.filter(Boolean);
  } catch {
    /* 知识库读取失败则列表为空，不影响分类页其余部分 */
  }
}
articles.sort((a: any, b: any) =>
  String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? ''))
);

// 分类页结构化数据：CollectionPage + ItemList（逐篇文章为 Article 条目）
const jsonLd: any = scenario
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: pickB(locale, scenario.name),
      description: pickB(locale, scenario.excerpt) || '',
      url: (Astro.site ?? Astro.url).href,
      inLanguage: locale === 'en' ? 'en' : 'zh-CN',
      hasPart: articles.map((a) => ({
        '@type': 'Article',
        '@id': new URL(`${lp}/knowledge/${a.slug}`, Astro.site ?? Astro.url).href,
        headline: pickB(locale, a.name),
        url: new URL(`${lp}/knowledge/${a.slug}`, Astro.site ?? Astro.url).href,
        description: pickB(locale, a.excerpt) || '',
      })),
    }
  : null;
---

{
  !scenario ? (
    <Base title={t('未找到', 'Not found')}>
      <section>
        <div class="page-head">
          <h1>{t('方案未找到', 'Scenario not found')}</h1>
          <p>{t('该方案可能已下架或移动。', 'This scenario may have been unpublished or moved.')}</p>
          <a class="btn btn-primary" href={`${lp}/solutions`}>{t('返回方案列表', 'Back to Solutions')}</a>
        </div>
      </section>
    </Base>
  ) : (
    <Base title={pickB(locale, scenario.name)} description={pickB(locale, scenario.excerpt) || ''}>
      {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
      <section class="cat-page" data-section="listing">
        <header class="cat-head">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={`${lp}/solutions`}>{t('方案', 'Solutions')}</a>
            <span aria-hidden="true">›</span>
            <span>{pickB(locale, scenario.name)}</span>
          </nav>
          <h1>{pickB(locale, scenario.name)}</h1>
          {pickB(locale, scenario.excerpt) && <p class="lede">{pickB(locale, scenario.excerpt)}</p>}
          {
            scenario.conclusion && (
              <p class="bottomline">
                <span class="bl-tag">{detail_bottomline_label}</span>
                {pickB(locale, scenario.conclusion)}
              </p>
            )
          }
        </header>

        {
          articles.length === 0 ? (
            <p class="empty">{t('该分类下暂无文章。', 'No articles in this category yet.')}</p>
          ) : (
            <div class="grid">
              {articles.map((article: any) => (
                <article class="card">
                  {coverSrc(article.cover) && (
                    <div class="card-media">
                      <img src={coverSrc(article.cover)} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={`${lp}/knowledge/${article.slug}`}>{pickB(locale, article.name)}</a>
                    </h3>
                    {pickB(locale, article.excerpt) && (
                      <p class="card-excerpt">{pickB(locale, article.excerpt)}</p>
                    )}
                    <div class="card-meta">
                      <span class="tag">{categoryLabel(article.category)}</span>
                      {(article.tags ?? []).slice(0, 2).map((tg: string) => (
                        <span class="tag tag-plain">{tagLabel(tg)}</span>
                      ))}
                      <span class="read-time">· {readingMinutes(pickB(locale, article.body))}{t(' 分钟阅读', ' min read')}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </section>

      <div class="post-foot">
        <a class="btn" href={`${lp}/solutions`}>← {t('全部方案', 'All Solutions')}</a>
        <a class="btn btn-primary" href={`${lp}/contact`}>{t('联系我们', 'Contact us')}</a>
      </div>
      <CtxSuggest locale={locale} />
    </Base>
  )
}

<style>
  .cat-page { max-width: var(--maxw); margin: 0 auto; }
  .cat-head {
    text-align: center;
    max-width: 720px;
    margin: 8px auto 36px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 18px;
  }
  .crumbs a { color: var(--faint); }
  .crumbs a:hover { color: var(--accent); }
  .cat-head h1 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    color: var(--fg);
    margin: 0 0 10px;
    letter-spacing: -0.015em;
  }
  .lede {
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }
  .bottomline {
    margin: 18px auto 0;
    max-width: 620px;
    padding: 14px 18px;
    border-radius: var(--r-lg);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--fg);
    font-size: 15px;
    line-height: 1.7;
  }
  .bl-tag {
    display: inline-block;
    margin-right: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
  .empty { text-align: center; color: var(--muted); padding: 44px 0; }
  .post-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin: 44px auto 0;
    max-width: var(--readw);
  }
  @media (max-width: 700px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 18px; } }
</style>
