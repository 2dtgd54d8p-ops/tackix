---
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Base from '../../layouts/Base.astro';
import { loadSiteData, loadContent } from '../../lib/site-data';
import { readingMinutes, coverSrc, renderMarkdown } from '../../lib/markdown';
import { inLanguage } from '../../lib/schema';
import { normalizeSections } from '../../lib/custom-sections';
import CtxSuggest from '../CtxSuggest.astro';
import { pickB, type Locale } from '../../lib/i18n';
import { UPLOADS_BASE } from '../../lib/assets';

interface Props {
  locale: Locale;
  slug: string;
}
const { locale, slug } = Astro.props;
const lp = locale === 'en' ? '/en' : '';
const t = (zh: string, en: string) => (locale === 'en' ? en : zh);
// 详情页区块标题统一收归「详情页区块」单例（后台可编辑，留空回退默认）
const content = await loadContent(locale);
const detail = content.detail;
const detail_bottomline_label = detail.scenarioConclusionTitle;

const reader = createReader(process.cwd(), keystaticConfig);
let item: any = null;
try {
  item = await reader.collections.scenarios.read(slug);
} catch (e) {
  console.warn('[build] 读取场景失败：', slug, e);
}

if (!item) {
  Astro.response.status = 404;
}

const { categoryLabel, tagLabel } = await loadSiteData(locale);

const scenario = item ? { slug, ...item } : null;

// 对比矩阵：解析 recommendedProducts 的 params（"·" 分隔 "[key] value"）为当前语种对齐的行列
function parseParams(p: any) {
  if (!p) return [];
  return String(p)
    .split('·')
    .map((s) => s.trim())
    .filter(Boolean)
    .map((seg) => {
      const m = seg.match(/^\[?([^\]\s:：]+)\]?\s*[:：]?\s*(.*)$/);
      const key = m ? m[1].replace(/^\[|\]$/g, '') : seg;
      const val = m ? m[2] : '';
      return { key, val };
    });
}
const recProducts = scenario?.recommendedProducts ?? [];
const matrix = (() => {
  if (recProducts.length < 1) return null;
  const keyOrder: string[] = [];
  const perProduct = recProducts.map((p: any) => {
    const rows = parseParams(pickB(locale, p.params));
    rows.forEach((r: any) => {
      if (!keyOrder.includes(r.key)) keyOrder.push(r.key);
    });
    return { name: pickB(locale, p.name), slug: typeof p.slug === 'string' ? p.slug.trim() : '', rows };
  });
  return { products: perProduct, keys: keyOrder };
})();

// 分类页主内容：该场景下的知识库文章（按 scenario 字段过滤到当前场景 slug）。
let articles: any[] = [];
if (scenario) {
  try {
    const kSlugs = await reader.collections.knowledge.list();
    const kItems = await Promise.all(
      kSlugs.map(async (kslug: string) => {
        try {
          const k: any = await reader.collections.knowledge.read(kslug);
          if (!k || k.published === false) return null;
          if ((k.scenario ?? 'none') !== slug) return null;
          return { slug: kslug, ...k };
        } catch {
          return null;
        }
      })
    );
    articles = kItems.filter(Boolean);
  } catch {
    /* 知识库读取失败则列表为空，不影响分类页其余部分 */
  }
}
articles.sort((a: any, b: any) =>
  String(b.publishedAt ?? '').localeCompare(String(a.publishedAt ?? ''))
);

// 场景级 FAQ：驱动 FAQPage 结构化数据（利于搜索 / AI 抽取答案卡）
const faqItems = scenario
  ? (scenario.faq ?? [])
      .filter((f: any) => f?.question && f?.answer)
      .map((f: any) => ({
        '@type': 'Question',
        name: pickB(locale, f.question),
        acceptedAnswer: { '@type': 'Answer', text: pickB(locale, f.answer) },
      }))
  : [];
// 自定义内容区块：后台自由组合（标题 / 段落 / 图片 / 提示框 / 引用）
const customSections = normalizeSections(scenario?.customSections);
// 正文（可选）：场景补充说明
const bodyHtml = scenario ? await renderMarkdown(pickB(locale, scenario.body)) : '';

// 分类页结构化数据：CollectionPage + ItemList（逐篇文章为 Article 条目）
const jsonLd: any = scenario
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: pickB(locale, scenario.name),
      description: pickB(locale, scenario.excerpt) || '',
      url: (Astro.site ?? Astro.url).href,
      inLanguage: locale === 'en' ? 'en' : 'zh-CN',
      ...(faqItems.length > 0 && {
        mainEntity: {
          '@type': 'FAQPage',
          mainEntity: faqItems,
          inLanguage: locale === 'en' ? 'en' : 'zh-CN',
        },
      }),
      hasPart: articles.map((a) => ({
        '@type': 'Article',
        '@id': new URL(`${lp}/knowledge/${a.slug}`, Astro.site ?? Astro.url).href,
        headline: pickB(locale, a.name),
        url: new URL(`${lp}/knowledge/${a.slug}`, Astro.site ?? Astro.url).href,
        description: pickB(locale, a.excerpt) || '',
      })),
    }
  : null;
---

{
  !scenario ? (
    <Base title={t('未找到', 'Not found')}>
      <section>
        <div class="page-head">
          <h1>{t('方案未找到', 'Scenario not found')}</h1>
          <p>{t('该方案可能已下架或移动。', 'This scenario may have been unpublished or moved.')}</p>
          <a class="btn btn-primary" href={`${lp}/solutions`}>{t('返回方案列表', 'Back to Solutions')}</a>
        </div>
      </section>
    </Base>
  ) : (
    <Base title={pickB(locale, scenario.name)} description={pickB(locale, scenario.excerpt) || ''}>
      {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
      <section class="cat-page" data-section="listing">
        <header class="cat-head">
          <div class="head-inner">
            <nav class="crumbs" aria-label="Breadcrumb">
              <a href={`${lp}/solutions`}>{t('方案', 'Solutions')}</a>
              <span aria-hidden="true">›</span>
              <span>{pickB(locale, scenario.name)}</span>
            </nav>
            <h1>{pickB(locale, scenario.name)}</h1>
            {pickB(locale, scenario.excerpt) && <p class="lede">{pickB(locale, scenario.excerpt)}</p>}
            {
              scenario.conclusion && (
                <p class="bottomline">
                  <span class="bl-tag">{detail_bottomline_label}</span>
                  {pickB(locale, scenario.conclusion)}
                </p>
              )
            }
          </div>
        </header>

        {/* 封面图（可选） + 正文（可选） + 自定义内容区块（可选） */}
        {
          coverSrc(scenario.cover) && (
            <img class="cover" src={coverSrc(scenario.cover)} alt="" />
          )
        }
        {
          bodyHtml && <div class="scn-body" data-section="body" set:html={bodyHtml} />
        }
        {
          customSections.length > 0 && (
            <section class="custom-sections" aria-label={t('自定义内容', 'Custom content')}>
              {customSections.map((s: any) => {
                if (s.type === 'heading') return <h2 class="csec csec-heading">{s.heading}</h2>;
                if (s.type === 'paragraph')
                  return <p class="csec csec-text" style="white-space:pre-line">{s.text}</p>;
                if (s.type === 'image')
                  return (
                    <figure class="csec csec-image">
                      {s.image && <img src={s.image} alt={s.imageCaption || ''} loading="lazy" />}
                      {s.imageCaption && <figcaption>{s.imageCaption}</figcaption>}
                    </figure>
                  );
                if (s.type === 'callout')
                  return (
                    <div class={`csec csec-callout tone-${s.calloutTone}`}>
                      {s.heading && <strong class="csec-callout-title">{s.heading}</strong>}
                      {s.text && <p>{s.text}</p>}
                    </div>
                  );
                if (s.type === 'quote')
                  return (
                    <blockquote class="csec csec-quote">
                      {s.text}
                      {s.heading && <cite>— {s.heading}</cite>}
                    </blockquote>
                  );
                return null;
              })}
            </section>
          )
        }

        {/* 选型向导：按用户工况高亮对应选型要点 */}
        {
          scenario.selectionLogic && scenario.selectionLogic.length > 0 && (
            <section class="wizard" data-section="wizard" aria-label={t('选型向导', 'Selection wizard')}>
              <div class="wiz-head">
                <h2>{detail.scenarioSelectionTitle}</h2>
                <p class="wiz-sub">{t('勾选你的工况，系统高亮最相关的选型要点。', 'Tick your conditions; we highlight the most relevant criteria.')}</p>
                <div class="wiz-filters" id="wiz-filters">
                  <button type="button" class="wiz-chip" data-kw="水|浸水|湿">长期浸水</button>
                  <button type="button" class="wiz-chip" data-kw="霉">需要防霉</button>
                  <button type="button" class="wiz-chip" data-kw="位移|柔性|沉降">有位移/微动</button>
                  <button type="button" class="wiz-chip" data-kw="温|热">温差大</button>
                  <button type="button" class="wiz-chip is-active" data-kw="">全部</button>
                </div>
              </div>
              <ul class="wiz-list" id="wiz-list">
                {scenario.selectionLogic.map((pt: any) => (
                  <li class="wiz-item" data-text={`${(pickB(locale, pt.title) || '')} ${(pickB(locale, pt.point) || '')}`}>
                    <h3>{pickB(locale, pt.title)}</h3>
                    <p>{pickB(locale, pt.point)}</p>
                  </li>
                ))}
              </ul>
              {scenario.conclusion && <p class="wiz-bottom">{pickB(locale, scenario.conclusion)}</p>}
            </section>
          )
        }

        <section class="scn-articles" data-section="articles" aria-label={detail.scenarioArticlesTitle}>
          <h2>{detail.scenarioArticlesTitle}</h2>
          {
            articles.length === 0 ? (
            <p class="empty">{t('该分类下暂无文章。', 'No articles in this category yet.')}</p>
          ) : (
            <div class="grid">
              {articles.map((article: any) => (
                <article class="card">
                  {coverSrc(article.cover) && (
                    <div class="card-media">
                      <img src={coverSrc(article.cover)} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="card-body">
                    <h3 class="card-title">
                      <a href={`${lp}/knowledge/${article.slug}`}>{pickB(locale, article.name)}</a>
                    </h3>
                    {pickB(locale, article.excerpt) && (
                      <p class="card-excerpt">{pickB(locale, article.excerpt)}</p>
                    )}
                    <div class="card-meta">
                      <span class="tag">{categoryLabel(article.category)}</span>
                      {(article.tags ?? []).slice(0, 2).map((tg: string) => (
                        <span class="tag tag-plain">{tagLabel(tg)}</span>
                      ))}
                      <span class="read-time">· {readingMinutes(pickB(locale, article.body))}{t(' 分钟阅读', ' min read')}</span>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )
          }
        </section>

        {/* 方案对比矩阵：把 recommendedProducts 渲染为 产品×参数 对比表 */}
        {
          matrix && (
            <section class="matrix" data-section="matrix" aria-label={t('方案对比', 'Solution comparison')}>
              <h2>{detail.scenarioProductsTitle}</h2>
              <div class="matrix-scroll">
                <table class="cmp">
                  <thead>
                    <tr>
                      <th>{t('参数', 'Parameter')}</th>
                      {matrix.products.map((p: any) => <th>{p.name}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {matrix.keys.map((k) => (
                      <tr>
                        <th>{k}</th>
                        {matrix.products.map((p: any) => {
                          const r = p.rows.find((x: any) => x.key === k);
                          return <td>{r ? r.val : '—'}</td>;
                        })}
                      </tr>
                    ))}
                  </tbody>
                  {
                    recProducts.some((p: any) => p.slug) && (
                      <tfoot>
                        <tr>
                          <th>{t('技术资料', 'Docs')}</th>
                          {matrix.products.map((p: any) => (
                            <td>
                              {p.slug ? (
                                <span class="doc-links">
                                  <a class="doc-link" href={`${UPLOADS_BASE}/tackix-tds-${p.slug}.pdf`} target="_blank" rel="noopener">{t('TDS', 'TDS')}</a>
                                  <a class="doc-link" href={`${UPLOADS_BASE}/tackix-sds-${p.slug}.pdf`} target="_blank" rel="noopener">{t('SDS', 'SDS')}</a>
                                </span>
                              ) : '—'}
                            </td>
                          ))}
                        </tr>
                      </tfoot>
                    )
                  }
                </table>
              </div>
              <p class="matrix-note">{t('参数为占位规格，正式资料以 TDS/SDS 为准。', 'Params are placeholders; refer to TDS/SDS for official specs.')}</p>
            </section>
          )
        }

        {/* 常见问题：场景级 FAQ（已含 FAQPage 结构化数据） */}
        {
          faqItems.length > 0 && (
            <section class="faq" data-section="faq" aria-label={detail.articleFaqTitle}>
              <h2>{detail.articleFaqTitle}</h2>
              {faqItems.map((f: any) => (
                <details class="faq-item">
                  <summary>{f.name}</summary>
                  <p>{f.acceptedAnswer.text}</p>
                </details>
              ))}
            </section>
          )
        }

        {/* 询盘 CTA：按钮文案来自场景「询盘按钮文案」字段，后台可编辑 */}
        {
          scenario.inquiryCta && pickB(locale, scenario.inquiryCta) && (
            <section class="inquiry" data-section="inquiry" aria-label={detail.scenarioInquiryTitle}>
              <h2>{detail.scenarioInquiryTitle}</h2>
              <a class="btn btn-primary" href={`${lp}/contact`}>{pickB(locale, scenario.inquiryCta)}</a>
            </section>
          )
        }

      </section>

      <div class="post-foot">
        <a class="btn" href={`${lp}/solutions`}>← {t('全部方案', 'All Solutions')}</a>
        <a class="btn btn-primary" href={`${lp}/contact`}>{t('联系我们', 'Contact us')}</a>
      </div>
      <CtxSuggest locale={locale} />
    </Base>
  )
}

<style>
  .cat-page { max-width: var(--maxw); margin: 0 auto; }
  .cat-head {
    margin: -44px calc(50% - 50vw) 36px;
    padding: 56px 24px 48px;
    text-align: center;
    background:
      radial-gradient(120% 150% at 50% -20%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 52%),
      linear-gradient(180deg, color-mix(in srgb, var(--accent) 10%, var(--surface)), var(--surface));
    border-bottom: 1px solid var(--border);
  }
  .head-inner { max-width: 760px; margin: 0 auto; }
  .crumbs {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: var(--faint);
    margin-bottom: 18px;
  }
  .crumbs a { color: var(--faint); }
  .crumbs a:hover { color: var(--accent); }
  .cat-head h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3rem);
    font-weight: 800;
    color: var(--fg);
    margin: 0 0 14px;
    letter-spacing: -0.02em;
    line-height: 1.18;
  }
  .lede {
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }
  .bottomline {
    margin: 18px auto 0;
    max-width: 620px;
    padding: 14px 18px;
    border-radius: var(--r-lg);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--fg);
    font-size: 15px;
    line-height: 1.7;
  }
  .bl-tag {
    display: inline-block;
    margin-right: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
  .empty { text-align: center; color: var(--muted); padding: 44px 0; }
  .post-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin: 44px auto 0;
    max-width: var(--readw);
  }
  @media (max-width: 700px) { .grid { grid-template-columns: minmax(0, 1fr); gap: 18px; } }

  /* 选型向导 */
  .wizard {
    margin: 8px auto 44px;
    max-width: var(--readw, 760px);
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface-2);
  }
  .wiz-head h2 { font-size: 20px; margin: 0 0 6px; color: var(--fg); }
  .wiz-sub { margin: 0 0 16px; color: var(--muted); font-size: 14px; }
  .wiz-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .wiz-chip {
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--fg-soft);
    border-radius: var(--r-pill);
    padding: 6px 14px;
    font-size: 13px;
    cursor: pointer;
    font-family: inherit;
  }
  .wiz-chip:hover { border-color: var(--accent); color: var(--accent); }
  .wiz-chip.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .wiz-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .wiz-item {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    transition: opacity var(--dur) var(--ease), border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .wiz-item h3 { margin: 0 0 4px; font-size: 15px; color: var(--fg); }
  .wiz-item p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .wiz-item.is-dim { opacity: 0.4; }
  .wiz-item.is-hit {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .wiz-bottom {
    margin: 18px 0 0;
    padding: 14px 16px;
    border-radius: var(--r-md);
    background: var(--accent-soft);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--fg);
    font-weight: 600;
  }
  /* 方案对比矩阵 */
  .matrix { margin: 8px auto 44px; max-width: var(--readw, 760px); }
  .matrix h2 { font-size: 20px; margin: 0 0 16px; color: var(--fg); }
  .matrix-scroll { overflow-x: auto; }
  table.cmp { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 480px; }
  table.cmp th, table.cmp td { border: 1px solid var(--border); padding: 10px 12px; text-align: left; vertical-align: top; }
  table.cmp thead th { background: var(--surface-2); color: var(--fg); }
  table.cmp tbody th { background: var(--surface-2); color: var(--fg-soft); font-weight: 600; white-space: nowrap; }
  table.cmp td { color: var(--muted); }
  /* 方案对比矩阵底部：每个推荐产品的 TDS / SDS 下载入口 */
  table.cmp tfoot th { background: var(--surface-2); color: var(--fg-soft); font-weight: 600; white-space: nowrap; }
  .doc-links { display: inline-flex; gap: 8px; flex-wrap: wrap; }
  .doc-link {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .doc-link:hover { background: var(--accent); color: var(--on-accent); text-decoration: none; }
  .matrix-note { margin: 10px 0 0; font-size: 12px; color: var(--faint); }

  /* 场景相关文章 */
  .scn-articles { margin: 8px auto 44px; max-width: var(--readw, 760px); }
  .scn-articles h2 { font-size: 20px; margin: 0 0 16px; color: var(--fg); }
  /* 询盘 CTA */
  .inquiry {
    margin: 8px auto 44px;
    max-width: var(--readw, 760px);
    padding: 28px 24px;
    text-align: center;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: var(--r-lg);
    background: var(--accent-soft);
  }
  .inquiry h2 { font-size: 20px; margin: 0 0 8px; color: var(--fg); }
  .inquiry .btn { display: inline-block; }

  /* 封面图 */
  .cover {
    display: block;
    width: 100%;
    height: clamp(240px, 30vw, 440px);
    object-fit: cover;
    border-radius: var(--r-lg);
    margin: 0 0 36px;
    box-shadow: var(--shadow-md);
  }
  /* 正文段落 */
  .scn-body { margin: 0 auto 8px; max-width: var(--readw, 760px); color: var(--muted); line-height: 1.8; }
  /* 常见问题 */
  .faq { margin: 8px auto 44px; max-width: var(--readw, 760px); }
  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 4px 18px;
    margin-bottom: 10px;
    background: var(--surface);
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--fg);
    padding: 12px 0;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; float: right; color: var(--accent); font-weight: 700; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { margin: 0 0 14px; color: var(--muted); }
  /* 自定义内容区块（标题 / 段落 / 图片 / 提示框 / 引用） */
  .custom-sections { margin: 8px auto 44px; max-width: var(--readw, 760px); display: grid; gap: 22px; }
  .csec-heading { font-size: 22px; line-height: 1.4; margin: 0; color: var(--fg); }
  .csec-text { margin: 0; color: var(--fg-soft); line-height: 1.8; }
  .csec-image { margin: 0; }
  .csec-image img { width: 100%; border-radius: var(--r-md); display: block; box-shadow: var(--shadow-sm); }
  .csec-image figcaption { margin-top: 8px; font-size: 13px; color: var(--faint); text-align: center; }
  .csec-callout {
    border: 1px solid var(--border-strong);
    border-left-width: 4px;
    border-radius: var(--r-md);
    padding: 14px 18px;
    background: var(--surface-2);
  }
  .csec-callout-title { display: block; margin-bottom: 4px; color: var(--fg); }
  .csec-callout p { margin: 0; color: var(--muted); line-height: 1.7; }
  .csec-callout.tone-info { border-left-color: var(--accent); }
  .csec-callout.tone-warn { border-left-color: var(--warn-accent, #e08a2b); }
  .csec-callout.tone-danger { border-left-color: var(--danger); }
  .csec-quote {
    margin: 0;
    padding: 10px 20px;
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 var(--r-sm) var(--r-sm) 0;
    color: var(--muted);
    font-style: italic;
  }
  .csec-quote cite { display: block; margin-top: 6px; font-size: 13px; color: var(--faint); font-style: normal; }

  @media (max-width: 700px) {
    .wizard { padding: 18px; }
  }
</style>

<script is:inline>
  (function () {
    var filters = document.getElementById('wiz-filters');
    if (!filters) return;
    var list = document.getElementById('wiz-list');
    if (!list) return;
    var items = Array.prototype.slice.call(list.querySelectorAll('.wiz-item'));
    function activate(btn) {
      Array.prototype.slice.call(filters.querySelectorAll('.wiz-chip')).forEach(function (c) {
        c.classList.remove('is-active');
      });
      btn.classList.add('is-active');
      var kws = (btn.getAttribute('data-kw') || '')
        .split('|')
        .map(function (k) { return k.toLowerCase(); })
        .filter(Boolean);
      items.forEach(function (it) {
        var txt = (it.getAttribute('data-text') || '').toLowerCase();
        var hit = kws.length === 0 || kws.some(function (k) { return txt.indexOf(k) >= 0; });
        it.classList.toggle('is-dim', !hit);
        it.classList.toggle('is-hit', kws.length > 0 && hit);
      });
    }
    Array.prototype.slice.call(filters.querySelectorAll('.wiz-chip')).forEach(function (c) {
      c.addEventListener('click', function () { activate(c); });
    });
  })();
</script>
