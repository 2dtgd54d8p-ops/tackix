---
/**
 * 全站 SEO / 社交分享 / AI 可发现性 元信息组件
 * ---------------------------------------------------------------
 * 统一输出：<title>、description、canonical、robots、keywords、
 * Open Graph、Twitter Card、article 时间、hreflang 备用语言。
 * 用法：在 Base.astro 的 <head> 中调用 <SEO ... />，页面级
 * 的 Article / FAQPage / Product 等 JSON-LD 仍通过 Base 的
 * <slot name="head"> 注入（见 posts/[slug].astro）。
 */
import { loadSiteData } from '../lib/site-data';
import { isPreLaunch } from '../lib/prelaunch';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
  noindex?: boolean;
  /** hreflang 备用语言链接，多语言（T10）启用后由页面传入 */
  alternates?: { lang: string; href: string }[];
  /** 页面语种（og:locale），多语言页面传入对应 BCP-47，如 'en_US' */
  locale?: string;
}

const {
  title,
  description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  keywords,
  noindex = false,
  alternates,
  locale,
} = Astro.props;

const { site } = await loadSiteData();
const siteTitle = site.title;
const siteDesc = site.description;
const desc = description ?? siteDesc;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;

const base = Astro.site ?? new URL('https://tackix.pages.dev');
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = image ? new URL(image, base).href : new URL('/og-default.svg', base).href;
const kw = Array.isArray(keywords) && keywords.length ? keywords.filter(Boolean).join(', ') : '';

// ── 预上线闸门（prelaunch）────────────────────────────────────────
// 未正式上线时全站输出 noindex, nofollow，避免演示内容被搜索引擎收录，
// 将来正式上线只需把 PRELAUNCH 置为 '0'（或删掉该 env），无需改任何页面代码。
// 详见 src/lib/prelaunch.ts
const prelaunch = isPreLaunch();
const robots = prelaunch
  ? 'noindex, nofollow, noarchive'
  : noindex
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large';
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
{/* canonical 仅在允许索引时输出：noindex 页面输出 canonical 反而会向搜索引擎
    暗示「这页是该 URL 的权威版本」，与 noindex 冲突 */}
{!prelaunch && !noindex && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />
{prelaunch && <meta name="googlebot" content="noindex, nofollow, noarchive" />}
{kw && <meta name="keywords" content={kw} />}
{
  !prelaunch &&
    alternates?.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={new URL(a.href, base).href} />
    ))
}
<meta property="og:type" content={type} />
{locale && <meta property="og:locale" content={locale} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={desc} />
<meta name="twitter:image" content={ogImage} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
